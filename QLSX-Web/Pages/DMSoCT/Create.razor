@using QLSX.Web.Helpers

@inject ILogger<Create> Logger
@inject IJSRuntime jsRuntime
@inject IDMSoCTService<QLSX.Shared.Models.DanhMucSoChungTuModel> itemService
@inherits QLSX.Web.Helpers.BlazorComponent
@inject AppService AppService
@inject ISnackbar Snackbar

@namespace QLSX.Web.Pages.DMSoCTPage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Tạo mới
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="formData" @bind-IsValid="@success" @bind-Errors="@errors">
            <EditForm Model="server">
                <DataAnnotationsValidator />
                <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
                    <ValidationSummary></ValidationSummary>
                    <MudGrid Spacing="0">
                        <MudItem xs="12" sm="12">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.LoaiCT" Label="Loại CT" Variant="Variant.Outlined" Required="true" RequiredError="Trường này bắt buộc nhập!" />
                            <ValidationMessage For="(() => server.LoaiCT)" />
                        </MudItem>
                        <MudItem xs="12" sm="12">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.KyHieu" Label="Ký hiệu" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="12">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.DoDai" Label="Độ dài" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="12">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.GhiChu" Label="Ghi chú" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </EditForm>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error">Bỏ qua</MudButton>
        <MudButton Class="me-3" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SaveClick())">Lưu</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public QLSX.Shared.Models.DanhMucSoChungTuModel server { get; set; } = new QLSX.Shared.Models.DanhMucSoChungTuModel();

    MudForm formData;
    bool success;
    string[] errors = { };

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveClick()
    {
        await formData.Validate();
        if (errors.Count() == 0)
        {
            var itemByCode = await itemService.GetByCodeAsync(server.LoaiCT);
            if (itemByCode.Id > 0)
            {
                Snackbar.Add("Loại CT đã tồn tại, chọn loại khác.", Severity.Error);
            }
            else
            {
                var itemCreate = await itemService.CreateAsync(server);
                MudDialog.Close(DialogResult.Ok(itemCreate.Id > 0));
            }
        }
    }

}
