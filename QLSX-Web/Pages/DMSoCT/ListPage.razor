                  @bind-SelectedItem="selectedItem1"
                  SortLabel="Sort By" CommitEditTooltip="Commit Edit"
                  RowEditPreview="BackupItem"
                  RowEditCancel="ResetItemToOriginalValues"
                  RowEditCommit="ItemHasBeenCommitted"
                  IsEditRowSwitchingBlocked="false" CanCancelEdit="true"
                  Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isLoading">
            <ToolBarContent>
                <MudSpacer />
                <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <ColGroup>
                <col />
                <col />
            </ColGroup>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="TenGia" T="QLSX.Shared.Models.DanhMucSoChungTuModel">Loại CT</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="CongThuc" T="QLSX.Shared.Models.DanhMucSoChungTuModel">Ký hiệu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GhiChu" T="QLSX.Shared.Models.DanhMucSoChungTuModel">Độ dài</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="GhiChu" T="QLSX.Shared.Models.DanhMucSoChungTuModel">Ghi chú</MudTableSortLabel></MudTh>
                <MudTh>#</MudTh>
            </HeaderContent>
            <RowTemplate Context="ctx1">
                <MudTd DataLabel="LoaiCT">@ctx1.LoaiCT</MudTd>
                <MudTd DataLabel="KyHieu">@ctx1.KyHieu</MudTd>
                <MudTd DataLabel="DoDai">@ctx1.DoDai</MudTd>
                <MudTd DataLabel="GhiChu">@ctx1.GhiChu</MudTd>
                <MudTd>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" aria-label="Xóa" @onclick="@(()=> DeleteClick(@ctx1))"></MudIconButton>
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Sửa" @onclick="@(()=> EditClick(@ctx1))">EditClick</MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có bản ghi nào tìm thấy</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Số dòng mỗi trang" />
            </PagerContent>
        </MudTable>
    </Authorized>
    <NotAuthorized>
        <NotPermission></NotPermission>
    </NotAuthorized>
</AuthorizeView>
