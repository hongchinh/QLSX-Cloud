    public void Dispose() { }

    private bool FilterFunc(QLSX.Shared.Models.DanhMucSoChungTuModel element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.LoaiCT.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.GhiChu.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.KyHieu.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<QLSX.Shared.Models.DanhMucSoChungTuModel>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        itemRequest.Keywords = searchString;

        lsResponses = new GetAllResponsePaged<QLSX.Shared.Models.DanhMucSoChungTuModel>();
        lsResponses = await listService.GetAllPagedAsync(itemRequest);

        IEnumerable<QLSX.Shared.Models.DanhMucSoChungTuModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<DanhMucSoChungTuModel>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<QLSX.Shared.Models.DanhMucSoChungTuModel>() { TotalItems = totalItems, Items = pagedData };
    }

    private async Task EditClick(QLSX.Shared.Models.DanhMucSoChungTuModel item)
    {
        var parameters = new DialogParameters
            {
                ["server"] = item
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Edit>("Sửa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Xóa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi xóa", "Thông báo");
            }
        }
    }

