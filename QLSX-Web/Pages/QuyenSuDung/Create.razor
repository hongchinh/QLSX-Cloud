@inject ILogger<Edit> Logger
 
@using Blazored.LocalStorage
@using QLSX.Shared.Models

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IUserService userReService

@inject IJSRuntime JSRuntime
@inject IEmloyeeService<UserModel> usersServices
@*@inject IPermissionsService<PermissionRequest> permissionService*@

@inject IPermissionRegionsService<PermissionRegion> permissionRegionsService
@inject IPermissionDepartmentsService<PermissionDepartment> permissionDepartmentsService
 

@inherits QLSX.Web.Helpers.BlazorComponent
 
@inject ILocalStorageService localStorageService

@namespace QLSX.Web.Pages.DMDonViSuDungUser

<div class="modal @_modalClass" tabindex="-1" role="dialog" style="display:@_modalDisplay">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <EditForm Model="_item" OnValidSubmit="@CreateClick">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Thêm User</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    @if (_item == null)
                    {
    <SpinnerData></SpinnerData> }
else
{
<div class="">
    <div class="row">

        <div class="col-12">
            <div class="form-group">
                <label class="control-label col-12">@lbltext</label>
                <div class="col-md-12">
                    <div class="col-md-4">
                        <InputSelect @bind-Value="_item.Id" class="form-control">
                            <option value="">Khu vực</option>
                            @if (lstPers != null)
                                {
        @foreach (var item in lstPers)
            {
<option value="@item.Id">@item.PerName  </option>}}

                        </InputSelect>
                        <ValidationMessage For="(() => _item.Id)" />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-12">Người sử dụng</label>
                <div class="col-12">
                    <InputSelect @bind-Value="_item.UserId" class="form-control">
                        <option value="">Chọn User</option>
                        @if (lstUsers != null)
                            {
                            @foreach (var item in lstUsers)
                                {
                                @if (_item.UserId == item.Id)
                                    {
                                <option value="@item.Id" selected>@item.FirstName</option> }
                                else
                                {
                                <option value="@item.Id">@item.FirstName </option>}}}
                    </InputSelect>
                    <ValidationMessage For="(() => _item.UserId )" />
                </div>
            </div>


        </div>
    </div>
</div>}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="Close">Bỏ qua</button>

                    <button type="submit" class="btn btn-primary">
                        Lưu
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>



@if (_showCreateModal)
{
<div class="modal-backdrop fade show"></div>}

@code { [Parameter]
    public EventCallback<string> OnSaveClick { get; set; }

    [Parameter]
    public IEnumerable<PermissionRequest> lstPers { get; set; } = new List<PermissionRequest>();
    [Parameter]
    public IEnumerable<UserModel> lstUsers { get; set; } = new List<UserModel>();
    [Parameter]
    public String pbtype { get; set; } = "";

    private string _badFileMessage = string.Empty;
    private string _modalDisplay = "none;";
    private string _modalClass = "";
    private bool _showCreateModal = false;
    private PermissionRequest _item = new PermissionRequest();
    private int _id = 0;

    public int SelectedProductId = 0;

    private string lbltext = "";

    private async Task CreateClick()
    {
        if (pbtype == "D")
        {
            var item = new PermissionDepartment();
            item.DepartmentId = _item.Id;
            item.UserId = _item.UserId;
            await permissionDepartmentsService.CreateAsync(item);
            await OnSaveClick.InvokeAsync(null);
            await Close();
        }
        if (pbtype == "R")
        {
            var item = new PermissionRegion();
            item.RegionId = _item.Id;
            item.UserId = _item.UserId;
            await permissionRegionsService.CreateAsync(item);
            await OnSaveClick.InvokeAsync(null);
            await Close();
        }


    }

    public async Task Open()
    {
        Logger.LogInformation("Now loading... /Users/Create");

        await new Css(JSRuntime).HideBodyOverflow();
        _item = new PermissionRequest();

        _modalDisplay = "block;";
        _modalClass = "Show";
        _showCreateModal = true;

        if (pbtype == "D")
        {
            lbltext = "Phòng ban";
        }
        if (pbtype == "R")
        {
            lbltext = "Khu vực";
             
        }

        StateHasChanged();
    }

    private async Task Close()
    {
        await new Css(JSRuntime).ShowBodyOverflow();

        _modalDisplay = "none";
        _modalClass = "";
        _showCreateModal = false;
    } }
