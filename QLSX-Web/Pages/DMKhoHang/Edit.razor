@inject ILogger<Edit> Logger
@inject IJSRuntime JSRuntime
@inject IDMKhoHangService<DanhMucKhoHangModel> itemService
@inherits QLSX.Web.Helpers.BlazorComponent
@namespace QLSX.Web.Pages.DMKhoHangPage
@inject ISnackbar Snackbar


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Cập nhật
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="formData" @bind-IsValid="@success" @bind-Errors="@errors">
            <EditForm Model="server">
                <DataAnnotationsValidator />
                <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
                    <ValidationSummary></ValidationSummary>
                    <MudGrid Spacing="0">
                        <MudItem xs="4" sm="2" Style="margin-top:20px; padding-top:10px">
                            <MudText> Mã kho </MudText>
                        </MudItem>
                        <MudItem xs="4" sm="5" Style="margin-top:20px">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.MaKho" Label="Mã kho" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="4" sm="5"></MudItem>
                        <MudItem xs="6" sm="2" Style="margin-top:20px; padding-top:10px">
                            <MudText> Tên kho </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="10" Style="margin-top:20px">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.TenKho" Label="Tên kho" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6" sm="2" Style="margin-top:20px; padding-top:10px">
                            <MudText> Địa chỉ </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="10" Style="margin-top:20px">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.DiaChi" Label="Địa chỉ" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </EditForm>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error">Bỏ qua</MudButton>
        <MudButton Class="me-3" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SaveClick())">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public DanhMucKhoHangModel server { get; set; } = new DanhMucKhoHangModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    MudForm formData;
    bool success;
    string[] errors = { };

    private async Task SaveClick()
    {
        await formData.Validate();
        if (errors.Count() == 0)
        {
            var itemByCode = await itemService.GetByCodeAsync(server.MaKho);
            if (itemByCode.Id > 0 && itemByCode.Id != server.Id)
            {
                Snackbar.Add("Mã kho đã tồn tại, chọn loại khác.", Severity.Error);
            }
            else
            {
                var itemEdit = await itemService.UpdateAsync(server.Id, server);
                MudDialog.Close(DialogResult.Ok(itemEdit.Id > 0));
            }
        }
    }

}

