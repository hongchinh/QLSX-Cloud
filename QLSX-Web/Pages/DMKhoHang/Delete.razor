@inject ILogger<Delete> Logger
@inject IJSRuntime JSRuntime
@inject IDMKhoHangService<DanhMucKhoHangModel> itemService
@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.DMKhoHangPage
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1" />
            Xóa
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="0">
            <MudItem xs="4" sm="2">
                <MudText> Mã kho </MudText>
            </MudItem>
            <MudItem xs="4" sm="2">
                <MudTextField Margin="Margin.Dense" @bind-Value="@server.MaKho" Label="Mã kho" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="4" sm="8"></MudItem>
            <MudItem xs="6" sm="2">
                <MudText> Tên kho </MudText>
            </MudItem>
            <MudItem xs="6" sm="10">
                <MudTextField Margin="Margin.Dense" @bind-Value="@server.TenKho" Label="Tên kho" Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="6" sm="2">
                <MudText> Địa chỉ </MudText>
            </MudItem>
            <MudItem xs="6" sm="10">
                <MudTextField Margin="Margin.Dense" @bind-Value="@server.DiaChi" Label="Địa chỉ" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error" >Bỏ qua</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => DeleteClick(server.Id))" Class="me-3">Xóa</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public DanhMucKhoHangModel server { get; set; } = new DanhMucKhoHangModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async Task DeleteClick(int id)
    {
        var isdelete = await itemService.DeleteAsync(id);
        MudDialog.Close(DialogResult.Ok(isdelete));
    }
 }