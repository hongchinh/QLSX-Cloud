@inject ILogger<Edit> Logger
@inject IJSRuntime JSRuntime
@inject IDMKhoanThuService<DanhMucKhoanThuModel> itemService
@inherits QLSX.Web.Helpers.BlazorComponent
@namespace QLSX.Web.Pages.DanhMucKhoanThuModelPage
@inject IPhanQuyenSuDungService< QLSX.Shared.Models.QuyenSuDungModel> permisstionService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Tạo mới
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="formData" @bind-IsValid="@success" @bind-Errors="@errors">
            <EditForm Model="server">
                <DataAnnotationsValidator />
                <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
                    <ValidationSummary></ValidationSummary>
                    <MudGrid Spacing="0">
                        <MudItem xs="4" sm="2" Style="padding-top:10px">
                            <MudText> Mã khoản thu </MudText>
                        </MudItem>
                        <MudItem xs="4" sm="6">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.MaKhoanThu" Label="Mã khoản thu" Variant="Variant.Outlined" Required="true" RequiredError="Trường này bắt buộc nhập!" />
                        </MudItem>
                        <MudItem xs="4" sm="4">
                        </MudItem>
                        <MudItem xs="6" sm="2" Style="padding-top:10px">
                            <MudText> Tên khoản thu </MudText>
                        </MudItem>

                        <MudItem xs="6" sm="10">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.TenKhoanThu" Label="Tên khoản thu" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="6" sm="2" Style="padding-top:10px">
                            <MudText> Ghi chú </MudText>
                        </MudItem>
                        <MudItem xs="6" sm="10">
                            <MudTextField Margin="Margin.Dense" @bind-Value="@server.GhiChu" Label="Ghi chú" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </EditForm>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error">Bỏ qua</MudButton>
        <MudButton Class="me-3" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SaveClick())">Lưu</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public DanhMucKhoanThuModel server { get; set; } = new DanhMucKhoanThuModel();

    MudForm formData;
    bool success;
    string[] errors = { };

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveClick()
    {
        await formData.Validate();
        if (errors.Count() == 0)
        {
            var itemByCode = await itemService.GetByCodeAsync(server.MaKhoanThu);
            if (itemByCode.Id > 0 && itemByCode.Id != server.Id)
            {
                Snackbar.Add("Mã khoản thu đã tồn tại, chọn loại khác.", Severity.Error);
            }
            else
            {
                var itemEdit = await itemService.UpdateAsync(server.Id, server);
                MudDialog.Close(DialogResult.Ok(itemEdit.Id > 0));
            }
        }
    }
}

