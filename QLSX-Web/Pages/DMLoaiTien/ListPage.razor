@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    public GetAllResponsePaged<DanhMucLoaiTienModel> lsResponses { get; set; }
    public QLSX.Shared.Models.BaseSearchRequest itemRequest { get; set; }
    bool isLoading = true;

    private IEnumerable<DanhMucLoaiTienModel> pagedData;
    private MudTable<DanhMucLoaiTienModel> table;
    private int totalItems;

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Danh sách loại tiền",href: null, disabled: true)
    };

    protected override void OnInitialized()
    {
        Console.WriteLine("Customer - OnInitialized");
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("Customer - OnInitializedAsync");

        itemRequest = new QLSX.Shared.Models.BaseSearchRequest()
            {
                PageSize = 10,
                Page = 0,
                TotalPages = 0
            };
        lsResponses = new GetAllResponsePaged<DanhMucLoaiTienModel>();

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        if (firstRender)
        {
            isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
    }

    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<DanhMucLoaiTienModel>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<DanhMucLoaiTienModel>();
        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "DMLoaiTien");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await listService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<DanhMucLoaiTienModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<DanhMucLoaiTienModel>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<DanhMucLoaiTienModel>() { TotalItems = totalItems, Items = pagedData };
    }

    private async Task EditClick(DanhMucLoaiTienModel item)
    {
        var parameters = new DialogParameters
            {
                ["server"] = item
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Edit>("Sửa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Xóa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi xóa", "Thông báo");
            }
        }
    }

    private async Task ReloadCatalogItems()
    {
        await table.ReloadServerData();
    }

    private async Task DeleteClick(DanhMucLoaiTienModel item)
    {
        var parameters = new DialogParameters { ["server"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Delete>("Xóa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
