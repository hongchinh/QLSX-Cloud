  <MudToolBar Style="height:40px !important">
	<MudIconButton Disabled="IsFirst" Icon="@Icons.Material.Filled.FirstPage" @onclick="@(e => NavigateTo("first"))" Color="Color.Primary" Title="Đầu" />
	<MudIconButton Icon="@Icons.Material.Filled.NavigateBefore"   @onclick="@(e => NavigateTo("prev"))" Color="Color.Primary" Title="Trước" />
	<InputNumber @oninput="@((input) => ChangeValueRow(input))" @bind-Value="@CurrentIndex" style="width: 50px; font-weight:bold" />
	<div style="font-weight:bold">/@TotalIndex  </div>
	<MudIconButton Icon="@Icons.Material.Filled.NavigateNext" @onclick="@(e => NavigateTo("next"))" Color="Color.Primary" Title="Tiếp" />
	<MudIconButton Disabled="IsLast" Icon="@Icons.Material.Filled.LastPage" @onclick="@(e => NavigateTo("last"))" Color="Color.Primary" Title="Cuối" />
</MudToolBar>


@code {
	[Parameter]
	public EventCallback<string> MoveIndex { get; set; }
	[Parameter]
	public int CurrentIndex { get; set; }
	[Parameter]
	public int TotalIndex { get; set; } = 0;

	[Parameter]
	public bool IsFirst { get; set; } = true ;
	[Parameter]
	public bool IsLast { get; set; } =  true ;

	async Task UpdateList(int index = 0)
	{
		if (TotalIndex != 0)
		{
			await MoveIndex.InvokeAsync(index.ToString());
		}
	}
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			StateHasChanged();
		}
		await base.OnAfterRenderAsync(firstRender);
	}
	protected override void OnInitialized()
    {
        base.OnInitialized();
    }

	protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }
	async Task NavigateTo(string direction)
	{
		int tmp = 1;
		int countAll = TotalIndex;

		switch (direction)
		{
			case "prev":
				tmp = CurrentIndex - 1;
				CurrentIndex = Math.Max(1, tmp);
				break;
			case "next":
				tmp = CurrentIndex + 1;
				CurrentIndex = Math.Min(countAll, tmp);
				break;
			case "first":
				CurrentIndex = 1;
				break;
			case "last":
				CurrentIndex = countAll;
				break;
			default:
				CurrentIndex = countAll;
				break;
		}
		StateHasChanged();
		await UpdateList(CurrentIndex);
	}
	private async Task ChangeValueRow(ChangeEventArgs input)
	{
		int value = 1;
		int.TryParse(input.Value.ToString(), out value);
		CurrentIndex = value >= TotalIndex ? TotalIndex : value;
		await UpdateList(CurrentIndex);
	}
}
