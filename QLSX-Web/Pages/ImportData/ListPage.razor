@namespace QLSX.Web.Pages.ImportData

<div class="col-12">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <MudToolBar>
        <MudButton Variant="Variant.Filled" @onclick="@(() => CreateTemplateClick())" StartIcon="@Icons.Material.Filled.Create" Color="Color.Primary">Lấy mẫu excel</MudButton>
    </MudToolBar>

    <div class="row">
        <div class="col-12 pr-45">
            <div class="area-search py-3 px-3">
                <form @onsubmit="OnSubmit">
                    <InputFile OnChange="OnInputFileChange" multiple />
                    <div> @Message </div>
                    <br /><br />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Primary">Import data</MudButton>
                </form>
            </div>
        </div>
    </div>


    <div class="form-group">
        <MudSimpleTable Style="overflow-x: auto;">
            <thead>
                <tr>
                    @foreach (var h in lstColumns)
                    {
                        <th>@h.COLUMN_NAME</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in lstData.Rows)
                {
                    <tr>
                        @foreach (DataColumn cl in lstData.Columns)
                        {
                            <td>@row[cl]</td>
                        }
                    </tr>
                }

            </tbody>
        </MudSimpleTable>

    </div>

</div>
