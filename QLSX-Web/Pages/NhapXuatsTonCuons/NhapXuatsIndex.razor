@namespace QLSX.Web.Pages.NhapXuatTonCuonPage
<div class="form-group">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <EditForm Model="@itemRequest" OnValidSubmit="@SearchClick">
        <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.SoPhieu" Label="Số phiếu" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="string" Margin="Margin.Dense" Label="Loại" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.Loai" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("")"> </MudSelectItem>
                        <MudSelectItem T="string" Value="@("nhap")">Phiếu nhập </MudSelectItem>
                        <MudSelectItem T="string" Value="@("xuat")">Phiếu xuất</MudSelectItem>
                        <MudSelectItem T="string" Value="@("nhaptra")">Phiếu nhập trả</MudSelectItem>
                        <MudSelectItem T="string" Value="@("xuattra")">Phiếu xuất trả</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" Label="Số tiền từ" @bind-Value="itemRequest.SoTien_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" Label="Số tiền đến" @bind-Value="itemRequest.SoTien_To" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" Label="Số tiền TT từ" @bind-Value="itemRequest.SoTienTT_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Margin="Margin.Dense" Variant="Variant.Outlined" Label="Số tiền TT đến" @bind-Value="itemRequest.SoTienTT_To" Editable="true"></MudNumericField>
                </MudItem>

                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="string" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaKhoHang" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                        @if (lstKhoHang != null)
                        {
                            @foreach (var cnt in lstKhoHang)
                            {
                                <MudSelectItem Value="@cnt.MaKho"> @cnt.TenKho </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="int" Margin="Margin.Dense" Label="Loại tiền" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.DMLoaiTienId" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">Tất cả</MudSelectItem>
                        @if (lstLoaiTien != null)
                        {
                            @foreach (var cnt in lstLoaiTien)
                            {
                                <MudSelectItem Value="@cnt.Id">@cnt.LoaiTien</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" Label="Từ ngày" @bind-Date="@itemRequest.NgayLap_From" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" Label="Đến ngày" @bind-Date="@itemRequest.NgayLap_To" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudButton Class="mt-3" ButtonType="ButtonType.Submit" Size="Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary">Tìm kiếm</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>

    <MudToolBar>
        <MudMenu Label="Tạo phiếu" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
            <MudMenuItem OnClick="CreateClickNhap" Disabled="@(!quyenSuDungNhap.Them)">Phiếu nhập</MudMenuItem>
            <MudMenuItem OnClick="CreateClickXuat" Disabled="@(!quyenSuDungXuat.Them)">Phiếu xuất</MudMenuItem>
            <MudMenuItem OnClick="CreateClickNhapTra">Phiếu nhập trả</MudMenuItem>
            <MudMenuItem OnClick="CreateClickXuatTra">Phiếu xuất trả</MudMenuItem>
        </MudMenu>
        <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="Color.Secondary">Excel</MudButton>
    </MudToolBar>
    <div class="form-group">
        <MudTable ServerData="@(new Func<TableState, Task<TableData<NhapXuatTonCuonModel>>>(ServerReload))" Breakpoint="Breakpoint.Sm"
                  Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isLoading"
                  @ref="table" HorizontalScrollbar="true">
            <ColGroup>
                <col style="width: 150px;" />
                <col style="width: 150px;" />
                <col />
                <col />
                <col style="width: 25%;" />
                <col style="width: 15%;" />
                <col />
                <col />
                <col />
                <col />
                <col style="width: 10%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="Loai" T="NhapXuatModel">Loại</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="NgayCT" T="NhapXuatModel">Ngày lập</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoCT" T="NhapXuatModel">Số phiếu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="MaDonVi" T="NhapXuatModel">Mã đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenDonVi" T="NhapXuatModel">Tên đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="DiaChi" T="NhapXuatModel">Địa chỉ</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienTT" T="NhapXuatModel">Tổng tiền hàng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="KyHieu" T="NhapXuatModel">Loại tiền</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienTT" T="NhapXuatModel">Số tiền TT</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenKho" T="NhapXuatModel">Kho hàng</MudTableSortLabel></MudTh>
                <MudTh>#</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Loai">@context.LoaiDisplay</MudTd>
                <MudTd DataLabel="NgayCt">@(string.Format("{0:dd/MM/yyyy}", context.NgayCT))</MudTd>
                <MudTd DataLabel="Name"> <a href="/nhapxuattoncuons/@context.Loai/edit/@context.Id">@context.SoChungTu </a></MudTd>
                <MudTd DataLabel="MaDonVi">@context.MaDonVi</MudTd>
                <MudTd DataLabel="TenDonVi">@context.TenDonVi</MudTd>
                <MudTd DataLabel="DiaChi">@context.DiaChi</MudTd>
                <MudTd DataLabel="TongSoTien">@context.NoiDungNhapXuatTonCuons.Sum(s => s.SoTien).ToString("###,###")</MudTd>
                <MudTd DataLabel="KyHieu">@context.DMLoaiTiens?.LoaiTien</MudTd>
                <MudTd DataLabel="SoTienTT">@(string.Format("{0:###,###}", context.SoTienTT)) </MudTd>
                <MudTd DataLabel="TenKho">@context.DMKhoHang?.TenKho</MudTd>
                <MudTd>
                    <MudIconButton Style="min-width:30px;width:30px"
                                   Target="_blank"
                                   Variant="Variant.Text"
                                   Color="Color.Success"
                                   aria-label="In"
                                   OnClick="@(async ()=> await PrintClick(@context.Id, context.Loai))"
                                   Icon="@Icons.Material.Filled.Print" Size="Size.Small">
                    </MudIconButton>
                    <MudIconButton OnClick="@(async ()=> await DeleteClick(@context))"
                                   Style="min-width:30px;width:30px;text-transform:none"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   aria-label="In"
                                   Icon="@Icons.Material.Filled.Delete" Size="Size.Small">
                    </MudIconButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có bản ghi nào tìm thấy</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Số dòng mỗi trang" />
            </PagerContent>
        </MudTable>
    </div>

</div>
<LoadingProgress IsLoading="isLoading" />
