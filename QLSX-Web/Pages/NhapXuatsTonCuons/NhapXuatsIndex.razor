    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        lsResponses = new GetAllResponsePaged<NhapXuatTonCuonModel>();
        nhapxuat = new NhapXuatTonCuonModel();
        nhapxuatList = filterednhapxuatList = new List<NhapXuatTonCuonModel>();
        itemRequest = new NhapXuatTonCuonSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 20,
                Page = 0,
                TotalPages = 0

            };


        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            lstKhoHang = await dmkhohangService.GetAllAsync();
            lstLoaiTien = await dmLoaiTienService.GetAllAsync();
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");
            var user = (await authenticationStateTask).User;
            var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
            UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
            itemSetting = await itemService.GetByIdAsync(int.Parse(UserId));

            isLoading = false;
            StateHasChanged();
        }
        //await JSRuntime.InvokeAsync<object>("TestDataTablesAdd", "#GridTable");
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<NhapXuatTonCuonModel>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new();

        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "tracuunhapxuat");
        quyenSuDungNhap = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhap");
        quyenSuDungXuat = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuat");
        quyenSuDungNhapTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhaptra");
        quyenSuDungXuatTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuattra");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await nhapxuatService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<NhapXuatTonCuonModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<NhapXuatTonCuonModel>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<NhapXuatTonCuonModel>() { TotalItems = totalItems, Items = pagedData };
    }


