@using Dialogs
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Mvc;
@using QLSX.Shared.Models
@using AutoMapper
@using Microsoft.Extensions.Configuration;
@using System.Globalization
@using Blazored.LocalStorage

@inject IDMHangHoaTonCuonService<DanhMucHangHoaTonCuonModel> dmhanghoaService
@inject IDMKhachHangService<DanhMucKhachHangModel> dmkhachhangService
@inject INhapXuatsService<NhapXuatModel> nhapxuatService
@inject AppService AppService
@inject IReportService reportService
@inject IJSRuntime JSRuntime
@inject NavigationManager navigationManager
@inject IToastService toastService
@inject IDialogService DialogService
@inject IMapper mapper;
@inject IConfiguration configuration
@inject ILocalStorageService localStorageService
@inject ISnackbar Snackbar

@namespace QLSX.Web.Pages.NhapXuatTonCuonPage

<EditForm Model="nhapxuat">
    <ObjectGraphDataAnnotationsValidator />
    <div class="card">
        <div class="card-body pa-0">
            <div class="container-lg">
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pd-nx">
                    <MudTabPanel Text="Thông tin đơn hàng">
                        <div id="home">
                            <div class="row mt-3">
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <ValidationMessage For="(() => nhapxuat.SoChungTu)" />
                                        <MudTextField Margin="Margin.Dense" Label="Số phiếu" @bind-Value="@nhapxuat.SoChungTu" style="width:100%" Variant="Variant.Outlined" />
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <ValidationMessage For="(() => nhapxuat.NgayCT)" />
                                        <div><MudDatePicker Margin="Margin.Dense" Label="Ngày lập" @bind-Date="nhapxuat.NgayCT" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined"></MudDatePicker></div>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <ValidationMessage For="(() => nhapxuat.NgayHT)" />
                                        <MudDatePicker Margin="Margin.Dense" Label="Ngày hoàn thành" @bind-Date="nhapxuat.NgayHT" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined"></MudDatePicker>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">

                                        <MudSelect T="string" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="@nhapxuat.MaKho" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("")">Chọn kho hàng</MudSelectItem>
                                            @if (lstKhoHang != null)
                                            {
                                                @foreach (var cnt in lstKhoHang)
                                                {
                                                    <MudSelectItem Value="@cnt.MaKho">@cnt.TenKho</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </div>
                                </div>
                                @*Kho hàng*@
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-3 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                    </div>
                                </div>
                                @*đơn vị*@
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <ValidationMessage For="(() => nhapxuat.MaDonVi)" />
                                        <MudTextField Margin="Margin.Dense" Label="Mã đơn vị" @bind-Value="@nhapxuat.MaDonVi"
                                                      TextChanged="@( (input) => MaDonViTextChanged(input))"
                                                      Adornment="Adornment.End"
                                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                                      OnAdornmentClick="@(() => OpenDialogKhachHang())"
                                                      Immediate="true"
                                                      Variant="Variant.Outlined" />
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-5 col-xl-5 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Tên đơn vị" @bind-Value="@nhapxuat.TenDonVi" Variant="Variant.Outlined" />
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-3 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Địa chỉ" @bind-Value="@nhapxuat.DiaChi" Variant="Variant.Outlined" />
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-2 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Điện thoại" @bind-Value="@nhapxuat.DienThoai" Variant="Variant.Outlined" />
                                </div>


                                @*ghi chú*@
                                <div class="col-xs-12 col-sm-6 col-md-6 col-xl-12 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Ghi chú" @bind-Value="@nhapxuat.DienGiai" Variant="Variant.Outlined" />
                                </div>
                            </div>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Thông tin giao hàng ">
                        <div id="menu1">
                            @*Ngày giao*@
                            <div class="row">
                                <div class="col-xs-12 col-sm-6 col-md-3 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <MudDatePicker Margin="Margin.Dense" Label="Ngày giao hàng" @bind-Date="nhapxuat.NgayGiao" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Variant="Variant.Outlined"></MudDatePicker>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Phương tiện" @bind-Value="@nhapxuat.PhuongTien" Variant="Variant.Outlined" />
                                </div>
                                <div class="col-xs-12 col-sm-12 col-md-6 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Nơi giao" @bind-Value="@nhapxuat.NoiGiao" Variant="Variant.Outlined" />
                                </div>
                            </div>
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="Thông tin thanh toán">
                        <div id="menu2">
                            @* Thanh toán*@
                            <div class="row">
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-3 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <MudSelect Margin="Margin.Dense" Label="Hình thức thanh toán" AnchorOrigin="Origin.BottomCenter" @bind-Value="@DMHinhThucTTId" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@(0)">Chọn hình thức thanh toán</MudSelectItem>
                                            @if (lstHinhThucTT != null)
                                            {
                                                @foreach (var cnt in lstHinhThucTT)
                                                {
                                                    <MudSelectItem Value="@cnt.Id">@cnt.TenHinhThuc</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <MudDatePicker Margin="Margin.Dense" Label="Ngày thanh toán" @bind-Date="nhapxuat.NgayHenThanhToan" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Variant="Variant.Outlined"></MudDatePicker>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <MudSelect Margin="Margin.Dense" Label="Loại tiền" AnchorOrigin="Origin.BottomCenter" @bind-Value="@nhapxuat.LoaiTien" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("0")">Chọn loại tiền</MudSelectItem>
                                        @if (lstLoaiTien != null)
                                        {
                                            @foreach (var cnt in lstLoaiTien)
                                            {
                                                <MudSelectItem Value="@cnt.Id.ToString()">@cnt.LoaiTien</MudSelectItem>
                                            }
                                        }
                                    </MudSelect>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <MudTextField Margin="Margin.Dense" Label="Số tiền" @bind-Value="@nhapxuat.SoTienTT" Variant="Variant.Outlined" />
                                </div>
                                <div class="col-xs-0 col-md-6 col-md-0 col-xl-3 m-0 p-0"></div>

                            </div>
                            @*Nhan viên*@
                            <div class="row">
                                <div class="col-xs-12 col-sm-6 col-md-3 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        @*  <MudSelect T="int" Margin="Margin.Dense" Label="Nhân viên kinh doanh" AnchorOrigin="Origin.BottomCenter" @bind-Value="@MaNhanVienId" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@(0)">Chọn nhân viên</MudSelectItem>
                                        @if (lstUser != null)
                                        {
                                        @foreach (var cnt in lstUser)
                                        {
                                        <MudSelectItem Value="@cnt.Id">@cnt.FirstName</MudSelectItem>
                                        }
                                        }
                                        </MudSelect> *@
                                    </div>
                                </div>
                                @*nv kỹ thuật*@
                                <div class="col-xs-12 col-sm-6 col-md-3 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        @* <MudSelect T="int" Margin="Margin.Dense" Label="Nhân viên kỹ thuật" AnchorOrigin="Origin.BottomCenter" @bind-Value="@NVKyThuatId" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@(0)">Chọn nhân viên</MudSelectItem>
                                        @if (lstUser != null)
                                        {
                                        @foreach (var cnt in lstUser)
                                        {
                                        <MudSelectItem Value="@cnt.Id">@cnt.FirstName</MudSelectItem>
                                        }
                                        }
                                        </MudSelect> *@
                                    </div>
                                </div>

                            </div>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </div>
    </div>
    <MudToolBar>
        @if (quyenSuDung.Them || quyenSuDung.Sua)
        {
            <MudButton Variant="Variant.Filled" OnClick="@(()=> SaveData())" StartIcon="@Icons.Material.Filled.Save" Size="Size.Small" Color="Color.Info">Cất</MudButton>
            @if (IsCreateOrEdit)
            {
                <MudCheckBox @bind-Checked="@saveAndCreate" Label="Lưu và tạo mới tiếp" Color="Color.Primary"></MudCheckBox>
            }
        }
        @if (!IsCreateOrEdit)
        {
            if (quyenSuDung.Them)
            {
                <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(() => CreateClick(nhapxuat.Loai))" StartIcon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" Color="Color.Primary">Thêm</MudButton>
            }

            if (nhapxuat.Loai == "nhapton")
            {
                @if (quyenSuDung.XemIn)
                {
                    <MudMenu StartIcon="@Icons.Material.Filled.Print" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="In" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                        <MudMenuItem OnClick="@( async () => await PrintPhieuNhapThuong(nhapxuat.Id))">In nhập thường</MudMenuItem>
                        <MudMenuItem OnClick="@( async () => await PrintPhieuNhapTon(nhapxuat.Id))">In nhập tôn</MudMenuItem>
                    </MudMenu>
                }

            }
            else if (nhapxuat.Loai == "xuatton")
            {
                @if (quyenSuDung.XemIn)
                {
                    <MudMenu StartIcon="@Icons.Material.Filled.Print" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Label="In" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                        <MudMenuItem OnClick="@( async () => await PrintPhieuXuatThuong(nhapxuat.Id))">In xuất thường</MudMenuItem>
                        <MudMenuItem OnClick="@( async () => await PrintPhieuXuatTon(nhapxuat.Id))">In xuất tôn</MudMenuItem>
                        <MudMenuItem OnClick="@( async () => await PrintLenhSanXuat(nhapxuat.Id))">In lệnh sản xuất</MudMenuItem>
                    </MudMenu>
                }

            }
            else if (nhapxuat.Loai == "nhaptontra")
            {
                @if (quyenSuDung.XemIn)
                {
                    <a class="ml-1" href="@hostReport/Reports/Viewer?ReportFileName=rptPhieuNhapTra&id=@nhapxuat.Id" target="_blank">
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Primary">In</MudButton>
                    </a>
                }

            }
            else if (nhapxuat.Loai == "xuattontra")
            {
                @if (quyenSuDung.XemIn)
                {
                    <a class="ml-1" href="@hostReport/Reports/Viewer?ReportFileName=rptPhieuXuatTra&id=@nhapxuat.Id" target="_blank">
                        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print" Size="Size.Small" Color="Color.Primary">In</MudButton>
                    </a>
                }

            }
            if (quyenSuDung.Xoa)
            {
                <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(() => DeleteClick())" StartIcon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error">Xóa</MudButton>
            }

            <a id="reportid" target="_blank" href="@UrlReport" style="display:none"></a>
            <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(() => OpenDialogTimNhanh())" StartIcon="@Icons.Material.Filled.Search" Size="Size.Small" Color="Color.Info">Tìm nhanh</MudButton>

        }
    </MudToolBar>

    <div class="form-group">

        <MudTable Items="@nhapxuat.NoiDungNhapXuatTonCuons" Hover="true" ReadOnly="false" CanCancelEdit="true"
                  @bind-SelectedItem="selectedItem1" SortLabel="Sort By" CommitEditTooltip="Commit Edit" @ref="table"
                  RowEditPreview="BackupItem" RowEditCancel="ResetItemToOriginalValues"
                  RowEditCommit="ItemHasBeenCommitted" IsEditRowSwitchingBlocked="true"
                  FixedHeader="true" FixedFooter="true"
                  RowClassFunc="@SelectedRowClassFunc"
                  Class="NhapXuatTableCustom">

            <ColGroup>
                <col width="150px" />
                <col width="250px" />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />

            </ColGroup>
            <HeaderContent>
                <MudTh>Mã hàng hóa</MudTh>
                <MudTh>Tên hàng hóa</MudTh>
                <MudTh>Đơn vị tính</MudTh>
                <MudTh>Số lượng</MudTh>
                <MudTh>Chiều dài</MudTh>
                <MudTh>Tổng chiều dài</MudTh>
                <MudTh>Khổ rộng tôn</MudTh>
                <MudTh>Tổng diện tích</MudTh>
                <MudTh>Đơn giá</MudTh>
                <MudTh>Số tiền</MudTh>
                <MudTh>Ghi chú</MudTh>

            </HeaderContent>
            <RowTemplate Context="ctx">
                <MudTd DataLabel="MaHangHoa"><div class="cell-data">@ctx.MaHangHoa</div></MudTd>
                <MudTd DataLabel="TenHangHoa"><div class="cell-data">@ctx.TenHangHoa</div></MudTd>
                <MudTd DataLabel="DonViTinh"><div class="cell-data">@ctx.DonViTinh</div></MudTd>
                <MudTd DataLabel="SoLuong"><div class="cell-data" Style="text-align:right">@ctx.SoLuong.ToString("###,###.##")</div></MudTd>
                <MudTd DataLabel="ChieuDai"><div class="cell-data" Style="text-align:right">@ctx.ChieuDai.ToString("###,###.##")</div></MudTd>
                <MudTd DataLabel="TongChieuDai"><div class="cell-data" Style="text-align:right">@ctx.TongChieuDai.ToString("###,###.##")</div></MudTd>
                <MudTd DataLabel="KhoRongTon"><div class="cell-data" Style="text-align:right">@ctx.KhoRongTon.ToString("###,###.##")</div></MudTd>
                <MudTd DataLabel="TongDienTich"><div class="cell-data" Style="text-align:right">@ctx.TongDienTich.ToString("###,###.##")</div></MudTd>
                <MudTd DataLabel="DonGia"><div class="cell-data" Style="text-align:right">@ctx.DonGia.ToString("###,###")</div></MudTd>
                <MudTd DataLabel="SoTien"><div class="cell-data" Style="text-align:right">@ctx.SoTien.ToString("###,###")</div></MudTd>
                <MudTd DataLabel="GhiChu"><div class="cell-data">@ctx.GhiChu</div></MudTd>
                <MudTd><MudIconButton Disabled="false" Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Variant="Variant.Text" Style="width:24px; height:24px" OnClick="@(() => DeleteRow(ctx))">> </MudIconButton></MudTd>
            </RowTemplate>
            <RowEditingTemplate Context="ctx1">
                <MudTd DataLabel="MaHangHoa">
                    <MudTextField @bind-Value="@ctx1.MaHangHoa" Immediate="true" TextChanged="MaHangHoaTextChanged"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="@(() => OpenDialogHangHoa())" />
                </MudTd>
                <MudTd DataLabel="TenHangHoa">
                    <MudTextField @bind-Value="@ctx1.TenHangHoa" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="DonViTinh">
                    <MudTextField @bind-Value="@ctx1.DonViTinh" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="SoLuong" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.SoLuong" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"SoLuong"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="ChieuDai" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.ChieuDai" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"ChieuDai"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="TongChieuDai" Style="text-align:right;">
                    <MudNumericField @bind-Value="@ctx1.TongChieuDai" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" Immediate="true" Align="right" HideSpinButtons="true" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="KhoRongTon" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.KhoRongTon" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"KhoRongTon"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="TongDienTich" Style="text-align:right;">
                    <MudNumericField @bind-Value="@ctx1.TongDienTich" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" Immediate="true" HideSpinButtons="true" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="DonGia" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.DonGia" InvertMouseWheel="true" Format="###,###" Culture="@_vi" HideSpinButtons="true" Immediate="true" TextChanged="@( (value) => ChangeValueRow(value,"DonGia"))" />
                </MudTd>
                <MudTd DataLabel="SoTien" Style="text-align:right;">
                    <MudNumericField @bind-Value="@ctx1.SoTien" InvertMouseWheel="true" Immediate="true" HideSpinButtons="true" Format="###,###" Culture="@_vi" T="double" />
                </MudTd>
                <MudTd DataLabel="GhiChu">
                    <MudTextField @bind-Value="@ctx1.GhiChu" Immediate="true" />
                </MudTd>
            </RowEditingTemplate>
            <FooterContent>
                <MudTd Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" colspan="3">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle" @onclick="@(e => AddRow())" Color="Color.Inherit" Title="Thêm dòng" />
                    Tổng cộng
                </MudTd>
                <MudTd Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" Style="text-align:right">@nhapxuat.NoiDungNhapXuatTonCuons?.Sum(x => x.SoLuong).ToString("###,###")</MudTd>
                <MudTd></MudTd>
                <MudTd Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" Style="text-align:right">@nhapxuat.NoiDungNhapXuatTonCuons?.Sum(x => x.TongChieuDai).ToString("###,###.##")</MudTd>
                <MudTd></MudTd>
                <MudTd Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" Style="text-align:right">@nhapxuat.NoiDungNhapXuatTonCuons?.Sum(x => x.TongDienTich).ToString("###,###.##")</MudTd>
                <MudTd></MudTd>
                <MudTd Class="mud-table-cell-custom-group mud-table-cell-custom-group-footer" Style="text-align:right">@nhapxuat.NoiDungNhapXuatTonCuons?.Sum(x => x.SoTien).ToString("###,###")</MudTd>
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </div>
</EditForm>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    [Parameter]
    public NhapXuatTonCuonModel nhapxuat { get; set; } = new();

    [Parameter]
    public List<DanhMucHinhThucTTModel> lstHinhThucTT { get; set; }
    [Parameter]
    public List<UserModel> lstUser { get; set; }

    [Parameter]
    public List<DMTinhTrangModel> lstTinhTrang { get; set; }
    [Parameter]
    public List<DanhMucKhoHangModel> lstKhoHang { get; set; }
    [Parameter]
    public List<DanhMucLoaiTienModel> lstLoaiTien { get; set; }

    [Parameter]
    public EventCallback<bool> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback ValueChangedText { get; set; }

    [Parameter]
    public bool isLoading { get; set; }

    [Parameter]
    public QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; }

    [Parameter]
    public bool IsCreateOrEdit { get; set; }

    public bool saveAndCreate { get; set; } = false;

    public CultureInfo _vi = CultureInfo.GetCultureInfo("vi-VN");

    public string hostReport { get; set; }

    private int _dMTinhTrangId;
    public int DMTinhTrangId
    {
        get
        {
            return _dMTinhTrangId;
        }
        set
        {
            this._dMTinhTrangId = value;
            nhapxuat.DMTinhTrangId = value;
        }
    }

    private int _dMHinhThucTTId;
    public int DMHinhThucTTId
    {
        get
        {
            return _dMHinhThucTTId;
        }
