    private void ResetItemToOriginalValues(object element)
    {
        selectedItem1.Id = elementBeforeEdit.Id;
        selectedItem1.CongThuc = elementBeforeEdit.CongThuc;
        selectedItem1.TenGia = elementBeforeEdit.TenGia;
        selectedItem1.GhiChu = elementBeforeEdit.GhiChu;
        StateHasChanged();
    }
    public void Dispose()    {    }

    private bool FilterFunc(QLSX.Shared.Models.DMTinhGia element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.CongThuc.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.GhiChu.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.TenGia.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    } 
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<QLSX.Shared.Models.DMTinhGia>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<QLSX.Shared.Models.DMTinhGia>();
        lsResponses = await listService.GetAllPagedAsync(itemRequest);

        IEnumerable<QLSX.Shared.Models.DMTinhGia> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<DMTinhGia>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<QLSX.Shared.Models.DMTinhGia>() { TotalItems = totalItems, Items = pagedData };
    }

    private async Task EditClick(QLSX.Shared.Models.DMTinhGia item)
    {
        var parameters = new DialogParameters
            {
                ["server"] = item
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Edit>("Sửa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Xóa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi xóa", "Thông báo");
            }
        }
    }

