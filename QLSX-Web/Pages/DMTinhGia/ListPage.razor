     private void BackupItem(object element)
    {
        elementBeforeEdit = new QLSX.Shared.Models.DMTinhGia()
            {
                Id = ((QLSX.Shared.Models.DMTinhGia)element).Id,
                TenGia = ((QLSX.Shared.Models.DMTinhGia)element).TenGia,
