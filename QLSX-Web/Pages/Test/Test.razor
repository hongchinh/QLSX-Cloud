    <IgbColumn Header="TongCong" Field="TongCong"
               DataType="GridColumnDataType.String"
               Name="column7"
               @ref="column7">
    </IgbColumn>

    <IgbColumn Header="Action"
               BodyTemplateScript="WebGridCellTemplate">
    </IgbColumn>
</IgbGrid>

<IgbDataGrid Height="100%" Width="100%" @ref="grid"
             DefaultColumnMinWidth="120"
             AutoGenerateColumns="false"
             DataSource="pagedData"
             ActivationMode="@GridActivationMode.Cell"
             SelectionMode="@DataGridSelectionMode.SingleRow"
             SelectionBehavior="@GridSelectionBehavior.ModifierBased"
             IsColumnOptionsEnabled="true">
    <IgbTextColumn Field="Id" Width="@("*>150")" />
    <IgbTextColumn Field="Loai" HeaderText="Loai" Width="@("*>160")" />
    <IgbDateTimeColumn Field="NgayCT" HeaderText="NgayCT" Width="@("*>120")" />
    <IgbTextColumn Field="SoCT" HeaderText="SoCT" Width="@("*>120")" />
    <IgbTextColumn Field="MaDonVi" HeaderText="MaDonVi" Width="@("*>170")" />
    <IgbTextColumn Field="TenDonVi" HeaderText="TenDonVi" Width="@("*>170")" />
    <IgbNumericColumn Field="TongTienHang" HeaderText="TongTienHang" Width="@("*>170")" />
    <IgbTextColumn Field="DienGiai" HeaderText="DienGiai" Width="@("*>170")" />
    <IgbTemplateColumn Field="ButtonColumn" HeaderText="Action" CellUpdatingScript="onUpdatingTemplateColumnNhapXuat" />

</IgbDataGrid>

