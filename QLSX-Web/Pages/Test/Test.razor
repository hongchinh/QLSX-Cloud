    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {


            await LoadData();
            StateHasChanged();

        }
         
        await base.OnAfterRenderAsync(firstRender);
    }
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (module is not null)
        {
            await module.DisposeAsync();
        }
    }
    private IgbGrid grid1;
    private IgbColumn column1;
    private IgbColumn column2;
    private IgbColumn column3;
    private IgbColumn column4;
    private IgbColumn column5;
    private IgbColumn column6;
    private IgbColumn column7;
    private IgbColumn column8;
    private IgbColumn column9;

    private async Task InvokeJavaScriptFunction()
    {
        await JS.InvokeVoidAsync("DOMCleanup.myJavaScriptFunction2");
    }

     
    protected override async Task OnInitializedAsync()
    {

        itemRequest = new NhapXuatSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 10,
                Page = 0,
                TotalPages = 0

            };
        pageSize = 10;
        await base.OnInitializedAsync();
    }

    async Task HandleSortingDone(IgbSortingExpressionEventArgs eventArgs)
    {
        var evt = eventArgs;
        if (evt.Detail.Count() == 0)
        {
            itemRequest.SortDirection = QLSX.Shared.Enums.SortDirection.None;
        }
        else
        {
            foreach (var item in evt.Detail)
            {
                itemRequest.SortLable = item.FieldName;
                if (item.Dir == SortingDirection.Asc)
                {
                    itemRequest.SortDirection = QLSX.Shared.Enums.SortDirection.Ascending;

                }
                else
                {
                    itemRequest.SortDirection = QLSX.Shared.Enums.SortDirection.Descending;
                }


            }
        }


        await LoadData();
    }
    async Task HandlePageChanged(IgbNumberEventArgs eventArgs)
    {
        pageSize = (int)eventArgs.Detail;
        await LoadData();
    }
    async Task HandlePagingDone(IgbPageEventArgs eventArgs)
    {
        var evt = eventArgs;
        currentPage = (int)eventArgs.Detail.Current;
        await LoadData();
    }

    async Task LoadData()
    {
        if (currentPage <= 0) itemRequest.Page = 0;
        else itemRequest.Page = currentPage;
        itemRequest.PageSize = pageSize;
        lsResponses = new GetAllResponsePaged<NhapXuatModel>();
        nhapxuat = new NhapXuatModel();

        lsResponses = await nhapxuatService.GetAllPagedAsync(itemRequest);
        pagedDataGrid = lsResponses.Items ?? new List<NhapXuatModel>();
        pagedData = new ObservableCollection<NhapXuatModel>(lsResponses.Items) ?? new ObservableCollection<NhapXuatModel>();
        totalCount = lsResponses.TotalRecords;

        StateHasChanged();
    }

