@namespace QLSX.Web.Pages.TraCuuSoDu

<div class="form-group">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>

    <EditForm Model="@itemRequest" OnValidSubmit="@SearchClick" id="idForm">
        <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" @bind-Date="itemRequest.TuNgay" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Label="Từ ngày" Variant="Variant.Outlined"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="5">
                    <MudDatePicker Margin="Margin.Dense" @bind-Date="itemRequest.DenNgay" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Label="Đến ngày" Variant="Variant.Outlined"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                </MudItem>
                <MudItem xs="12" sm="3" lg="3">
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.MaHangHoa" Label="Mã hàng hóa" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="5">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.TenHangHoa" Label="Tên hàng hóa" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.DonViTinh" Label="Đơn vị tính" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="3">
                </MudItem>
                <MudItem xs="12" sm="3" lg="3">
                    <MudSelect T="int" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.DMKhoHangId" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="0"> Tất cả</MudSelectItem>
                        @if (lstKhoHang != null)
                        {
                            @foreach (var cnt in lstKhoHang)
                            {
                                <MudSelectItem T="int" Value="@(cnt.Id)"> @cnt.TenKho </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudToolBar>
                        <MudButton ButtonType="ButtonType.Submit" Size="Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary">Tìm kiếm</MudButton>
                        <MudButton Class="ml-1" Size="Size.Large" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="Color.Secondary">Excel</MudButton>
                    </MudToolBar>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>

    <div class="form-group">
        <MudTable ServerData="@(new Func<TableState, Task<TableData<SoTongHopHangHoa>>>(ServerReload))"
                  Breakpoint="Breakpoint.Sm" Virtualize="true" FixedHeader="true"
                  RowClassFunc="@SelectedRowClassFunc"
                  Dense="true" Hover="true" Bordered="true" Striped="true"
                  Loading="@isLoading" FixedFooter="true"
                  @ref="table" HorizontalScrollbar="true"
                  Height="@HeightOfTable">
            <ColGroup>
                <col />
                <col style="width: 400px;min-width: 400px;" />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
                <col />
            </ColGroup>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="MaHangHoa" T="SoTongHopHangHoa">Mã hàng hóa</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenHangHoa" T="SoTongHopHangHoa">Tên hàng hóa</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="DonViTinh" T="SoTongHopHangHoa">Đơn vị tính</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoLuongDau" T="SoTongHopHangHoa">Số lượng đầu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienDau" T="SoTongHopHangHoa">Số tiền đầu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoLuongNhap" T="SoTongHopHangHoa">Số lượng nhập</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienNhap" T="SoTongHopHangHoa">Số tiền nhập</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoLuongXuat" T="SoTongHopHangHoa">Số lượng xuất</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienXuat" T="SoTongHopHangHoa">Số tiền xuất</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoLuongTon" T="SoTongHopHangHoa">Số lượng tồn</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoTienTon" T="SoTongHopHangHoa">Số tiền tồn</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenKho" T="SoTongHopHangHoa">Tên kho</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="MaHangHoa">
                    <MudButton Variant="Variant.Text" ButtonType="ButtonType.Button" OnClick="async ()=> await PrintSoChiTiet(context.DMHangHoaId)" Color="Color.Success">@context.MaHangHoa</MudButton>
                </MudTd>
                <MudTd DataLabel="TenHangHoa">@context.TenHangHoa</MudTd>
                <MudTd DataLabel="DonViTinh">@context.DonViTinh</MudTd>
                <MudTd DataLabel="SoLuongDau" Style="text-align:right"><MudButton OnClick="@(() => OpenShowSoDu(context.DMHangHoaId))">@context.SoLuongDau?.ToString("###,##0.##")</MudButton></MudTd>
                <MudTd DataLabel="SoTienDau" Style="text-align:right"><MudButton OnClick="@(() => OpenShowSoDu(context.DMHangHoaId))">@context.SoTienDau?.ToString("###,###")</MudButton></MudTd>
                <MudTd DataLabel="SoLuongNhap" Style="text-align:right"><MudButton OnClick="@(() => OpenShowNhap(context.DMHangHoaId))"> @context.SoLuongNhap?.ToString("###,##0.##") </MudButton> </MudTd>
                <MudTd DataLabel="SoTienNhap" Style="text-align:right"><MudButton OnClick="@(() => OpenShowNhap(context.DMHangHoaId))">@context.SoTienNhap?.ToString("###,###")</MudButton> </MudTd>
                <MudTd DataLabel="SoLuongXuat" Style="text-align:right"><MudButton OnClick="@(() => OpenShowXuat(context.DMHangHoaId))">@context.SoLuongXuat?.ToString("###,##0.##")</MudButton> </MudTd>
                <MudTd DataLabel="SoTienXuat" Style="text-align:right"><MudButton OnClick="@(() => OpenShowXuat(context.DMHangHoaId))">@context.SoTienXuat?.ToString("###,###")</MudButton> </MudTd>
                <MudTd DataLabel="SoLuongTon" Style="text-align:right"><MudButton OnClick="@(() => OpenShowTon(context.DMHangHoaId))">@context.SoLuongTon?.ToString("###,##0.##")</MudButton></MudTd>
                <MudTd DataLabel="SoTienTon" Style="text-align:right"><MudButton OnClick="@(() => OpenShowTon(context.DMHangHoaId))">@context.SoTienTon?.ToString("###,###")</MudButton></MudTd>
                <MudTd DataLabel="TenKho">@context.TenKho</MudTd>

            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có bản ghi nào tìm thấy</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                @*<MudTablePager />*@
            </PagerContent>
            <FooterContent>
                <MudTd colspan="3" Style=" font-weight:bold"> TỔNG CỘNG</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoLuongDau)?.ToString("###,##0.##") </MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoTienDau)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoLuongNhap)?.ToString("###,##0.##")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoTienNhap)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoLuongXuat)?.ToString("###,##0.##")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoTienXuat)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoLuongTon)?.ToString("###,##0.##")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoTienTon)?.ToString("###,###")</MudTd>
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </div>
</div>
