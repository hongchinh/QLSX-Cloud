    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Tra cứu tồn kho",href: null, disabled: true)
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        itemRequest = new TraCuuTonKhoRequest();
        itemRequest.PageSize = 10;
        itemRequest.Page = 0;
        itemRequest.TotalPages = 0;
        itemRequest.TuNgay = DateTime.Today.AddMonths(-1);
        itemRequest.DenNgay = DateTime.Today;
        lsResponses = new GetAllResponsePaged<SoTongHopHangHoa>();
        lstKhoHang = await dmkhohangService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //isLoading = true;
            itemRequest.TuNgay = DateTime.Today.AddMonths(-1);
            itemRequest.DenNgay = DateTime.Today;
            await JSRuntime.InvokeAsync<string>("resizeListener", DotNetObjectReference.Create(this));
            var dimension = await JSRuntime.InvokeAsync<WindowDimensions>("getWindowSize");
            windowHeight = dimension.Height;
            windowWidth = dimension.Width;
            HeightOfTable = (windowHeight - 291).ToString() + "px";
            await baocaoService.ClearDataInAsync();
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");

            //isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose() { }
    [JSInvokable]
    private async Task PrintSoChiTiet(int? id)
    {
        if (id == null) return;
        List<int> lstId = new List<int>();
        lstId.Add(id ?? 0);
        await baocaoService.ClearDataInAsync();
        var result = await productServicece.UpdateListPrintAsync(lstId);

        var user = (await authenticationStateTask).User;
        var userId = user.FindFirst(c => c.Type == "UserId")?.Value;
        userId = string.IsNullOrEmpty(userId) ? "0" : userId;
        var mdvsd = user.FindFirst(c => c.Type == "TenantId")?.Value ?? "0";

        string urlPrint = @"{0}/Reports/Viewer?ReportFileName={1}&tungay={2}&denngay={3}&mdvsd={4}&UserId={5}";
        var tungay = itemRequest.TuNgay?.ToString("yyyy/MM/dd") ?? DateTime.Now.ToString("yyyy/MM/dd");
        var denngay = itemRequest.DenNgay?.ToString("yyyy/MM/dd") ?? DateTime.Now.ToString("yyyy/MM/dd");

        urlPrint = string.Format(urlPrint, hostReport, "rptChiTietHangHoa",
        tungay, denngay,
        mdvsd, userId);

        await JSRuntime.InvokeAsync<WindowDimensions>("printReport", urlPrint);
    }

    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<SoTongHopHangHoa>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<SoTongHopHangHoa>();
        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "SoTongHopHangHoa");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await listService.TraCuuTonKhoHangHoaAsync(itemRequest);
        }
        IEnumerable<SoTongHopHangHoa> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<SoTongHopHangHoa>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<SoTongHopHangHoa>() { TotalItems = totalItems, Items = pagedData };
    }
    private void RowClickEvent(TableRowClickEventArgs<SoTongHopHangHoa> tableRowClickEventArgs)
    {
        toastService.ShowInfo("HH: " + table.SelectedItem?.MaHangHoa);
    }

    private string SelectedRowClassFunc(SoTongHopHangHoa element, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            return string.Empty;
        }
        else if (table.SelectedItem != null && table.SelectedItem.Equals(element))
        {
            selectedRowNumber = rowNumber;
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
