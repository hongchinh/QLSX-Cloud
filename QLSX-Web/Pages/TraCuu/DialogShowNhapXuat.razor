    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<ViewNhapXuat>> ServerReload(TableState state)
    {
        Loading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Loai = Loai;
        itemRequest.TuNgay = TuNgay;
        itemRequest.DenNgay = DenNgay;
        itemRequest.MaHangHoa = mahanghoa ?? "";
        itemRequest.MaKho = makho ?? "";
        itemRequest.DMDonViSuDungId = AppService.DMDonViSuDungId;

        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        lsResponses = new GetAllResponsePaged<ViewNhapXuat>();
        lsResponses = await listService.ViewNhapXuatAsync(itemRequest);
        IEnumerable<ViewNhapXuat> data = lsResponses.Items; ;
        totalItems = lsResponses.TotalRecords;
        if (data == null)
        {
            data = new List<ViewNhapXuat>();
        }
        pagedData = data;
        Loading = false;
        return new TableData<ViewNhapXuat>() { TotalItems = totalItems, Items = pagedData };
    }
