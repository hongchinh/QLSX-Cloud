                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd></MudTd>
                    <MudTd Style=" font-weight:bold;text-align:right">@(pagedData != null ? pagedData.Sum(x=> x.SoLuong).ToString("###,##0.##") : "0")</MudTd>
                    <MudTd></MudTd>
                    <MudTd Style=" font-weight:bold;text-align:right">@(pagedData != null ? pagedData.Sum(x=> x.SoTien).ToString("###,###") : "0") </MudTd>
                    <MudTd></MudTd>
                </FooterContent>
