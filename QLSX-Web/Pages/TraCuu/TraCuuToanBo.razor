                    <MudMenuItem Disabled="@(!quyenSuDung.Sua)" IconSize="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Sửa" @onclick="@(()=> SuaThuChiClick(@context.Id, context.Loai))">Sửa</MudMenuItem>
                    <MudMenuItem Disabled="@(!quyenSuDung.XemIn)" IconSize="Size.Small" Icon="@Icons.Material.Filled.Print" Color="Color.Primary" aria-label="In" @onclick="@(()=> PrintClick(@context.Id, context.Loai))">In</MudMenuItem>
