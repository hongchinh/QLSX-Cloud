                    <MudMenuItem Disabled="@(!quyenSuDungXuatTra.XemIn)" IconSize="Size.Small" Icon="@Icons.Material.Filled.Print" Color="Color.Primary" aria-label="In" @onclick="@(()=> PrintClick(@context.Id, context.Loai))">In</MudMenuItem>
                    @if (itemSetting.LoaiNhapXuat != 1)
                    {
