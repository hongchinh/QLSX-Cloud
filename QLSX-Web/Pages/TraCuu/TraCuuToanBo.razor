<LoadingProgress IsLoading="isLoading" />
@code {

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungNhap { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungXuat { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungNhapTra { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungXuatTra { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };


    public NhapXuatModel nhapxuat { get; set; }

    public GetAllResponsePaged<TraCuuNhapXuatAll> lsResponses { get; set; }
    public NhapXuatSearchRequest itemRequest { get; set; }
    public bool IsVisible { get; set; }
    bool isLoading = true;
    public UserModel UserLogin;
    public List<DanhMucKhoHangModel> lstKhoHang { get; set; }
    public List<DanhMucLoaiTienModel> lstLoaiTien { get; set; }

    public string selecttedKhohang { get; set; }
    public int selecttedLoaiTien { get; set; }
    public string selecttedLoai { get; set; }

    private IEnumerable<TraCuuNhapXuatAll> pagedData;
    private IEnumerable<TraCuuNhapXuatAll> ListSumTotal;
    private MudTable<TraCuuNhapXuatAll> table;
    public string HeightOfTable { get; set; } = "350px";
    public int HeightGrid { get; set; } = 0;

    private int totalItems;
    private string searchString = null;
    public string hostReport { get; set; }
    public string mdvsd { get; set; }
    public QLSX.Shared.Models.SettingModel itemSetting { get; set; } = new QLSX.Shared.Models.SettingModel { LoaiNhapXuat = 1 };
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Tra cứu chứng từ",href: null, disabled: true)
    };



    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        lsResponses = new GetAllResponsePaged<TraCuuNhapXuatAll>();
        nhapxuat = new NhapXuatModel();
        itemRequest = new NhapXuatSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 20,
                Page = 0,
                TotalPages = 0

            };


        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //isLoading = true;
            lstKhoHang = await dmkhohangService.GetAllAsync();
            lstLoaiTien = await dmLoaiTienService.GetAllAsync();
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");
            var user = (await authenticationStateTask).User;
            var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
            UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
            itemSetting = await itemService.GetByIdAsync(int.Parse(UserId));
            mdvsd = user.FindFirst(c => c.Type == "TenantId")?.Value ?? "0";

            //await JSRuntime.InvokeAsync<string>("resizeListener", DotNetObjectReference.Create(this));
            //var dimension = await JSRuntime.InvokeAsync<WindowDimensions>("getWindowSize");
            //HeightOfTable = (dimension.Height - 291).ToString() + "px";
            var hgrid = await JSRuntime.InvokeAsync<WindowDimensions>("getGridSize", "idSearch", "idTool","idTong");
            HeightGrid = hgrid.Height - 120;

            //isLoading = false;
            StateHasChanged();
        }
        //await JSRuntime.InvokeAsync<object>("TestDataTablesAdd", "#GridTable");
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<TraCuuNhapXuatAll>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        if (!string.IsNullOrEmpty(selecttedKhohang))
        {
            itemRequest.MaKhoHang = selecttedKhohang;
        }
        else
        {
            itemRequest.MaKhoHang = string.Empty;
        }
        if (selecttedLoaiTien > 0)
        {
            itemRequest.DMLoaiTienId = selecttedLoaiTien;
        }
        else
        {
            itemRequest.DMLoaiTienId = 0;
        }
        lsResponses = new GetAllResponsePaged<TraCuuNhapXuatAll>();

        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "tracuunhapxuat");
        quyenSuDungNhap = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhap");
        quyenSuDungXuat = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuat");
        quyenSuDungNhapTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhaptra");
        quyenSuDungXuatTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuattra");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await tracuuService.TraCuuToanBoAsync(itemRequest);
        }
        IEnumerable<TraCuuNhapXuatAll> data = lsResponses.Items;
        ListSumTotal = lsResponses.ListData;
        totalItems = lsResponses.TotalRecords;

        pagedData = data ?? new List<TraCuuNhapXuatAll>(); ;
        isLoading = false;
        StateHasChanged();
        return new TableData<TraCuuNhapXuatAll>() { TotalItems = totalItems, Items = pagedData };
    }


    public void Dispose()
    {
    }
    private async Task SuaThuChiClick(int id, string loai)
    {
        string title = "Sửa";
        if (loai == "thutm")
        {
            title = "Sửa Phiếu thu";
        }
        else if (loai == "chitm")
        {
            title = "Sửa Phiếu chi";

        }
        var parameters = new DialogParameters { ["ThuChiId"] = id, ["loaiThuChi"] = loai, ["Title"] = title };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraExtraLarge, FullScreen = true, FullWidth = true };
        var result = await DialogService.Show<QLSX.Web.Pages.ThuChiPage.ThuChiEdit>("Sửa", parameters, options).Result;
        if (!result.Canceled)
        {
            var itemSelected = (ThuChiModel)(result.Data ?? null);
            if (itemSelected != null)
            {
                await table.ReloadServerData();
            }
        }
    }
    private async Task PrintClick(int id, string loai)
    {
        if (loai == "nhap")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=rptPhieuNhap&id=" + id + "&mdvsd=" + mdvsd;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
