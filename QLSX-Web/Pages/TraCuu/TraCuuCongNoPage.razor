@inject IDMKhoHangService<DanhMucKhoHangModel> dmkhohangService

@namespace QLSX.Web.Pages.TraCuuCongNoPage


<div class="form-group">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <EditForm Model="@itemRequest" OnValidSubmit="@SearchClick" id="idForm">
        <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" @bind-Date="itemRequest.TuNgay" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Label="Từ ngày" Variant="Variant.Outlined"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" @bind-Date="itemRequest.DenNgay" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Label="Đến ngày" Variant="Variant.Outlined"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="int" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.Loai" Variant="Variant.Outlined">
                        <MudSelectItem T="int" Value="0"> Tất cả </MudSelectItem>
                        <MudSelectItem T="int" Value="1"> Phải thu </MudSelectItem>
                        <MudSelectItem T="int" Value="2"> Phải trả </MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="6">
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.MaDonVi" Label="Mã đơn vị" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="5">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.TenDonVi" Label="Tên đơn vị" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="3">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.DiaChi" Label="Địa chỉ" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.DienThoai" Label="Điện thoại" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="6" sm="6">
                    <MudToolBar>
                        <MudButton ButtonType="ButtonType.Submit" Size="Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary">Tìm kiếm</MudButton>
                        <MudButton Class="ml-1" Size="Size.Large" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="Color.Secondary">Excel</MudButton>
                    </MudToolBar>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>
    <div class="form-group">
        <MudTable ServerData="@(new Func<TableState, Task<TableData<TraCuuCongNo>>>(ServerReload))"
                  Breakpoint="Breakpoint.Sm" Virtualize="true" FixedHeader="true"
                  RowClassFunc="@SelectedRowClassFunc"
                  Dense="true" Hover="true" Bordered="true"
                  Striped="true" Loading="@isLoading" FixedFooter="true"
                  Height="@HeightOfTable"
                  @ref="table" HorizontalScrollbar="true">
            <ColGroup>
                <col />
                <col style="width: 300px;min-width: 200px;" />
                <col style="width: 300px;min-width: 200px;" />
                <col />
                <col />
                <col />
                <col />
            </ColGroup>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="MaDonVi" T="TraCuuCongNo">Mã đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenDonVi" T="TraCuuCongNo">Tên đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="DiaChi" T="TraCuuCongNo">Địa chỉ</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiThuDau" T="TraCuuCongNo">Phải thu đầu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiTraDau" T="TraCuuCongNo">Phải trả đầu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiThu" T="TraCuuCongNo">Phải thu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiTra" T="TraCuuCongNo">Phải trả</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiThuCuoi" T="TraCuuCongNo">Phải thu cuối</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoPhaiTraCuoi" T="TraCuuCongNo">Phải trả cuối</MudTableSortLabel></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="MaDonVi"> @context.MaDonVi</MudTd>
                <MudTd DataLabel="TenDonVi">@context.TenDonVi</MudTd>
                <MudTd DataLabel="DiaChi">@context.DiaChi</MudTd>
                <MudTd DataLabel="SoPhaiThuDau" Style="text-align:right"><MudButton OnClick="@(() => OpenShowSoDu1(context.MaDonVi))">@context.SoPhaiThuDau?.ToString("###,###")</MudButton></MudTd>
                <MudTd DataLabel="SoPhaiTraDau" Style="text-align:right"><MudButton OnClick="@(() => OpenShowMua(context.MaDonVi))">@context.SoPhaiTraDau?.ToString("###,###")</MudButton></MudTd>
                <MudTd DataLabel="SoPhaiThu" Style="text-align:right"><MudButton OnClick="@(() => OpenShowTra(context.MaDonVi))"> @context.SoPhaiThu?.ToString("###,###") </MudButton> </MudTd>
                <MudTd DataLabel="SoPhaiTra" Style="text-align:right"><MudButton OnClick="@(() => OpenShowSoDu2(context.MaDonVi))">@context.SoPhaiTra?.ToString("###,###")</MudButton> </MudTd>
                <MudTd DataLabel="SoPhaiThuCuoi" Style="text-align:right"><MudButton OnClick="@(() => OpenShowTra(context.MaDonVi))"> @context.SoPhaiThuCuoi?.ToString("###,###") </MudButton> </MudTd>
                <MudTd DataLabel="SoPhaiTraCuoi" Style="text-align:right"><MudButton OnClick="@(() => OpenShowSoDu2(context.MaDonVi))">@context.SoPhaiTraCuoi?.ToString("###,###")</MudButton> </MudTd>

            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có bản ghi nào tìm thấy</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                @*<MudTablePager />*@
            </PagerContent>
            <FooterContent>
                <MudTd colspan="3" Style=" font-weight:bold"> TỔNG CỘNG</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiThuDau)?.ToString("###,###") </MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiTraDau)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiThu)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiTra)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiThuCuoi)?.ToString("###,###")</MudTd>
                <MudTd Style=" font-weight:bold;text-align:right">@pagedData?.Sum(x => x.SoPhaiTraCuoi)?.ToString("###,###")</MudTd>
                <MudTd></MudTd>
            </FooterContent>
        </MudTable>
    </div>
</div>
