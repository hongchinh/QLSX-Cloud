        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            //isLoading = true;
            itemRequest.TuNgay = DateTime.Today.AddMonths(-1);
            itemRequest.DenNgay = DateTime.Today;
            isLoading = false;

            await JSRuntime.InvokeAsync<string>("resizeListener", DotNetObjectReference.Create(this));
            var dimension = await JSRuntime.InvokeAsync<WindowDimensions>("getWindowSize");
            windowHeight = dimension.Height;
            windowWidth = dimension.Width;
            HeightOfTable = (windowHeight - 291).ToString() + "px";

            //SetPageSize();
            //isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose() { }

    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<TraCuuCongNo>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<TraCuuCongNo>();
        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "TraCuuCongNo");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await listService.TraCuuCongNoAsync(itemRequest);
        }
        IEnumerable<TraCuuCongNo> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<TraCuuCongNo>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<TraCuuCongNo>() { TotalItems = totalItems, Items = pagedData };
    }
    private void RowClickEvent(TableRowClickEventArgs<TraCuuCongNo> tableRowClickEventArgs)
    {
