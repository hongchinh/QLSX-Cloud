    private async Task SuaNhapXuatClick(int id, string loai)
    {
        string title = "Sửa";
        if (loai == "nhap")
        {
            title = "Sửa Phiếu nhập";
        }
        else if (loai == "xuat")
        {
            title = "Sửa Phiếu xuất";

        }
        else if (loai == "nhaptra")
        {
            title = "Sửa Phiếu nhập trả";
        }
        else if (loai == "xuattra")
        {
            title = "Sửa Phiếu xuất trả";
        }
        var parameters = new DialogParameters { ["NhapXuatId"] = id, ["loaiNX"] = loai, ["Title"] = title };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraExtraLarge, FullScreen = true, FullWidth = true };
        var result = await DialogService.Show<QLSX.Web.Pages.NhapXuatPage.NhapXuatEdit>("Sửa", parameters, options).Result;
        if (!result.Canceled)
        {
            var itemSelected = (NhapXuatModel)(result.Data ?? null);
            if (itemSelected != null)
            {
                await table.ReloadServerData();
            }
        }
    }
    private async Task SuaThuChiClick(int id, string loai)
    {
        string title = "Sửa";
        if (loai == "thutm")
        {
            title = "Sửa Phiếu thu";
        }
        else if (loai == "chitm")
        {
            title = "Sửa Phiếu chi";

        }
        var parameters = new DialogParameters { ["ThuChiId"] = id, ["loaiThuChi"] = loai, ["Title"] = title };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.ExtraExtraLarge, FullScreen = true, FullWidth = true };
        var result = await DialogService.Show<QLSX.Web.Pages.ThuChiPage.ThuChiEdit>("Sửa", parameters, options).Result;
        if (!result.Canceled)
        {
            var itemSelected = (ThuChiModel)(result.Data ?? null);
            if (itemSelected != null)
            {
                await table.ReloadServerData();
            }
        }
    }

