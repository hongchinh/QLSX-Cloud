<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer>
            <MudTable ServerData="@(new Func<TableState, Task<TableData<ViewNhapXuat>>>(ServerReload))"
                      Height="400px" FixedHeader="true" FixedFooter="true"
                      Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@Loading" @ref="table"
                      T="ViewNhapXuat">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortLabel="NgayCT" T="ViewNhapXuat">Ngày CT</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="SoCT" T="ViewNhapXuat">Số Chứng từ</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="MaDonVi" T="ViewNhapXuat">Mã Đơn vị</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="TenDonVi" T="ViewNhapXuat">Tên Đơn vị</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="DiaChi" T="ViewNhapXuat">Địa chỉ</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="SoTien" T="ViewNhapXuat">Số tiền</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortLabel="DienGiai" T="ViewNhapXuat">Diễn giải</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="NgayCT">
                        <MudText> @string.Format("{0:dd/MM/yyyy}",@context.NgayCT)</MudText>
                    </MudTd>
                    <MudTd DataLabel="SoCT">
                        @if (context.Loai.StartsWith("nhap") || context.Loai.StartsWith("xuat"))
                        {
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="@(async ()=> await SuaNhapXuatClick( context.Id,context.Loai))">@context.SoCT</MudButton>
                        }
                        else
                        {
                            <MudButton Color="Color.Primary" Size="Size.Small" OnClick="@(async ()=> await SuaThuChiClick(context.Id,context.Loai ))">@context.SoCT</MudButton>
                        }
                    </MudTd>
                    <MudTd DataLabel="MaDonVi">
                        <MudText> @context.MaDonVi</MudText>
                    </MudTd>
                    <MudTd DataLabel="TenDonVi">
                        <MudText> @context.TenDonVi</MudText>
                    </MudTd>
                    <MudTd DataLabel="DiaChi">
                        <MudText> @context.DiaChi</MudText>
                    </MudTd>
                    <MudTd DataLabel="SoTien">
                        <MudText Style="text-align:right"> @context.SoTien.ToString("###,###") </MudText>
                    </MudTd>
                    <MudTd DataLabel="DienGiai">
                        <MudText> @context.DienGiai</MudText>
                    </MudTd>

                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Không có bản ghi nào tìm thấy</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Đang tải dữ liệu...</MudText>
                </LoadingContent>

                <FooterContent>
                    <MudTd colspan="5" Style=" font-weight:bold"> TỔNG CỘNG</MudTd>
                    <MudTd Style=" font-weight:bold">@pagedData?.Sum(x=> x.SoTien).ToString("###,###") </MudTd>
                    <MudTd></MudTd>
                </FooterContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Cancel">Bỏ qua</MudButton>
    </DialogActions>
</MudDialog>
