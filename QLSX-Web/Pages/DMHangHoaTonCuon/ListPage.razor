                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="0" sm="0" lg="2" Class="m-0 p-0"></MudItem>

                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="int" Label="Màu sắc" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.DMMauSacId" Variant="Variant.Outlined">
                                    <MudSelectItem T="int" Value="0"> Tất cả</MudSelectItem>
                                    @if (lstMauSac != null)
                                    {
                                        @foreach (var cnt in lstMauSac)
                                        {
                                            <MudSelectItem T="int" Value="@(cnt.Id)"> @cnt.ChiTieu </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="int" Label="Độ dày" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.DMDoDayId" Variant="Variant.Outlined">
                                    <MudSelectItem T="int" Value="0"> Tất cả</MudSelectItem>
