            lstChungLoai = await chungloaiService.GetAllAsync();
            lstDoDay = await dodayService.GetAllAsync();
            lstKieuSong = await kieusongService.GetAllAsync();
            lstLoaiTon = await loaitonService.GetAllAsync();
            lstMauSac = await mausacService.GetAllAsync();
            lstNhomHang = await nhomhangService.GetAllAsync();

            isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
    }


    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<GridData<DanhMucHangHoaTonCuonModel>> ServerReload(GridState<DanhMucHangHoaTonCuonModel> state)
    {
        isLoading = true;
        var sort = state.SortDefinitions.ToList();
        itemRequest.Page = state.Page;
        //itemRequest.Filter = state.FilterDefinitions;
        if (sort.Count > 0)
        {
            for (int i = 0; i < sort.Count; i++)
            {
                itemRequest.SortLable = sort[i].SortBy;
                itemRequest.SortDirection = sort[i].Descending ? QLSX.Shared.Enums.SortDirection.Descending : QLSX.Shared.Enums.SortDirection.Ascending;
            }
        }
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<DanhMucHangHoaTonCuonModel>();
        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "DMHangHoaTonCuon");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await hanghoaService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<DanhMucHangHoaTonCuonModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;
        if (data == null)
        {
            data = new List<DanhMucHangHoaTonCuonModel>();
        }

        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new GridData<DanhMucHangHoaTonCuonModel>() { TotalItems = totalItems, Items = pagedData };
    }

    private async Task EditClick(DanhMucHangHoaTonCuonModel item)
    {
        var parameters = new DialogParameters
            {
                ["server"] = item,
                ["lstChungLoai"] = lstChungLoai,
                ["lstDoDay"] = lstDoDay,
                ["lstKieuSong"] = lstKieuSong,
                ["lstLoaiTon"] = lstLoaiTon,
                ["lstMauSac"] = lstMauSac,
                ["lstNhomHang"] = lstNhomHang,
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Edit>("Sửa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Cập nhât thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi Cập nhât", "Thông báo");
            }
        }
    }

