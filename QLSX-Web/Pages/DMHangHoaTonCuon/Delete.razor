@inject ILogger<Delete> Logger
@inject IJSRuntime JSRuntime
@inject IDMHangHoaTonCuonService<DanhMucHangHoaTonCuonModel> hanghoaService

@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.DMHangHoaTonCuonPage


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1" />
            Xóa
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.Id.ToString()" Label="Id" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.MaHangHoa" Label="Mã hàng hóa" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="m-0 p-0"></MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@server.TenHangHoa" Label="Tên hàng hóa" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField Value="@server.DonViTinh" Label="ĐVT" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Value="@server.DMNhomHangs.TenNhom" Label="Tên nhóm" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.DMChungLoais.ChiTieu" Label="Chủng loại" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.DMDoDays.ChiTieu" Label="Độ dày" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.DMMauSacs.ChiTieu" Label="Màu sắc" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.DMLoaiTons.ChiTieu" Label="Loại tôn" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error" >Bỏ qua</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => DeleteClick(server.Id))" Class="me-3">Xóa</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public DanhMucHangHoaTonCuonModel server { get; set; } = new DanhMucHangHoaTonCuonModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async Task DeleteClick(int id)
    {
        var isdelete = await hanghoaService.DeleteAsync(id);
        MudDialog.Close(DialogResult.Ok(isdelete));
    }
 }
