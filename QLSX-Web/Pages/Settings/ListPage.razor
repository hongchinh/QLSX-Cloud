@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    ClaimsPrincipal userAuth;
    string image_url { get; set; } = "img/noimage.png";
    string image_url_logo { get; set; } = "Files/mathome.png";
    long maxFileSize = 10 * 1024 * 1024;
    IBrowserFile files { get; set; }
    IBrowserFile file1s { get; set; }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {

            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            image_url = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            files = file;


        }
        StateHasChanged();
        //TODO upload the files to the server
    }
    private async Task UploadFile1s(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {

            using var stream = file.OpenReadStream(maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            image_url_logo = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
            file1s = file;
        }
        StateHasChanged();
        //TODO upload the files to the server
    }
    public QLSX.Shared.Models.SettingModel item { get; set; } = new QLSX.Shared.Models.SettingModel();
    public List<NganHangDetail> lstNganHang = new List<NganHangDetail>();

    protected override void OnInitialized()
    {
        Console.WriteLine("Setting - OnInitialized");
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var userLogin = (await authenticationStateTask).User;
            var UserId = userLogin.FindFirst(c => c.Type == "UserId")?.Value;
            UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
            item = await itemService.GetByIdAsync(int.Parse(UserId));
            image_url = item.PathImage ?? "img/noimage.png";
            image_url_logo = item.PathLogoImage ?? "Files/mathome.png";

            // var data = await itemService.GetListNganHang();

            lstNganHang = new List<NganHangDetail>
            {
                new NganHangDetail { code = "TCB", short_name = "Techcombank" },
                new NganHangDetail { code = "ACB", short_name = "ACB" },
                new NganHangDetail { code = "VIB", short_name = "VIB" },
                new NganHangDetail { code = "STB", short_name = "Sacombank" },
                new NganHangDetail { code = "MB", short_name = "MBBank" },
                new NganHangDetail { code = "VCB", short_name = "Vietcombank" },
                new NganHangDetail { code = "BIDV", short_name = "BIDV" },
            };

            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
    }
    private async Task SaveClick()
    {
        try
        {
            var userLogin = (await authenticationStateTask).User;
            var UserId = userLogin.FindFirst(c => c.Type == "UserId")?.Value;
            UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
            var trustedFileNameForFileStorage = UserId.ToString() + "_user.png";
            var path = Path.Combine(Environment.WebRootPath,
                    "img", trustedFileNameForFileStorage);

            if (files != null)
            {
                await using FileStream fs = new(path, FileMode.Create);
                await files.OpenReadStream(maxFileSize).CopyToAsync(fs);
            }

            var trustedFileNameForFileStorage1 = UserId.ToString() + "_logo.png";
            var path1 = Path.Combine(Environment.WebRootPath,
                "img", trustedFileNameForFileStorage1);
            if (file1s != null)
            {
                await using FileStream fs = new(path1, FileMode.Create);
                await file1s.OpenReadStream(maxFileSize).CopyToAsync(fs);
            }
            item.PathLogoImage = Path.Combine("img", trustedFileNameForFileStorage1);
            item.PathImage = Path.Combine("img", trustedFileNameForFileStorage);

            await itemService.UpdateAsync(item.Id, item);
        }
        catch (Exception)
        {

            throw;
        }


    }

}