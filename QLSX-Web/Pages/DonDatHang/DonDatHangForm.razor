    public async Task MaHangHoaTextChanged(string mahh)
    {
        if (IsFirstEdit == 1)
        {
            IsFirstEdit = -1;
            return;
        }
        if (selectedNoiDungBeforeEdit.MaHangHoa == mahh && selectedNoiDung.IsEditing) return;

        DanhMucHangHoaModel dmhanghoa = await dmhanghoaService.GetByCodeAsync(mahh);
        selectedNoiDung.IsEditing = false;
        if (dmhanghoa.Id > 0)
        {
            selectedNoiDung.TenHangHoa = dmhanghoa.TenHangHoa;
            selectedNoiDung.DonViTinh = dmhanghoa.DonViTinh;
            selectedNoiDung.DonGia = dmhanghoa.GiaXuat;
            selectedNoiDung.KhoRongTon = dmhanghoa.KhoRongTon;
            selectedNoiDung.ChieuDai = dmhanghoa.ChieuDai;
            selectedNoiDung.DMHangHoaId = dmhanghoa.Id;
            selectedNoiDung.DMDonViSuDungId = nhapxuat.DMDonViSuDungId;
            selectedNoiDung.DMKhoHangId = nhapxuat?.DMKhoHangId ?? 0;
            selectedNoiDung.IsM2 = false;
            selectedNoiDung.IsMD = false;
            selectedNoiDung.IsSoLuong = false;

            if (dmhanghoa.MaNhomHang == "01")
            {
                selectedNoiDung.IsM2 = true;
                selectedNoiDung.TongChieuDai = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.TongDienTich = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.KhoRongTon * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.SoTien = dmhanghoa.ChieuDai * dmhanghoa.KhoRongTon * selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
            else if (dmhanghoa.MaNhomHang == "02")
            {

                selectedNoiDung.IsMD = true;
                selectedNoiDung.TongChieuDai = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.TongDienTich = 0;
                selectedNoiDung.SoTien = dmhanghoa.ChieuDai * selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
            else
            {
                selectedNoiDung.IsSoLuong = true;
                selectedNoiDung.TongChieuDai = 0;
                selectedNoiDung.TongDienTich = 0;
                selectedNoiDung.SoTien = selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
        }
        selectedNoiDung.SoLuongTon = await GetSoLuongTonTheoCode(selectedNoiDung.MaHangHoa, nhapxuat.MaKho, nhapxuat.NgayCT ?? DateTime.Now);
        StateHasChanged();
    }

