@using Dialogs
@using Newtonsoft.Json
@using Microsoft.AspNetCore.Mvc;
@using QLSX.Shared.Models
@using AutoMapper
@using Microsoft.Extensions.Configuration;
@using System.Globalization
@using Blazored.LocalStorage

@inject IDMHangHoaService<DanhMucHangHoaModel> dmhanghoaService
@inject IDMKhachHangService<DanhMucKhachHangModel> dmkhachhangService
@inject IDonDatHangsService<QLSX.Shared.Models.DonDatHangModel> nhapxuatService
@inject AppService AppService
@inject IReportService reportService
@inject IJSRuntime JSRuntime
@inject NavigationManager navigationManager
@inject IToastService toastService
@inject IDialogService DialogService
@inject IMapper mapper;
@inject IConfiguration configuration
@inject ILocalStorageService localStorageService
@inject ISnackbar Snackbar

@namespace QLSX.Web.Pages.DonDatHangPage

<EditForm Model="nhapxuat">
    <ObjectGraphDataAnnotationsValidator />
    <div class="card" id="idFormNX">
        <div class="card-body pa-0">
            <div class="container-lg">
                <MudForm @ref="formData" @bind-IsValid="@success" @bind-Errors="@errors">
                    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pd-nx">
                        <MudTabPanel Text="Thông tin đơn hàng">
                            <div id="home" style="margin-left:-20px; margin-top:10px">
                                <MudGrid Spacing="0">
                                    <MudItem xs="12" Class="d-flex flex-grow-1 gap-2">
                                        <div class="required" style="width:200px">
                                            <ValidationMessage For="(() => nhapxuat.SoCT)" />
                                            <MudTextField ReadOnly="@IsReadOnly" Margin="Margin.Dense" Required="true" RequiredError="Số phiếu bắt buộc nhập!" Label="Số phiếu" @bind-Value="@nhapxuat.SoCT" style="width:100%" Variant="Variant.Outlined" />
                                        </div>
                                        <div class="required" style="width:200px">
                                            <ValidationMessage For="(() => nhapxuat.NgayCT)" />
                                            <div><MudDatePicker ReadOnly="@IsReadOnly" Margin="Margin.Dense" Required="true" RequiredError="Ngày lập bắt buộc nhập!" Label="Ngày lập" @bind-Date="nhapxuat.NgayCT" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined"></MudDatePicker></div>
                                        </div>
                                        <div class="required">
                                            <MudSelect Style="width:200px" Class="mr-1" ReadOnly="@IsReadOnly" T="int" Margin="Margin.Dense" Label="Kho hàng" Validation="@(new Func<int, string>(ValidateKhoHang))" Required="true" RequiredError="Kho hàng bắt buộc nhập!" AnchorOrigin="Origin.BottomCenter" @bind-Value="@nhapxuat.DMKhoHangId" Variant="Variant.Outlined">
                                                <MudSelectItem Value="@(0)">Chọn kho hàng</MudSelectItem>
                                                @if (lstKhoHang != null)
                                                {
                                                    @foreach (var cnt in lstKhoHang)
                                                    {
                                                        <MudSelectItem Value="@cnt.Id">@cnt.TenKho</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </div>
                                        <div class="required" style="width:200px">
                                        </div>
                                    </MudItem>
                                    <MudItem sm="12" Class="d-flex flex-grow-1 gap-2">
                                        <div class="required" style="width:300px">
                                            <ValidationMessage For="(() => nhapxuat.MaDonVi)" />
                                            <MudTextField ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Mã đơn vị" @bind-Value="@nhapxuat.MaDonVi"
                                                          TextChanged="@( (input) => MaDonViTextChanged(input))"
                                                          Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                                          OnAdornmentClick="@(() => OpenDialogKhachHang())"
                                                          Immediate="true"
                                                          Required="true"
                                                          OnKeyDown="@( async (e) => await OnKeyDownMaDonVi(e))"
                                                          RequiredError="Mã đơn vị bắt buộc nhập!"
                                                          Variant="Variant.Outlined" />
                                        </div>
                                        <MudTextField Class="flex-none" Style="width:400px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Required="true" RequiredError="Tên đơn vị bắt buộc nhập!" Label="Tên đơn vị" @bind-Value="@nhapxuat.TenDonVi" Variant="Variant.Outlined" />
                                        <MudTextField Class="flex-none" Style="width:300px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Địa chỉ" @bind-Value="@nhapxuat.DiaChi" Variant="Variant.Outlined" />
                                        <MudTextField ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Điện thoại" @bind-Value="@nhapxuat.DienThoai" Variant="Variant.Outlined" />
                                    </MudItem>

                                    <MudItem xs="12" Class="d-flex flex-grow-1 gap-2">
                                        <MudDatePicker Class="flex-none" Style="width:200px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Ngày giao hàng" @bind-Date="nhapxuat.NgayGiao" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Variant="Variant.Outlined"></MudDatePicker>
                                        <MudTextField Class="flex-none" Style="width:200px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Phương tiện" @bind-Value="@nhapxuat.PhuongTien" Variant="Variant.Outlined" />
                                        <MudTextField Class="flex-none" Style="width:350px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Nơi giao" @bind-Value="@nhapxuat.NoiGiao" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem sm="4">
                                        <MudTextField ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Ghi chú" @bind-Value="@nhapxuat.DienGiai" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem sm="8" Class="d-flex flex-grow-1 gap-2">
                                        <MudNumericField Class="flex-none ml-1" Format="###,##0.##" Adornment="Adornment.End" AdornmentText="%" ReadOnly="@IsReadOnly" Style="width:150px" Margin="Margin.Dense" Label="Tỷ lệ VAT" @bind-Value="@nhapxuat.TyleVAT" Variant="Variant.Outlined" />
                                        <MudNumericField Class="flex-none" Format="###,##0.##" Adornment="Adornment.End" AdornmentText="%" ReadOnly="@IsReadOnly" Style="width:150px" Margin="Margin.Dense" Label="Phí VC" @bind-Value="@nhapxuat.TyLeThiCong" Variant="Variant.Outlined" />
                                        <div class="required" style="width:200px">
                                            <MudSelect Class="flex-none flex-grow-0" Style="width:200px" ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Loại tiền" AnchorOrigin="Origin.BottomCenter" @bind-Value="@DMLoaiTienId" Variant="Variant.Outlined">
                                                <MudSelectItem Margin="Margin.Dense" Value="@(0)">Chọn loại tiền</MudSelectItem>
                                                @if (lstLoaiTien != null)
                                                {
                                                    @foreach (var cnt in lstLoaiTien)
                                                    {
                                                        <MudSelectItem Value="@cnt.Id">@cnt.LoaiTien</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </div>
                                        <MudNumericField Class="flex-none" Format="###,##0" ReadOnly="@IsReadOnly" Style="width:200px" Margin="Margin.Dense" Label="Số tiền TT" @bind-Value="@nhapxuat.SoTienTT" Variant="Variant.Outlined" />
                                        <MudSpacer></MudSpacer>
                                    </MudItem>
                                </MudGrid>
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="Thông tin thanh toán">
                            <div id="menu2">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-1">
                                        <MudDatePicker ReadOnly="@IsReadOnly" Margin="Margin.Dense" Label="Ngày thanh toán" @bind-Date="nhapxuat.NgayHenThanhToan" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Variant="Variant.Outlined"></MudDatePicker>
                                    </div>
                                    <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-1">
                                        <div class="required">
                                            <MudSelect ReadOnly="@IsReadOnly" T="int" Margin="Margin.Dense" Label="Nhân viên kinh doanh" AnchorOrigin="Origin.BottomCenter" @bind-Value="@MaNhanVienId" Variant="Variant.Outlined">
                                                <MudSelectItem Value="@(0)">Chọn nhân viên</MudSelectItem>
                                                @if (lstUser != null)
                                                {
                                                    @foreach (var cnt in lstUser)
                                                    {
                                                        <MudSelectItem Value="@cnt.Id">@cnt.FirstName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </div>
                                    </div>
                                    <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-1">
                                        <div class="required">
                                            <MudSelect ReadOnly="@IsReadOnly" T="int" Margin="Margin.Dense" Label="Nhân viên kỹ thuật" AnchorOrigin="Origin.BottomCenter" @bind-Value="@NVKyThuatId" Variant="Variant.Outlined">
                                                <MudSelectItem Value="@(0)">Chọn nhân viên</MudSelectItem>
                                                @if (lstUser != null)
                                                {
                                                    @foreach (var cnt in lstUser)
                                                    {
                                                        <MudSelectItem Value="@cnt.Id">@cnt.FirstName</MudSelectItem>
                                                    }
                                                }
                                            </MudSelect>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </MudTabPanel>
                    </MudTabs>
                </MudForm>

            </div>
        </div>
    </div>
    <ToolBarDonDatHang nhapxuat="nhapxuat"
                       quyenSuDung="quyenSuDung"
                       IsCreateOrEdit="IsCreateOrEdit"
                       saveAndCreate="saveAndCreate"
                       SaveData="SaveData"
                       CancelClick="CancelClick"
                       SuaClickCallBack="SuaClickCallBack" />

    <div class="form-group">
        <MudTable Items="@nhapxuat.NoiDungDonDatHangs" Hover="true"
                  Dense="true" ReadOnly="@IsReadOnly" CanCancelEdit="true"
                  CancelEditTooltip="Bỏ qua"
                  @bind-SelectedItem="selectedNoiDung"
                  SortLabel="Sắp xếp theo" CommitEditTooltip="Cất" @ref="table"
                  RowEditPreview="BackupItem" RowEditCancel="ItemHasCanCel"
                  RowEditCommit="ItemHasBeenCommitted" IsEditRowSwitchingBlocked="false"
                  ApplyButtonPosition="TableApplyButtonPosition.StartAndEnd"
                  HorizontalScrollbar="true"
                  FixedHeader="true" FixedFooter="true"
                  Height="@(HeightGrid ==0 ? "": HeightGrid.ToString () + "px" )"
                  RowClassFunc="@SelectedRowClassFunc"
                  OnPreviewEditClick="@OnPreviewEditClick"
                  Class="NhapXuatTableCustom">

            <ColGroup>
                <col style="width:56px; min-width: 56px" />
                <col style="width:150px; min-width: 150px" />
                <col style="width:250px; min-width: 250px" />
                <col style="width:50px; min-width: 50px" />
                <col style="width:50px; min-width: 50px" />
                <col style="width:60px; min-width: 60px" /> @*chiều dài*@

                @if (SanPhamTheoM2)
                {
                    <col style="width:50px; min-width: 50px" /> @*số lượng*@
                    <col style="width:100px; min-width: 100px" /> @*tổng chiều dài*@
                    <col style="width:80px; min-width: 80px" /> @*khổ rộng*@
                    <col style="width:100px; min-width: 100px" /> @*tổng m2*@
                }
                <col style="width:100px; min-width: 100px" /> @*đơn giá*@
                <col style="width:150px; min-width: 150px" /> @*Số tiền*@
                <col style="width:100px; min-width: 100px" /> @*đơn giá *@
                <col style="width:150px; min-width: 150px" /> @*Số tiền*@
                <col /> @*Ghi chú*@
                <col style="width:30px; min-width: 30px" />
                <col style="width:56px; min-width: 56px" />
            </ColGroup>
            <HeaderContent>
                <MudTh Class="Custom-Hearder-Grid">Mã hàng hóa</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Tên hàng hóa</MudTh>
                <MudTh Class="Custom-Hearder-Grid">ĐVT</MudTh>
                <MudTh Class="Custom-Hearder-Grid">SL Tồn</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Số lượng</MudTh>
                @if (SanPhamTheoM2)
                {
                    <MudTh Class="Custom-Hearder-Grid">Chiều dài</MudTh>
                }


                @if (SanPhamTheoM2)
                {
                    <MudTh Class="Custom-Hearder-Grid">Tổng chiều dài</MudTh>
                    <MudTh Class="Custom-Hearder-Grid">Khổ rộng tôn</MudTh>
                    <MudTh Class="Custom-Hearder-Grid">Tổng diện tích</MudTh>
                }
                <MudTh Class="Custom-Hearder-Grid">Đơn giá</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Số tiền</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Đơn giá(HH)</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Số tiền(HH)</MudTh>
                <MudTh Class="Custom-Hearder-Grid">Ghi chú</MudTh>

            </HeaderContent>
            <RowTemplate Context="ctx">
                <MudTd DataLabel="MaHangHoa"><div class="cell-data">@ctx.MaHangHoa</div></MudTd>
                <MudTd DataLabel="TenHangHoa"><div class="cell-data">@ctx.TenHangHoa</div></MudTd>
                <MudTd DataLabel="DonViTinh"><div class="cell-data">@ctx.DonViTinh</div></MudTd>
                <MudTd DataLabel="SoLuongTon"><div class="cell-data">@ctx.SoLuongTon.ToString("###,##0.##")</div></MudTd>
                <MudTd DataLabel="SoLuong"><div class="cell-data" Style="text-align:right">@ctx.SoLuong.ToString("###,###.##")</div></MudTd>
                @if (SanPhamTheoM2)
                {
                    @if (ctx.IsM2 || ctx.IsMD)
                    {
                        <MudTd DataLabel="ChieuDai"><div class="cell-data" Style="text-align:right;color:black">@ctx.ChieuDai.ToString("###,###.##")</div></MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="ChieuDai" Class="@cssReadOnly"><div class="cell-data" Style="text-align:right;color:black">@ctx.ChieuDai.ToString("###,##0.##")</div></MudTd>
                    }
                }
                @if (SanPhamTheoM2)
                {
                    @if (ctx.IsM2 || ctx.IsMD)
                    {
                        <MudTd DataLabel="TongChieuDai"><div class="cell-data" Style="text-align:right;color:black">@ctx.TongChieuDai.ToString("###,##0.##")</div></MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="TongChieuDai" Class="@cssReadOnly"><div class="cell-data @cssReadOnly" Style="text-align:right;color:black">@ctx.TongChieuDai.ToString("###,###.##")</div></MudTd>
                    }
                    @if (ctx.IsM2)
                    {
                        <MudTd DataLabel="KhoRongTon"><div class="cell-data" Style="text-align:right;color:black">@ctx.KhoRongTon.ToString("###,##0.##")</div></MudTd>
                        <MudTd DataLabel="TongDienTich"><div class="cell-data" Style="text-align:right;color:black">@ctx.TongDienTich.ToString("###,##0.##")</div></MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="KhoRongTon" Class="@cssReadOnly"><div class="cell-data @cssReadOnly" Style="text-align:right">@ctx.KhoRongTon.ToString("###,##0.##")</div></MudTd>
                        <MudTd DataLabel="TongDienTich" Class="@cssReadOnly"><div class="cell-data @cssReadOnly" Style="text-align:right">@ctx.TongDienTich.ToString("###,##0.##")</div></MudTd>
                    }
                }
                <MudTd DataLabel="DonGia"><div class="cell-data" Style="text-align:right">@ctx.DonGia.ToString("###,###")</div></MudTd>
                <MudTd DataLabel="SoTien" Class="@cssReadOnly"><div class="cell-data" Style="text-align:right;color:black">@ctx.SoTien.ToString("###,###")</div></MudTd>
                <MudTd DataLabel="DonGiaHoaHong"><div class="cell-data" Style="text-align:right">@ctx.DonGiaHoaHong.ToString("###,###")</div></MudTd>
                <MudTd DataLabel="SoTienHoaHong" Class="@cssReadOnly"><div class="cell-data" Style="text-align:right;color:black">@ctx.SoTienHoaHong.ToString("###,###")</div></MudTd>

                <MudTd DataLabel="GhiChu"><div class="cell-data">@ctx.GhiChu</div></MudTd>
                <MudTd><MudIconButton Disabled="@IsReadOnly" Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Variant="Variant.Text" Style="width:24px; height:24px" OnClick="@(() => DeleteRow(ctx))">> </MudIconButton></MudTd>
            </RowTemplate>
            <RowEditingTemplate Context="ctx1">
                <MudTd DataLabel="MaHangHoa">
                    <MudTextField @bind-Value="@ctx1.MaHangHoa" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"MaHangHoa"))"
                                  AutoFocus="@(IsMaHangHoaFocus)" Immediate="true" TextChanged="MaHangHoaTextChanged" OnInternalInputChanged="OnInternalInputChanged"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnAdornmentClick="@(() => OpenDialogHangHoa())" />
                </MudTd>
                <MudTd DataLabel="TenHangHoa">
                    <MudTextField @bind-Value="@ctx1.TenHangHoa" Immediate="true" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"TenHangHoa"))" />
                </MudTd>
                <MudTd DataLabel="DonViTinh">
                    <MudTextField @bind-Value="@ctx1.DonViTinh" Immediate="true" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"DonViTinh"))" />
                </MudTd>
                <MudTd DataLabel="SoLuongTon" Class="@(cssReadOnly)">
                    <MudTextField Disabled="true" @bind-Value="@ctx1.SoLuongTon" ReadOnly="true" />
                </MudTd>
                <MudTd DataLabel="SoLuong" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.SoLuong" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"SoLuong"))" AutoFocus="@IsSoLuongFocus" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"SoLuong"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="ChieuDai" Style="text-align:right" Class="@(ctx1.IsM2 || ctx1.IsMD ? "" : cssReadOnly)">
                    @if (ctx1.IsM2 || ctx1.IsMD)
                    {
                        <MudNumericField @bind-Value="@ctx1.ChieuDai" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"ChieuDai"))" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"ChieuDai"))" Immediate="true" />
                    }
                    else
                    {
                        <MudNumericField Disabled="true" ReadOnly="true" Style="background-color:#ededed" @bind-Value="@ctx1.ChieuDai" InvertMouseWheel="true" Format="###,##0.##" Culture="@_vi" HideSpinButtons="true" Immediate="true" />
                    }
                </MudTd>

                <MudTd DataLabel="TongChieuDai" Style="text-align:right;" Class="@(cssReadOnly)">
                    @if (ctx1.IsM2 || ctx1.IsMD)
                    {
                        <MudNumericField Disabled="true" Style="background-color:#ededed" @bind-Value="@ctx1.TongChieuDai" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" Immediate="true" Align="right" HideSpinButtons="true" ReadOnly="true" />
                    }
                    else
                    {
                        <MudNumericField Disabled="true" Style="background-color:#ededed" @bind-Value="@ctx1.TongChieuDai" InvertMouseWheel="true" Format="###,##0.##" Culture="@_vi" Immediate="true" Align="right" HideSpinButtons="true" ReadOnly="true" />
                    }
                </MudTd>
                <MudTd DataLabel="KhoRongTon" Style="text-align:right" Class="@(ctx1.IsM2 ? "" :cssReadOnly)">
                    @if (ctx1.IsM2)
                    {
                        <MudNumericField @bind-Value="@ctx1.KhoRongTon" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"KhoRongTon"))" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" TextChanged="@((value) => ChangeValueRow(value,"KhoRongTon"))" Immediate="true" />
                    }
                    else
                    {
                        <MudNumericField ReadOnly="true" Disabled="true" Style="background-color:#ededed" @bind-Value="@ctx1.KhoRongTon" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" HideSpinButtons="true" Immediate="true" />
                    }
                </MudTd>
                <MudTd DataLabel="TongDienTich" Style="text-align:right;" Class="@(cssReadOnly)">
                    @if (ctx1.IsM2)
                    {
                        <MudNumericField Style="background-color:#ededed" @bind-Value="@ctx1.TongDienTich" InvertMouseWheel="true" Format="###,###.##" Culture="@_vi" Immediate="true" HideSpinButtons="true" ReadOnly="true" />
                    }
                    else
                    {
                        <MudNumericField ReadOnly="true" Disabled="true" Style="background-color:#ededed" @bind-Value="@ctx1.TongDienTich" InvertMouseWheel="true" Format="###,##0.##" Culture="@_vi" Immediate="true" HideSpinButtons="true" />
                    }
                </MudTd>
                <MudTd DataLabel="DonGia" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.DonGia" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"DonGia"))" InvertMouseWheel="true" Format="###,###" Culture="@_vi" HideSpinButtons="true" TextChanged="@( (value) => ChangeValueRow(value,"DonGia"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="SoTien" Style="text-align:right;">
                    <MudNumericField @bind-Value="@ctx1.SoTien" InvertMouseWheel="true" Immediate="true" HideSpinButtons="true" Format="###,###" Culture="@_vi" T="double" />
                </MudTd>
                <MudTd DataLabel="DonGiaHoaHong" Style="text-align:right">
                    <MudNumericField @bind-Value="@ctx1.DonGiaHoaHong" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"DonGiaHoaHong"))" InvertMouseWheel="true" Format="###,###" Culture="@_vi" HideSpinButtons="true" TextChanged="@( (value) => ChangeValueRow(value,"DonGiaHoaHong"))" Immediate="true" />
                </MudTd>
                <MudTd DataLabel="SoTienHoaHong" Style="text-align:right;">
                    <MudNumericField @bind-Value="@ctx1.SoTienHoaHong" InvertMouseWheel="true" Immediate="true" HideSpinButtons="true" Format="###,###" Culture="@_vi" T="double" />
                </MudTd>
                <MudTd DataLabel="GhiChu">
                    <MudTextField @bind-Value="@ctx1.GhiChu" OnKeyDown="@( async (e) => await OnKeyDownGrid(e,ctx1.Index,"GhiChu"))" Immediate="true" />
                </MudTd>
                @*<MudTd><MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => DeleteRow(ctx1))"> </MudIconButton></MudTd>*@
            </RowEditingTemplate>
            <PagerContent>
                <MudPaper Square="true" Class="d-flex justify-space-around text-center">
                    <MudIconButton Icon="@Icons.Material.Filled.AddCircle" @onclick="@(e => AddRow())" Color="Color.Inherit" Title="Thêm dòng" />
                    <MudDivider Vertical="true" FlexItem="true" />
                    <div>
                        Số dư cộng nợ : <MudButton Color="Color.Success" OnClick="@(() => ShowCongNo())"> @SoDuCN.ToString("##0,###")</MudButton>
                        </div>
                        <MudDivider Vertical="true" FlexItem="true" />
