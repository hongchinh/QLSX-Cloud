    private async Task RegisterSocketClient()
    {
        string baseUrl = donDatHangService.GetBaseUrl().Replace("/api/", "");

        string hubUrl = baseUrl + "/" + SignalRKey.HubUrl;

        _hubConnection = new HubConnectionBuilder()
            .WithUrl(hubUrl)
            .Build();

        // Socket when create donHang
        _hubConnection.On<string>(SignalRKey.CreateDonHangSocketKey, (message) =>
        {
            // Fetch the new records and update dataList
            var newRecords = JsonSerializer.Deserialize<List<PhieuNhapXuatAllModel>>(message);
            var responseData = FilterSocketData(SignalRKey.CreateDonHangSocketKey, ref newRecords);
            if (newRecords.Any())
            {
                lsResponses = responseData;
                GetFooterContent(lsResponses);

                // Notify Blazor to re-render the component
                StateHasChanged();
            }
        });

        // Socket when update donHang
        _hubConnection.On<string>(SignalRKey.UpdateDonHangSocketKey, (message) =>
        {
            // Fetch the new records and update dataList
            var newRecords = JsonSerializer.Deserialize<List<PhieuNhapXuatAllModel>>(message);
            var responseData = FilterSocketData(SignalRKey.UpdateDonHangSocketKey, ref newRecords);
            if (newRecords.Any())
            {
                lsResponses = responseData;
                GetFooterContent(lsResponses);

                // Notify Blazor to re-render the component
                StateHasChanged();
            }
        });

        // Socket when delete donHang
        _hubConnection.On<string>(SignalRKey.DeleteDonHangSocketKey, (message) =>
        {
            // Fetch the new records and update dataList
            var newRecords = JsonSerializer.Deserialize<List<PhieuNhapXuatAllModel>>(message);
            var responseData = FilterSocketData(SignalRKey.DeleteDonHangSocketKey, ref newRecords);
            if (newRecords.Any())
            {
                lsResponses = responseData;
                GetFooterContent(lsResponses);

                // Notify Blazor to re-render the component
                StateHasChanged();
            }
        });

        // Socket when cancel donHang
        _hubConnection.On<string>(SignalRKey.HuyDonHangSocketKey, (message) =>
        {
            // Fetch the new records and update dataList
            var newRecords = JsonSerializer.Deserialize<List<PhieuNhapXuatAllModel>>(message);
            var responseData = FilterSocketData(SignalRKey.HuyDonHangSocketKey, ref newRecords);
            if (newRecords.Any())
            {
                lsResponses = responseData;
                GetFooterContent(lsResponses);

                // Notify Blazor to re-render the component
                StateHasChanged();
            }
        });

        try
        {
            await _hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            throw;
        }
    }

    private GetDonHangResponse<PhieuNhapXuatAllModel> FilterSocketData(string signalRKey, ref List<PhieuNhapXuatAllModel> donHangSocketList)
    {
        GetDonHangResponse<PhieuNhapXuatAllModel> responseData = lsResponses;
        var query = donHangSocketList.Where(item => item.NgayCT >= itemRequest.NgayCTFrom
                                                    && item.NgayCT <= itemRequest.NgayCTTo);

        if (itemRequest.TrangThaiDonHang >= 1 && itemRequest.TrangThaiDonHang <= 5)
        {
            query = query.Where(item => item.TrangThaiDetail == itemRequest.TrangThaiDonHang);
        }
        if (!string.IsNullOrEmpty(itemRequest.SoCT))
        {
            query = query.Where(item => item.SoChungTu.Contains(itemRequest.SoCT));
        }
        if (!string.IsNullOrEmpty(itemRequest.DienGiai))
        {
            query = query.Where(item => item.DienGiai.Contains(itemRequest.DienGiai));
        }
        if (!string.IsNullOrEmpty(itemRequest.MaDonVi))
        {
            query = query.Where(item => item.MaDoiTuong.Contains(itemRequest.MaDonVi));
        }
        if (!string.IsNullOrEmpty(itemRequest.TenDonVi))
        {
            query = query.Where(item => item.TenDoiTuong.Contains(itemRequest.TenDonVi));
        }
        if (!string.IsNullOrEmpty(itemRequest.DiaChi))
        {
            query = query.Where(item => item.DiaChiDoiTuong.Contains(itemRequest.DiaChi));
        }
        if (!string.IsNullOrEmpty(itemRequest.NguoiQL))
        {
            query = query.Where(item => item.TenQuanLy.Contains(itemRequest.NguoiQL));
        }
        if (itemRequest.ThoiGianGiaoHang != null)
        {
            string thoiGianGiaoHangString = (itemRequest.ThoiGianGiaoHang ?? DateTime.Now).ToString("dd/MM/yyyy");
            query = query.Where(item => item.ThoiGianGiao.Contains(thoiGianGiaoHangString));
        }
        if (!string.IsNullOrEmpty(itemRequest.DiaDiem))
        {
            query = query.Where(item => item.DiaDiem.Contains(itemRequest.DiaDiem));
        }
        if (!string.IsNullOrEmpty(itemRequest.MaHangHoa))
        {
            query = query.Where(item => item.MaHangHoa.Contains(itemRequest.MaHangHoa));
        }
        if (!string.IsNullOrEmpty(itemRequest.TenHangHoa))
        {
            query = query.Where(item => item.TenHangHoa.Contains(itemRequest.TenHangHoa));
        }
        if (!string.IsNullOrEmpty(itemRequest.SoPhieuLSX))
        {
            query = query.Where(item => item.SoPhieuLSX.Contains(itemRequest.SoPhieuLSX));
        }
        if (!string.IsNullOrEmpty(itemRequest.SoPhieuXK))
        {
            query = query.Where(item => item.SoPhieuXuat.Contains(itemRequest.SoPhieuXK));
        }
        if (!string.IsNullOrEmpty(itemRequest.NgayCT))
        {
            query = query.Where(item => item.NgayCTDisplay.StartsWith(itemRequest.NgayCT));
        }
        if (!string.IsNullOrEmpty(itemRequest.NgayLSX))
        {
            query = query.Where(item => item.NgayPhieuLSXDisplay.StartsWith(itemRequest.NgayLSX));
        }
        if (!string.IsNullOrEmpty(itemRequest.NgayXK))
        {
            query = query.Where(item => item.NgayXuatKhoDisplay.StartsWith(itemRequest.NgayXK));
        }

        donHangSocketList = query.ToList();
        if (donHangSocketList.Any())
        {
            string soChungTuSocket = donHangSocketList.First().SoChungTu;
            int maxStt = 0;
            if (lsResponses.Items.Any())
            {
                int.TryParse(lsResponses.Items.Max(item => item.Stt), out maxStt);
            }
            switch (signalRKey)
            {
                case SignalRKey.CreateDonHangSocketKey:
                    foreach (var item in donHangSocketList)
                    {
                        item.Stt = (maxStt + 1).ToString();
                        maxStt++;
                    }
                    responseData.Items.AddRange(donHangSocketList);
                    break;
                case SignalRKey.UpdateDonHangSocketKey:
                    List<int> donHangIdIdSocketUsedList = new();
                    foreach (var donHangSocket in donHangSocketList)
                    {
                        // If exist donHangSocket in data list, update item except Stt
                        // If not exist donHangSocket in data list, add donHangSocket to data list with new Stt
                        var donHangUpdate = responseData.Items.FirstOrDefault(item => item.SoChungTu == soChungTuSocket && item.IdId == donHangSocket.IdId);
                        if (donHangUpdate != null)
                        {
                            donHangSocket.Stt = donHangUpdate.Stt;
                            donHangUpdate.UpdateLastVersion(donHangSocket);
                        }
                        else
                        {
                            donHangSocket.Stt = (maxStt + 1).ToString();
                            maxStt++;
                            responseData.Items.Add(donHangSocket);
                        }
                        donHangIdIdSocketUsedList.Add(donHangSocket.IdId);
                    }
                    // If item in dataList has soChungTu equal soChungTuSocket and does not exist in donHangSocketList, remove this item
                    var donHangDeleteList = responseData.Items.Where(item => item.SoChungTu == soChungTuSocket && !donHangIdIdSocketUsedList.Contains(item.IdId)).Distinct().ToList();
                    foreach (var removeItem in donHangDeleteList)
                    {
                        responseData.Items.Remove(removeItem);
                    }
                    break;
                case SignalRKey.DeleteDonHangSocketKey:
                    var donHangIdIdSocketDeletedList = donHangSocketList.Select(item => item.IdId).Distinct().ToList();
                    donHangDeleteList = responseData.Items.Where(item => item.SoChungTu == soChungTuSocket && donHangIdIdSocketDeletedList.Contains(item.IdId)).Distinct().ToList();
                    foreach (var removeItem in donHangDeleteList)
                    {
                        responseData.Items.Remove(removeItem);
                    }
                    break;
                case SignalRKey.HuyDonHangSocketKey:
                    foreach (var donHangSocket in donHangSocketList)
                    {
                        // If exist donHangSocket in data list, update item except Stt
                        var donHangUpdate = responseData.Items.FirstOrDefault(item => item.IdId == donHangSocket.IdId);
                        if (donHangUpdate != null)
                        {
                            donHangSocket.Stt = donHangUpdate.Stt;
                            donHangUpdate.UpdateLastVersion(donHangSocket);
                        }
                    }
                    break;
                default:
                    return responseData;
            }

            responseData.TotalRows = responseData.Items.Count;
            responseData.TotalM2 = responseData.Items.Sum(item => item.TongDienTich) ?? 0;
            responseData.TotalSoTien = responseData.Items.Sum(item => item.SoTien) ?? 0;
            responseData.TotalMd = responseData.Items.Sum(item => item.TongChieuDai) ?? 0;
        }
        return responseData;
    }

