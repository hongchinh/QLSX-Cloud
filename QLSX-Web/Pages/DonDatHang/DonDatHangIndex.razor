@page "/dondathangs"
@using Microsoft.AspNetCore.SignalR.Client
@using Newtonsoft.Json.Linq
@using QLSX.Shared.Constants
@using QLSX.Shared.Models
@using QLSX.Shared.Models.Request
@using QLSX.Web.Data
@using QLSX.Web.Pages.DonDatHang
@using QLSX.Web.Services
@using Blazored.LocalStorage
@using OfficeOpenXml
@using OfficeOpenXml.Style
@using Microsoft.Extensions.Configuration;
@using AutoMapper
@using System.Text.Json

@inject IDonDatHangsService<PhieuNhapXuatAllModel> donDatHangService
@inject IUserService userService
@inject IDMTinhTrangService<QLSX.Shared.Models.DMTinhTrangModel> dmTinhTrangService
@inject IDMKhoHangService<DanhMucKhoHangModel> dmkhohangService
@inject IDMLoaiTienService<DanhMucLoaiTienModel> dmLoaiTienService
@inject IMapper mapper;

@inject NavigationManager navigationManager
@inject ILocalStorageService localStorageService
@inject AppService AppService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [Authorize]
@inherits QLSX.Web.Helpers.BlazorComponent
@inject IDialogService DialogService
@inject IToastService toastService
@inject IPhanQuyenSuDungService< QLSX.Shared.Models.QuyenSuDungModel> permisstionService
@inject ISnackbar Snackbar
@inject IConfiguration configuration
@inject ISettingService<QLSX.Shared.Models.SettingModel> itemService
@inject Blazored.LocalStorage.ILocalStorageService localStorageService


@namespace QLSX.Web.Pages.DonDatHangPage
<style>
    .mud-main-content {
        padding-top: 45px;
    }

    .mud-breadcrumbs {
        padding: 0;
    }

    .mud-grid-spacing-xs-1 > .mud-grid-item {
        padding: 3px;
    }

    .mud-input-label-outlined {
        padding: 0 !important;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-margin-dense, div.mud-input-slot.mud-input-root-outlined.mud-input-root-margin-dense {
        padding-top: 8px;
        padding-bottom: 8px;
    }

    .mud-input-control > .mud-input-control-input-container > .mud-input-label-outlined.mud-input-label-inputcontrol {
        line-height: 10px;
    }

    .mud-table-root {
        width: max-content;
    }

    .mud-table-cell {
        padding: 3px;
    }

    .mud-table-sticky-header * .mud-table-root .mud-table-head * .mud-table-cell {
        top: -1px;
    }

    .mud-table-foot {
        position: sticky;
        bottom: -3px;
        background: #f2f2f2;
        color: blue;
        z-index: 1;
    }

    .footerContent {
        text-align: center;
        padding: 0;
        background: black;
        color: white;
        font-weight: bold;
    }

        .footerContent > label {
            margin: 0;
        }

    .pb-1 {
        padding-bottom: 5px !important;
    }

    .form-check {
        border: 1px solid #BDBDBD;
        border-radius: 5px;
    }

    .mud-input > input.mud-input-root-outlined, div.mud-input-slot.mud-input-root-outlined {
        padding: 0px 2px;
    }

    .mud-input.mud-input-outlined .mud-input-outlined-border {
        border-radius: 0px;
    }

    .mud-input > input.mud-input-root-outlined.mud-input-root-adorned-end, div.mud-input-slot.mud-input-root-outlined.mud-input-root-adorned-end {
        padding-inline-start: 2px;
    }

    .mud-input-adornment-end {
        margin-inline-start: -15px;
    }

    .mud-icon-button-edge-end {
        margin-inline-end: -25px;
    }

    .mud-grid-spacing-xs-2 {
        width: calc(100% + 0px);
        margin: 0px;
    }

        .mud-grid-spacing-xs-2 > .mud-grid-item {
            padding: 0px;
        }

    .mud-input-label-inputcontrol {
        top: 0;
        left: -10px;
    }

    .mud-table-dense * .mud-table-row .mud-table-cell {
        padding: 0px;
        padding-inline-start: 2px;
        padding-inline-end: 2px;
    }

    .mud-input.mud-input-outlined.mud-input-adorned-end {
        padding-inline-end: 6px;
    }

    .mud-icon-button {
        padding: 0;
    }

    .mud-list-item {
        padding-bottom: 0;
        padding-top: 0;
    }

    .mud-table-cell .mud-checkbox {
        margin: 0px;
    }

    #idToolbar {
        padding-left: 0;
    }

    .mud-button {
        padding: 2px;
    }

    .mud-table-dense * .mud-table-row .mud-table-cell:last-child {
        padding-inline-end: 3px;
    }
</style>

<div class="form-group">
    <MudBreadcrumbs Items="_items"></MudBreadcrumbs>

    <MudToolBar id="idToolbar">
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" @onclick="@(async() => await CreateDonHangClick())" StartIcon="@Icons.Material.Filled.AddShoppingCart" Color="Color.Secondary">Tạo đơn hàng</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" StartIcon="@Icons.Material.Filled.LocalPrintshop" Color="Color.Primary" @onclick="OpenDialogAsync">In LSX</MudButton>
        <MudButton Disabled="printPXKDisableStatus" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" @onclick="@(() => OpenPrintPXKForm())" StartIcon="@Icons.Material.Filled.LocalPrintshop" Color="Color.Primary">In phiếu XK</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" StartIcon="@Icons.Material.Outlined.RunCircle" Color="Color.Primary">Nhận PXK liên 2</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" StartIcon="@Icons.Material.Outlined.CancelPresentation" Color="Color.Error" OnClick="CancelClick">Hủy đơn</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2" @onclick="@(() => OpenDonHangTraNoForm())" StartIcon="@Icons.Material.Outlined.FireTruck" Color="Color.Primary">Tạo đơn trả nợ</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2" StartIcon="@Icons.Material.Filled.Checklist" Color="Color.Primary">Tổng hợp số lượng panel</MudButton>
        <MudButton Disabled="@(!quyenSuDungXuat.Them)" Size="Size.Small" Variant="Variant.Outlined" Class="ml-1" StartIcon="@Icons.Material.Filled.FormatListBulleted" Color="Color.Primary">Danh sách phụ kiện</MudButton>
    </MudToolBar>

    <EditForm Model="@itemRequest">
        <MudGrid Spacing="1">
            <MudItem xs="12">
                <MudInputLabel Class="mb-0">Trạng thái đơn hàng: </MudInputLabel>
                <div class="form-check form-check-inline p-1 mb-2">
                    <InputRadioGroup Name="TrangThaiDonHang" @bind-Value="SelectedTrangThaiDonHang">
                        <div class="pt-1 pb-1 pl-1" style="background-color: #ffffff"><InputRadio id="trangThaiDonHang0" Name="TrangThaiDonHang" Value="@(0)" /></div><div style="background-color: #ffffff; color: #000000"><MudInputLabel ForId="trangThaiDonHang0" class="pt-1 px-1">Tất cả</MudInputLabel></div>
                        <div class="pt-1 pb-1 pl-1" style="background-color: #90EE90"><InputRadio id="trangThaiDonHang1" Name="TrangThaiDonHang" Value="@(1)" /></div><div style="background-color: #90EE90; color: #000000"><MudInputLabel ForId="trangThaiDonHang1" class="pt-1 px-1">Đã tạo đơn</MudInputLabel></div>
                        <div class="pt-1 pb-1 pl-1" style="background-color: #FFA500"><InputRadio id="trangThaiDonHang2" Name="TrangThaiDonHang" Value="@(2)" /></div><div style="background-color: #FFA500; color: #000000"><MudInputLabel ForId="trangThaiDonHang2" class="pt-1 px-1">Đã in LSX</MudInputLabel></div>
                        <div class="pt-1 pb-1 pl-1" style="background-color: #008000"><InputRadio id="trangThaiDonHang3" Name="TrangThaiDonHang" Value="@(3)" /></div><div style="background-color: #008000; color: #000000"><MudInputLabel ForId="trangThaiDonHang3" class="pt-1 px-1">Đã in phiếu XK</MudInputLabel></div>
                        <div class="pt-1 pb-1 pl-1" style="background-color: #800080"><InputRadio id="trangThaiDonHang4" Name="TrangThaiDonHang" Value="@(4)" /></div><div style="background-color: #800080; color: #ffffff"><MudInputLabel ForId="trangThaiDonHang4" class="pt-1 px-1">Đã nhận phiếu XK</MudInputLabel></div>
                        <div class="pt-1 pb-1 pl-1" style="background-color: #FF0000"><InputRadio id="trangThaiDonHang5" Name="TrangThaiDonHang" Value="@(5)" /></div><div style="background-color: #FF0000; color: #000000"><MudInputLabel ForId="trangThaiDonHang5" class="pt-1 px-1">Đã hủy</MudInputLabel></div>
                    </InputRadioGroup>
                </div>
            </MudItem>
        </MudGrid>
    </EditForm>

    <div class="form-group">
        <MudDataGrid T="PhieuNhapXuatAllModel"
                     Items="@dataList"
                     SortMode="SortMode.Multiple"
                     Filterable="true"
                     Virtualize="true"
                     FixedHeader="true"
                     DragDropColumnReordering="true"
                     ApplyDropClassesOnDragStarted="true"
                     DragIndicatorIcon="@Icons.Material.Filled.DragIndicator"
                     Dense
                     MultiSelection="true"
                     Hover="true"
                     Height="@(HeightGrid == 0 ? "": HeightGrid.ToString () + "px" )"
                     @bind-SelectedItems="selectedItems"
                     SelectedItemChanged="SetEnableButton">

            <Columns>
                <SelectColumn T="PhieuNhapXuatAllModel" ShowInFooter="false" />
                <PropertyColumn Property="x => x.Stt" DragAndDropEnabled="false" Groupable="false" Sortable="false" Filterable="false" Title="STT" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.NgayCTDisplay" Title="Ngày CT" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.SoChungTu" Title="Số ĐH" CellStyleFunc="@_cellStyleFunc">
                    <CellTemplate>
                        <MudButton Disabled="@(!quyenSuDungNhap.Sua)" Color="Color.Primary" Size="Size.Small" OnClick="@(async ()=> await SuaClick(context.Item .Loai, context.Item .Id))">@context.Item.SoChungTu</MudButton>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TrangThaiChiTietDisplay" Title="Trạng thái chi tiết" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.TenDoiTuong" Title="Tên đơn vị" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.DiaDiem" Title="Địa điểm giao hàng" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.DienGiai" Title="Diễn giải" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.LoaiTon" Title="Loại hàng" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.TenHangHoa" Title="Tên hàng hóa" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.KhoRongTon" Title="Khổ rộng tôn" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.ChieuDai" Title="Chiều dài" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.SoLuong" Title="Số lượng" CellStyleFunc="@_cellStyleFunc" AggregateDefinition="_soLuongAggregation" />
                <PropertyColumn Property="x => x.TongChieuDai" Title="Tổng md" CellStyleFunc="@_cellStyleFunc" AggregateDefinition="_tongChieuDaiAggregation" />
                <PropertyColumn Property="x => x.TongDienTich" Title="Tổng m2" CellStyleFunc="@_cellStyleFunc" AggregateDefinition="_tongDienTichAggregation" />
                <PropertyColumn Property="x => x.DonGia" Title="Đơn giá" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.SoTien" Title="Số tiền" CellStyleFunc="@_cellStyleFunc" AggregateDefinition="_tongSoTienAggregation">
                    <CellTemplate>
                        <MudText>@context.Item.SoTien?.ToString("###,###")</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.GhiChu" Title="Ghi chú" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.TenQuanLy" Title="Nhân viên" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.TenTinh" Title="Khu vực" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.ChungLoai" Title="Chủng loại" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.KieuSong" Title="Bề mặt" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.MauSac" Title="Màu sắc" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.DoDay" Title="Độ dày" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.SoPhieuLSX" Title="Số phiếu LSX" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.NgayPhieuLSXDisplay" Title="Ngày LSX" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.NgayXuatKhoDisplay" Title="Ngày XK" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.SoPhieuXuat" Title="Số PXK" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.NgayXacNhan" Title="Ngày XN" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.NgayHuy" Title="Ngày hủy" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.TrangThaiDonHangDisplay" Title="Trạng thái đơn hàng" CellStyleFunc="@_cellStyleFunc" />
                <PropertyColumn Property="x => x.CreatedDate" Title="Thời gian tạo" CellStyleFunc="@_cellStyleFunc" />

                <TemplateColumn StickyRight="true" Filterable="false" Sortable="false" DragAndDropEnabled="false">
                    <CellTemplate>
                        <MudMenu Icon="@Icons.Material.Filled.MoreHoriz">
                            <MudMenuItem Disabled>Chuyển status về trước</MudMenuItem>
                            <MudMenuItem>Sửa lại thông tin PXK</MudMenuItem>
                            <MudMenuItem Disabled>In lại phiếu xuất kho</MudMenuItem>
                            <MudMenuItem Disabled>In lại lệnh SX</MudMenuItem>
                            <MudMenuItem>In phiếu xuất kho Excel</MudMenuItem>
                            <MudMenuItem>In lại tem xuất xưởng</MudMenuItem>
                            <MudMenuItem>Ghép đơn hàng vào PXK</MudMenuItem>
                        </MudMenu>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </div>

    <EditForm id="idForm" Model="@itemRequest">
        <MudPaper Elevation="25">
            <MudGrid Spacing="2">
                <MudItem Class="styleFilter ml-1" Style="width: 60px">
                    <MudTextField @bind-Value="itemRequest.SoCT" Label="Số CT" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 70px">
                    <MudTextField @bind-Value="itemRequest.NgayCT" Label="Ngày CT" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 120px">
                    <MudTextField @bind-Value="itemRequest.DienGiai" Label="Diễn giải" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 70px">
                    <MudTextField @bind-Value="itemRequest.MaDonVi" Label="Mã đơn vị" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 80px">
                    <MudTextField @bind-Value="itemRequest.TenDonVi" Label="Tên đơn vị" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 80px">
                    <MudTextField @bind-Value="itemRequest.DiaChi" Label="Địa chỉ" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 80px">
                    <MudTextField @bind-Value="itemRequest.NguoiQL" Label="Người QL" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 25px">
                    <MudTextField @bind-Value="itemRequest.NguoiQL" Label="" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 140px">
                    <MudDatePicker Margin="Margin.Dense" Label="Thời gian giao hàng" @bind-Date="@itemRequest.ThoiGianGiaoHang" Variant="Variant.Outlined" Editable="false" DateFormat="dd/MM/yyyy" PickerClosed="@SearchAction"></MudDatePicker>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 90px">
                    <MudTextField @bind-Value="itemRequest.DiaDiem" Label="Địa điểm" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="2" Class="mt-2">
                <MudItem Class="styleFilter ml-1" Style="width: 85px">
                    <MudTextField @bind-Value="itemRequest.MaHangHoa" Label="Mã hàng hóa" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 95px">
                    <MudTextField @bind-Value="itemRequest.TenHangHoa" Label="Tên hàng hóa" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter ml-1" Style="width: 85px">
                    <MudDatePicker Margin="Margin.Dense" Label="Từ ngày" @bind-Date="@itemRequest.NgayCTFrom" Variant="Variant.Outlined" Editable="false" DateFormat="dd/MM/yyyy" PickerClosed="@SearchAction"></MudDatePicker>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 85px">
                    <MudDatePicker Margin="Margin.Dense" Label="Đến ngày" @bind-Date="@itemRequest.NgayCTTo" Variant="Variant.Outlined" Editable="false" DateFormat="dd/MM/yyyy" PickerClosed="@SearchAction"></MudDatePicker>
                </MudItem>
                <MudItem Class="styleFilter " Style="width: 75px">
                    <MudTextField @bind-Value="itemRequest.NgayLSX" Label="Ngày LSX" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 75px">
                    <MudTextField @bind-Value="itemRequest.SoPhieuLSX" Label="Số phiếu" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>

                <MudItem Class="styleFilter ml-1" Style="width: 75px">
                    <MudTextField @bind-Value="itemRequest.NgayXK" Label="Ngày XK" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
                <MudItem Class="styleFilter" Style="width: 80px">
                    <MudTextField @bind-Value="itemRequest.SoPhieuXK" Label="Số phiếu XK" Margin="Margin.Dense" Variant="Variant.Outlined" OnBlur="@SearchAction" OnKeyUp="@KeyUpAction"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>

    <div class="footerContent">
        <label>@_footerContent</label>
    </div>

</div>

<LoadingProgress IsLoading="isLoading"></LoadingProgress>

@code {

    private async Task OpenDialogAsync()
    {
        List<int> ListIdId = selectedItems.Select(item => item.IdId).ToList();
        if (ListIdId.Any())
        {
            var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };
            var parameters = new DialogParameters();
            parameters.Add("ListIdId", ListIdId);
            var result = DialogService.Show<PrintLsx>("In LSX", parameters, options);
            await result.Result;
        }
        else
        {
            Snackbar.Clear();
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
            string msg = $"Bạn chưa chọn dữ liệu";
            Snackbar.Add(msg, Severity.Warning);
        }


    }

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungNhap { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungXuat { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };


    public DonDatHangModel nhapxuat { get; set; }
    public GetDonHangResponse<PhieuNhapXuatAllModel> lsResponses { get; set; }
    public DonHangRequest itemRequest { get; set; }
    public bool IsVisible { get; set; }
    public bool IsGridViewFiltered { get; set; }
    bool isLoading = true;
    public UserModel UserLogin;
    public List<DanhMucKhoHangModel> lstKhoHang { get; set; }
    public List<DanhMucLoaiTienModel> lstLoaiTien { get; set; }
    private HashSet<PhieuNhapXuatAllModel> selectedItems = new();
    private IEnumerable<PhieuNhapXuatAllModel> dataList = new List<PhieuNhapXuatAllModel>();
    private string _footerContent;
    private HubConnection _hubConnection;
    private bool printPXKDisableStatus = true;
    private string idid = string.Empty;

    public int selecttedKhohang { get; set; }
    public int selecttedLoaiTien { get; set; }
    public string selecttedLoai { get; set; }

    private MudDataGrid<PhieuNhapXuatAllModel> table;

    public string hostReport { get; set; }
    public int HeightGrid { get; set; } = 277;

    public QLSX.Shared.Models.SettingModel itemSetting { get; set; } = new QLSX.Shared.Models.SettingModel { LoaiNhapXuat = 1 };
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Tra cứu đơn hàng",href: null, disabled: true)
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void SetEnableButton()
    {
        var maDonVi = selectedItems.Select(item => item.MaDoiTuong).Distinct().ToList();
        var trangThaiDetail = selectedItems.Select(item => item.TrangThaiDetail).Distinct().ToList();
        printPXKDisableStatus = !(maDonVi.Count == 1 && trangThaiDetail.Count == 1 && trangThaiDetail.First() == 2);
    }

    private async Task OpenPrintPXKForm()
    {
        SetEnableButton();
        if (printPXKDisableStatus)
        {
            return;
        }
        var maDonVi = selectedItems.Select(item => item.MaDoiTuong).First();
        var tenDonVi = selectedItems.Select(item => item.TenDoiTuong).First();
        var idIdList = selectedItems.Select(item => item.IdId).Distinct().ToList();

        double soTienHang = selectedItems.Sum(item => item.SoTien) ?? 0;
        var getSoChungTuDonHangResult = await donDatHangService.GetSoChungTuDonHangAsync(new GetSoChungTuDonHangRequest()
            {
                IdIdList = idIdList,
                HoTen = await localStorageService.GetItemAsync<string>("hoTen"),
                SoTien = soTienHang,
                NgayCT = DateTime.Now
            });
        JObject jObject = JObject.Parse(getSoChungTuDonHangResult);
        string soCt = jObject["SOCT"].ToString();
        string idid = jObject["IDID"].ToString();
        var parameters = new DialogParameters();
        PrintPXKModel printPXKModel = new PrintPXKModel
            {
                MaDonVi = maDonVi,
                TenDonVi = tenDonVi,
                SoPhieuXuat = soCt,
                Ngay = DateTime.Now,
                SoTienHang = soTienHang,
                GhiChu = string.Empty,
                IdIdList = idIdList
            };
        CalculateTime(printPXKModel);
        parameters.Add("PrintPXKModel", printPXKModel);

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small };
        var dialog = DialogService.Show<PrintPXKDialog>("Thông tin phiếu xuất kho", parameters, options);
        var result = await dialog.Result;

        if (result.Cancelled)
        {
            // Logic when cancel donHang
            await donDatHangService.CancelPXKAsync(new CancelPXKRequest()
                {
                    SoCt = soCt
                });
            return;
        }
        selectedItems.Clear();
    }

    private void CalculateTime(PrintPXKModel printPXKModel)
    {
        if (printPXKModel.Ngay?.Date == DateTime.Today)
        {
            printPXKModel.ThoiGian = DateTime.Now.TimeOfDay;
        }
        else if (printPXKModel.Ngay?.Date > DateTime.Today)
        {
            var numberOfOrders = GetNumberOfOrdersOnDate(printPXKModel.Ngay);
            printPXKModel.ThoiGian = new TimeSpan(1, numberOfOrders, 0);
        }
    }

