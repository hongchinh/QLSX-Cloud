@inject ILogger<Delete> Logger
@inject IJSRuntime JSRuntime
@inject IDMNhomKhachHangService<DanhMucNhomKhachHangModel> itemService
@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.DMNhomKhachHangPage
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1" />
            Xóa
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="1">
            <MudItem xs="6" sm="3">
                <MudTextField Margin="Margin.Dense" Value="@server.Id.ToString()" Label="Id" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudTextField Margin="Margin.Dense" Value="@server.MaNhom" Label="Mã nhóm" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="6" sm="6">
                <MudTextField Margin="Margin.Dense" Value="@server.TenNhom" Label="Tên nhóm" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error" >Bỏ qua</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => DeleteClick(server.Id))" Class="me-3">Xóa</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public DanhMucNhomKhachHangModel server { get; set; } = new DanhMucNhomKhachHangModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async Task DeleteClick(int id)
    {
        var isdelete = await itemService.DeleteAsync(id);
        MudDialog.Close(DialogResult.Ok(isdelete));
    }
 }