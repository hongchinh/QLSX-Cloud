    private IEnumerable<QLSX.Shared.Models.BaoCao> pagedData;
    private MudTable<QLSX.Shared.Models.BaoCao> table;
    private int totalItems;

    public int pbUserId { get; set; }


    public string UrlReport { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        baocao = new QLSX.Shared.Models.BaoCao();
        baocaoList = new List<QLSX.Shared.Models.BaoCao>();

        itemRequest = new QLSX.Shared.Models.BaoCaoRequest()
            {
                TuNgay = DateTime.Now,
                DenNgay = DateTime.Now,
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 10,
                Page = 0,
                TotalPages = 0
            };
        hostReport = Configuration.GetValue<string>("AppSettings:ReportUrl");
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            await baocaoService.ClearDataInAsync();
            isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
    }

    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReloadThuChi(TableState state)
    {
        return await ServerReload(state, "THUCHI");
    }
    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReloadTonKho(TableState state)
    {
        return await ServerReload(state, "KHO");
    }
    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReloadCongNo(TableState state)
    {
        return await ServerReload(state, "CONGNO");
    }
    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReloadDoanhThu(TableState state)
    {
        return await ServerReload(state, "DOANHTHU");
    }
    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReloadQuanTri(TableState state)
    {
        return await ServerReload(state, "QUANTRI");
    }
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<QLSX.Shared.Models.BaoCao>> ServerReload(TableState state, string loai)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.Loai = loai;
        itemRequest.PageSize = state.PageSize;
        IEnumerable<QLSX.Shared.Models.BaoCao> data = new List<QLSX.Shared.Models.BaoCao>();
        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        pbUserId = int.Parse(UserId);
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(pbUserId, "BaoCao");
        if (quyenSuDung.Selectted)
        {
            data = await baocaoService.GetAllAsync(itemRequest);
        }
        totalItems = data.Count();
        if (data == null)
        {
            data = new List<BaoCao>();
        }

        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<QLSX.Shared.Models.BaoCao>() { TotalItems = totalItems, Items = pagedData };
    }


    private async Task PrintClick()
    {
        UrlReport = await baocaoService.GetPathReportAsync(itemRequest);
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("openfile", null);

    }
