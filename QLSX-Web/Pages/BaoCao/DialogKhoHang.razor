@using System.Net
@using System.Text
@using QLSX.Web.Helpers
@using QLSX.Shared.Models;
@using System.Net.Http.Json
@inject ILogger<DialogKhoHang> Logger
@inject IJSRuntime jsRuntime
@inject IDMKhoHangService<DanhMucKhoHangModel> khohangServicece
@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.BaoCaoPage
<MudDialog DisableSidePadding="true">
    <DialogContent>
        <MudContainer Style="overflow-y: scroll">
            <MudTable ServerData="@(new Func<TableState, Task<TableData<DanhMucKhoHangModel>>>(ServerReload))"
                      FixedHeader="true" Height="350px"
                      Dense="true" Hover="true" Bordered="true"
                      Striped="true" Loading="@Loading"
                      @ref="table"
                      @bind-SelectedItems="selectedItems"
                      MultiSelection="true"
                      T="DanhMucKhoHangModel">
                <ToolBarContent>

                    <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Tìm kiếm" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Mã kho</MudTh>
                    <MudTh>Tên kho</MudTh>
                    <MudTh>Địa chỉ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="MaKho">
                        @context.MaKho
                    </MudTd>
                    <MudTd DataLabel="TenKho">
                        @context.TenKho
                    </MudTd>
                    <MudTd DataLabel="DiaChi">
                        @context.DiaChi
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Không có bản ghi nào tìm thấy</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Đang tải dữ liệu...</MudText>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Ok">Chọn</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancel">Bỏ qua</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    public GetAllResponsePaged<DanhMucKhoHangModel> lsResponses { get; set; }

    private string searchString1 = "";

    public BaseSearchRequest itemRequest { get; set; } =
      new BaseSearchRequest
          {
              Keywords = "",
              Page = 0,
              PageSize = 10,
              TotalPages = 0
          };
    private HashSet<DanhMucKhoHangModel> selectedItems = new HashSet<DanhMucKhoHangModel>();
    private IEnumerable<DanhMucKhoHangModel> pagedData;
    private MudTable<DanhMucKhoHangModel> table;
    private int totalItems;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private string searchString { get; set; } = "";
    private bool Loading { get; set; } = false;
    private List<string> clickedEvents = new();
    void Cancel() => MudDialog.Cancel();

    private async Task Ok()
    {

        var result = await khohangServicece.UpdateListPrintAsync(selectedItems.Select(x => x.Id).ToList());
        MudDialog.Close(DialogResult.Ok<bool>(result));
    }

    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<DanhMucKhoHangModel>> ServerReload(TableState state)
    {
        Loading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        if (!string.IsNullOrEmpty(searchString))
        {
            itemRequest.Keywords = searchString;
        }
        else
        {
            itemRequest.Keywords = "";
        }
        lsResponses = new GetAllResponsePaged<DanhMucKhoHangModel>();
        lsResponses = await khohangServicece.GetAllPagedAsync(itemRequest);
        IEnumerable<DanhMucKhoHangModel> data = lsResponses.Items; ;
        totalItems = lsResponses.TotalRecords;
        if (data == null)
        {
            data = new List<DanhMucKhoHangModel>();
        }
        pagedData = data;
        Loading = false;
        return new TableData<DanhMucKhoHangModel>() { TotalItems = totalItems, Items = pagedData };
    }


    private async Task OnSearch(string text)
    {
        searchString = text;
        table.ReloadServerData();
    }

}