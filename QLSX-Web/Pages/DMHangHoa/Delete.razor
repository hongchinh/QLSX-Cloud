@inject ILogger<Delete> Logger
@inject IJSRuntime JSRuntime
@inject IDMHangHoaService<DanhMucHangHoaModel> hanghoaService

@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.DMHangHoaPage


<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1" />
            Xóa
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="1">
            <MudItem xs="12" sm="3">
                <MudTextField Margin="Margin.Dense" Value="@server.Id.ToString()" Label="Id" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField  Value="@server.MaHangHoa" Margin="Margin.Dense" Label="Mã hàng hóa" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6" Class="m-0 p-0"></MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField   Value="@server.TenHangHoa" Margin="Margin.Dense" Label="Tên hàng hóa" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudTextField   Value="@server.DonViTinh"  Margin="Margin.Dense" Label="ĐVT" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField   Value="@server.TenNhomHang" Margin="Margin.Dense" Label="Tên nhóm" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField  Value="@server.ChungLoai" Margin="Margin.Dense" Label="Chủng loại" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField   Value="@server.DoDay" Margin="Margin.Dense" Label="Độ dày" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField  Value="@server.MauSac" Margin="Margin.Dense" Label="Màu sắc" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField Value="@server.LoaiTon" Margin="Margin.Dense" Label="Loại tôn" ReadOnly="true" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error" >Bỏ qua</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.DeleteForever" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => DeleteClick(server.Id))" Class="me-3">Xóa</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public DanhMucHangHoaModel server { get; set; } = new DanhMucHangHoaModel();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }
    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async Task DeleteClick(int id)
    {
        var isdelete = await hanghoaService.DeleteAsync(id);
        MudDialog.Close(DialogResult.Ok(isdelete));
    }
 }
