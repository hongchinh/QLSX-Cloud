@page "/DMHangHoa"
@using QLSX.Shared.Models
@using QLSX.Web.Data
@using QLSX.Web.Services
@using QLSX.Shared.Interfaces
@using Blazored.LocalStorage
@using OfficeOpenXml
@using OfficeOpenXml.Style

@inject IDMHangHoaService<DanhMucHangHoaModel> hanghoaService
@inject IUserService userService

@inject IDMNhomHangService<DanhMucNhomHangModel> nhomhangService
@inject IDMChungLoaiService<DanhMucChungLoaiModel> chungloaiService
@inject IDMDoDayService<DanhMucDoDayModel> dodayService
@inject IDMKieuSongService<DanhMucKieuSongModel> kieusongService
@inject IDMLoaiTonService<DanhMucLoaiTonModel> loaitonService
@inject IDMMauSacService<DanhMucMauSacModel> mausacService
@inject IApiWrapperServices _apiServices;

@inject NavigationManager NavigationManager
@inject ILocalStorageService localStorageService
@inject IJSRuntime JSRuntime
@inject AppService AppService
@implements IDisposable
@attribute [Authorize]
@inherits QLSX.Web.Helpers.BlazorComponent
@inject NavigationManager NavigationManager
@inject IToastService toastService
@inject IDialogService DialogService
@inject IPhanQuyenSuDungService< QLSX.Shared.Models.QuyenSuDungModel> permisstionService


@namespace QLSX.Web.Pages.DMHangHoaPage
<style>
    .mud-table-cell {
        padding: 5px !important;
    }
</style>
<div class="col-12">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <div class="row">
        <div class="col-12 pr-45">
            <div class="area-search py-3 px-3">
                <EditForm Model="@itemRequest" OnValidSubmit="@SearchClick">
                    <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
                        <MudGrid Spacing="1">
                            <MudItem xs="12" sm="3" lg="2">
                                <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.MaHangHoa" Label="Mã hàng hóa" Variant="Variant.Outlined"></MudTextField>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="4">
                                <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.TenHangHoa" Label="Tên hàng hóa" Variant="Variant.Outlined"></MudTextField>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudTextField Margin="Margin.Dense" @bind-Value="itemRequest.DonViTinh" Label="Đơn vị tính" Variant="Variant.Outlined"></MudTextField>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="string" Margin="Margin.Dense" Label="Nhóm hàng hóa" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaNhom" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("")"> Tất cả</MudSelectItem>
                                    @if (lstNhomHang != null)
                                    {
                                        @foreach (var cnt in lstNhomHang)
                                        {
                                            <MudSelectItem T="string" Value="@(cnt.MaNhom)"> @cnt.TenNhom </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="0" sm="0" lg="2" Class="m-0 p-0" Style="text-align: right">
                                <MudMenu Icon="@Icons.Material.Filled.Settings" Color="Color.Primary">
                                    <MudMenuItem Href="/import/dmhanghoas">Import Data</MudMenuItem>
                                </MudMenu>
                            </MudItem>

                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="string" Margin="Margin.Dense" Label="Màu sắc" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaMauSac" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("")"> Tất cả</MudSelectItem>
                                    @if (lstMauSac != null)
                                    {
                                        @foreach (var cnt in lstMauSac)
                                        {
                                            <MudSelectItem T="string" Value="@(cnt.MaSo)"> @cnt.ChiTieu </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="string" Margin="Margin.Dense" Label="Độ dày" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaDoDay" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("")"> Tất cả</MudSelectItem>
                                    @if (lstDoDay != null)
                                    {
                                        @foreach (var cnt in lstDoDay)
                                        {
                                            <MudSelectItem T="string" Value="@(cnt.MaSo)"> @cnt.ChiTieu </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="string" Margin="Margin.Dense" Label="Chủng loại" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaChungLoai" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("")"> Tất cả</MudSelectItem>
                                    @if (lstChungLoai != null)
                                    {
                                        @foreach (var cnt in lstChungLoai)
                                        {
                                            <MudSelectItem T="string" Value="@(cnt.MaSo)"> @cnt.ChiTieu </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="3" lg="2">
                                <MudSelect T="string" Margin="Margin.Dense" Label="Loại tôn" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaLoaiTon" Variant="Variant.Outlined">
                                    <MudSelectItem T="string" Value="@("")"> Tất cả</MudSelectItem>
                                    @if (lstLoaiTon != null)
                                    {
                                        @foreach (var cnt in lstLoaiTon)
                                        {
                                            <MudSelectItem T="string" Value="@(cnt.MaSo)"> @cnt.ChiTieu </MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="6" sm="2">
                                <MudButton ButtonType="ButtonType.Submit" Size="Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary">Tìm kiếm</MudButton>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>
                </EditForm>
            </div>
        </div>
    </div>

    <MudToolBar>
        <MudButton Disabled="@(!quyenSuDung.Them)" Variant="Variant.Filled" @onclick="@(() => CreateClick())" StartIcon="@Icons.Material.Filled.Create" Color="Color.Primary">Tạo mới</MudButton>
        <MudButton Disabled="@(!quyenSuDung.XemIn)" Class="ml-1" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="Color.Secondary">Excel</MudButton>
    </MudToolBar>
    <div class="form-group">
        <MudDataGrid @ref="table"
                     ServerData="@(new Func<GridState<DanhMucHangHoaModel>, Task<GridData<DanhMucHangHoaModel>>>(ServerReload))"
                     Filterable="true"
                     Dense="true"
                     T="DanhMucHangHoaModel"
                     FilterMode="DataGridFilterMode.Simple"
                     ColumnResizeMode="ResizeMode.Container"
                     SortMode="SortMode.Single"
                     HorizontalScrollbar="true"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.Default">
            <Columns>

                <PropertyColumn Property="x => x.MaHangHoa" Title="Mã hàng hóa">
                    <CellTemplate>
                        <MudButton Disabled="@(!quyenSuDung.Sua)" Color="Color.Success" Size="Size.Small" @onclick="@(()=> EditClick(@context.Item))">@context.Item.MaHangHoa</MudButton>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.TenHangHoa" Title="Tên hàng hóa" />
                <PropertyColumn Property="x => x.DonViTinh" Title="Đơn vị tính" />
                <PropertyColumn Property="x => x.GiaNhap" Title="Giá nhập" CellStyleFunc="@_cellNumberStyleFunc">
                    <CellTemplate>
                        <MudText>@context.Item.GiaNhap.ToString("###,###")</MudText>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="x => x.GiaXuat" Title="Giá xuất" CellStyleFunc="@_cellNumberStyleFunc">
                    <CellTemplate>
                        <MudText>@context.Item.GiaXuat.ToString("###,###")</MudText>
                    </CellTemplate>
                </PropertyColumn>

                <PropertyColumn Property="x => x.TenNhomHang" Title="Nhóm hàng" Filterable="true" />
                <PropertyColumn Property="x => x.ChungLoai" Title="Chủng loại" Filterable="true" />
                <PropertyColumn Property="x => x.MauSac" Title="Màu sắc" Filterable="true" />
                <PropertyColumn Property="x => x.DoDay" Title="Độ dày" Filterable="true" />
                <PropertyColumn Property="x => x.KieuSong" Title="Kiểu sóng" Filterable="true" />
                <PropertyColumn Property="x => x.LoaiTon" Title="Loại tôn" Filterable="true" />
                <TemplateColumn StickyRight="true" Filterable="false">
                    <CellTemplate>
                        <MudIconButton Disabled="@(!quyenSuDung.Xoa)" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" aria-label="Xóa" @onclick="@(()=> DeleteClick(@context.Item))"></MudIconButton>
                        <MudIconButton Disabled="@(!quyenSuDung.Sua)" Size="Size.Small" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Sửa" @onclick="@(()=> EditClick(@context.Item))">EditClick</MudIconButton>
                    </CellTemplate>
                </TemplateColumn> 
            </Columns>
            <PagerContent>
                <MudDataGridPager T="DanhMucHangHoaModel" RowsPerPageString="Số dòng mỗi trang" />
            </PagerContent>
        </MudDataGrid>

    </div>
</div>
<LoadingProgress IsLoading="isLoading" />
@code {
    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };


    public List<DanhMucChungLoaiModel> lstChungLoai { get; set; }
    public List<DanhMucDoDayModel> lstDoDay { get; set; }
    public List<DanhMucKieuSongModel> lstKieuSong { get; set; }
    public List<DanhMucLoaiTonModel> lstLoaiTon { get; set; }
    public List<DanhMucMauSacModel> lstMauSac { get; set; }
    public List<DanhMucNhomHangModel> lstNhomHang { get; set; }

    public DanhMucHangHoaModel hanghoa { get; set; }
    public List<DanhMucHangHoaModel> hanghoasList { get; set; }
    public List<DanhMucHangHoaModel> filteredList { get; set; }

    public GetAllResponsePaged<DanhMucHangHoaModel> lsResponses { get; set; }
    public QLSX.Shared.Models.HangHoaSearchRequest itemRequest { get; set; }
    bool isLoading = true;

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Danh sách hàng hóa",href: null, disabled: true)
    };

    private IEnumerable<DanhMucHangHoaModel> pagedData;
    private MudDataGrid<DanhMucHangHoaModel> table;
    private int totalItems;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        hanghoa = new DanhMucHangHoaModel();
        hanghoasList = new List<DanhMucHangHoaModel>();
        itemRequest = new QLSX.Shared.Models.HangHoaSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 10,
                Page = 0,
                TotalPages = 0

            };
        lsResponses = new GetAllResponsePaged<DanhMucHangHoaModel>();

        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            lstChungLoai = await chungloaiService.GetAllAsync();
            lstDoDay = await dodayService.GetAllAsync();
            lstKieuSong = await kieusongService.GetAllAsync();
            lstLoaiTon = await loaitonService.GetAllAsync();
            lstMauSac = await mausacService.GetAllAsync();
            lstNhomHang = await nhomhangService.GetAllAsync();

            isLoading = false;
            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    public void Dispose()
    {
    }
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<GridData<DanhMucHangHoaModel>> ServerReload(GridState<DanhMucHangHoaModel> state)
    {
        isLoading = true;
        var sort = state.SortDefinitions.ToList();
        itemRequest.Page = state.Page;
        //itemRequest.Filter = state.FilterDefinitions;
        if (sort.Count > 0)
        {
            for (int i = 0; i < sort.Count; i++)
            {
                itemRequest.SortLable = sort[i].SortBy;
                itemRequest.SortDirection = sort[i].Descending ? QLSX.Shared.Enums.SortDirection.Descending : QLSX.Shared.Enums.SortDirection.Ascending;
            }
        }
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;

        lsResponses = new GetAllResponsePaged<DanhMucHangHoaModel>();

        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "DMHangHoa");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await hanghoaService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<DanhMucHangHoaModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;

        if (data == null)
        {
            data = new List<DanhMucHangHoaModel>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        var result = new GridData<DanhMucHangHoaModel>() { TotalItems = totalItems, Items = pagedData };
        return result;
    }

    private async Task EditClick(DanhMucHangHoaModel item)
    {
        var parameters = new DialogParameters
            {
                ["server"] = item,
                ["lstChungLoai"] = lstChungLoai,
                ["lstDoDay"] = lstDoDay,
                ["lstKieuSong"] = lstKieuSong,
                ["lstLoaiTon"] = lstLoaiTon,
                ["lstMauSac"] = lstMauSac,
                ["lstNhomHang"] = lstNhomHang,
                ["IsSuaOrXoa"] = true,
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Edit>("Sửa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Sửa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi Sửa", "Thông báo");
            }
        }
    }

    private async Task ReloadCatalogItems()
    {
        await table.ReloadServerData();
    }

    private async Task DeleteClick(DanhMucHangHoaModel item)
    {
        var parameters = new DialogParameters { ["server"] = item };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Delete>("Xóa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Xóa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi Xóa", "Thông báo");
            }
        }
    }

    private async Task CreateClick()
    {
        var item = new DanhMucHangHoaModel();
        var parameters = new DialogParameters
            {
                ["server"] = item,
                ["lstChungLoai"] = lstChungLoai,
                ["lstDoDay"] = lstDoDay,
                ["lstKieuSong"] = lstKieuSong,
                ["lstLoaiTon"] = lstLoaiTon,
                ["lstMauSac"] = lstMauSac,
                ["lstNhomHang"] = lstNhomHang,
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Create>("Thêm", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (DanhMucHangHoaModel)result.Data;
            if (deletedServer.Id > 0)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Tạo mới thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi tạo mới", "Thông báo");
            }
        }
    }
    private async Task SearchClick()
    {
        await table.ReloadServerData();
    }
    // style the cells according to the element's physical classification and the molar mass.
    private Func<DanhMucHangHoaModel, string> _cellNumberStyleFunc => x =>
    {
        string style = "";
        style = "text-align: end";
        return style;
    };
    private async Task ExportExcel()
    {
        byte[] fileContents;
        MemoryStream stream = new();
        var listData = await hanghoaService.ExportToExcelAsync(itemRequest);
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;

        if (listData != null)
        {
            using (var package = new ExcelPackage())
            {
                var workSheet = package.Workbook.Worksheets.Add("DMHangHoa_Sheet_1");

                // Set default width cho tất cả column
                workSheet.DefaultColWidth = 20;
                // Tự động xuống hàng khi text quá dài
                workSheet.Cells.Style.WrapText = true;

                #region Header excel
                workSheet.Cells[1, 1].Value = "Mã hàng hóa";
                workSheet.Cells[1, 1].Style.Font.Size = 12;
                workSheet.Cells[1, 1].Style.Font.Bold = true;
                workSheet.Cells[1, 1].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 2].Value = "Tên hàng hóa";
                workSheet.Cells[1, 2].Style.Font.Size = 12;
                workSheet.Cells[1, 2].Style.Font.Bold = true;
                workSheet.Cells[1, 2].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 3].Value = "DVT";
                workSheet.Cells[1, 3].Style.Font.Size = 12;
                workSheet.Cells[1, 3].Style.Font.Bold = true;
                workSheet.Cells[1, 3].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 4].Value = "Giá nhập";
                workSheet.Cells[1, 4].Style.Font.Size = 12;
                workSheet.Cells[1, 4].Style.Font.Bold = true;
                workSheet.Cells[1, 4].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 5].Value = "Giá xuất";
                workSheet.Cells[1, 5].Style.Font.Size = 12;
                workSheet.Cells[1, 5].Style.Font.Bold = true;
                workSheet.Cells[1, 5].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 6].Value = "Nhóm hàng";
                workSheet.Cells[1, 6].Style.Font.Size = 12;
                workSheet.Cells[1, 6].Style.Font.Bold = true;
                workSheet.Cells[1, 6].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 7].Value = "Chủng loại";
                workSheet.Cells[1, 7].Style.Font.Size = 12;
                workSheet.Cells[1, 7].Style.Font.Bold = true;
                workSheet.Cells[1, 7].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 8].Value = "Mầu sắc";
                workSheet.Cells[1, 8].Style.Font.Size = 12;
                workSheet.Cells[1, 8].Style.Font.Bold = true;
                workSheet.Cells[1, 8].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 9].Value = "Độ dày";
                workSheet.Cells[1, 9].Style.Font.Size = 12;
                workSheet.Cells[1, 9].Style.Font.Bold = true;
                workSheet.Cells[1, 9].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 10].Value = "Kiểu sóng";
                workSheet.Cells[1, 10].Style.Font.Size = 12;
                workSheet.Cells[1, 10].Style.Font.Bold = true;
                workSheet.Cells[1, 10].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 11].Value = "Loại tôn";
                workSheet.Cells[1, 11].Style.Font.Size = 12;
                workSheet.Cells[1, 11].Style.Font.Bold = true;
                workSheet.Cells[1, 11].Style.Border.Top.Style = ExcelBorderStyle.Hair;
                #endregion

                #region Body excel
                int rowIndex = 2;
                try
                {
                    foreach (var item in listData.Items)
                    {
                        workSheet.Cells[rowIndex, 1].Value = item.MaHangHoa;
                        workSheet.Cells[rowIndex, 1].Style.Font.Size = 12;
                        workSheet.Cells[rowIndex, 1].Style.Font.Bold = false;
