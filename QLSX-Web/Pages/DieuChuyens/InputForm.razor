    private async Task DeleteClick()
    {
        var parameters = new DialogParameters { ["server"] = nhapxuat };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Delete>("Xóa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            //In a real world scenario we would reload the data from the source here since we "removed" it in the dialog already.
            int.TryParse(result.Data.ToString(), out int deletedServer);
            await nhapxuatService.DeleteAsync(nhapxuat.Id);

            Snackbar.Add("Bạn phải xóa dữ liệu thành công", Severity.Info);

            NhapXuatSearchRequest request = new NhapXuatSearchRequest();
            request.Loai = nhapxuat.Loai;
            request.DMDonViSuDungId = AppService.DMDonViSuDungId;
            // get list IDs from nhap xuat
            var lstIDs = await nhapxuatService.GetAllDieuChuyenIDs(request);

            if (lstIDs.Count == 0)
            {
                navigationManager.NavigateTo("dieuchuyens/" + nhapxuat.Loai + "/edit/0" + "?rid=" + Guid.NewGuid(), true);
            }
            else
            {
                int id = lstIDs[lstIDs.Count - 1];
                navigationManager.NavigateTo("dieuchuyens/" + nhapxuat.Loai + "/edit/" + id + "?rid=" + Guid.NewGuid(), true);
            }
        }
    }

