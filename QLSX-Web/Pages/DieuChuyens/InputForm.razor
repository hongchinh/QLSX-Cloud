    private void CaculateRow(NoiDungNhapXuatModel item, double soluong, double chieudai, double chieurong, double dongia)
    {
        if (item.MaNhom == "01")  // theo m2
        {
            selectedItem1.TongChieuDai = Math.Round(soluong * chieudai, 2);
            selectedItem1.TongDienTich = Math.Round(soluong * (chieurong) * (chieudai), 2);
            selectedItem1.SoTien = Math.Round((chieudai) * (chieurong) * soluong * dongia, 0);
        }
        else if (item.MaNhom == "02") // theo md
        {
            selectedItem1.TongChieuDai = Math.Round(soluong * chieudai, 2);
            selectedItem1.TongDienTich = 0;
            selectedItem1.SoTien = Math.Round((chieudai) * soluong * dongia, 0);
        }
        else // theo sl
        {
            selectedItem1.TongChieuDai = 0;
            selectedItem1.TongDienTich = 0;
            selectedItem1.SoTien = Math.Round(soluong * dongia, 0);
        }
        StateHasChanged();
    }
