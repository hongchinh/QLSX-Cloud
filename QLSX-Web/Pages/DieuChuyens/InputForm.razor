@inject IDMHangHoaTonCuonService<DanhMucHangHoaTonCuonModel> dmtoncuonService
@inject IDMKhachHangService<DanhMucKhachHangModel> dmkhachhangService
@inject IDieuChuyensService<NhapXuatModel> nhapxuatService
