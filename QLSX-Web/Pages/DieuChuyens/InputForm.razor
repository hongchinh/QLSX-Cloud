@namespace QLSX.Web.Pages.DieuChuyensPage

<EditForm Model="nhapxuat">
    <ObjectGraphDataAnnotationsValidator />
    <div class="card">
        <div class="card-body">
            <div class="container-lg">
                <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pd-nx">
                    <MudTabPanel Text="Thông tin đơn hàng">
                        <div id="home">
                            <div class="row mt-3">
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <MudTextField Label="Số phiếu" @bind-Value="@nhapxuat.SoChungTu" style="width:100%" Variant="Variant.Outlined" />
                                        <ValidationMessage For="(() => nhapxuat.SoChungTu)" />
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <div><MudDatePicker Label="Ngày lập" @bind-Date="nhapxuat.NgayCT" DateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined"></MudDatePicker></div>
                                        <ValidationMessage For="(() => nhapxuat.NgayCT)" />
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <ValidationMessage For="(() => nhapxuat.NgayHT)" />
                                        <MudDatePicker Label="Ngày hoàn thành" @bind-Date="nhapxuat.NgayHT" DateFormat="dd/MM/yyyy" Editable="true" Variant="Variant.Outlined"></MudDatePicker>
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        @*<MudSelect Label="Trạng thái" AnchorOrigin="Origin.BottomCenter" @bind-Value="@nhapxuat.DMTinhTrangId" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@(0)">Chọn tình trạng</MudSelectItem>
                                        @if (lstTinhTrang != null)
                                        {
                                        @foreach (var cnt in lstTinhTrang)
                                        {
                                        <MudSelectItem Value="@cnt.Id">@cnt.TenTinhTrang</MudSelectItem>
                                        }
                                        }
                                        </MudSelect>*@
                                    </div>
                                </div>
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-4 mt-2 pd-left-0 pd-right-0">
                                </div>
                                @*đơn vị*@
                                <div class="col-xs-12 col-sm-6 col-md-3 col-xl-2 mt-2 pd-left-0 pd-right-0">
                                    <div class="required">
                                        <MudTextField Label="Mã đơn vị" @bind-Value="@nhapxuat.MaDonVi"
                                                      TextChanged="@( (input) => MaDonViTextChanged(input))"
                                                      Adornment="Adornment.End"
                                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                                      OnAdornmentClick="@(() => OpenDialogKhachHang())"
                                                      Immediate="true"
                                                      Variant="Variant.Outlined" />
