@page "/dieuchuyens"
@using QLSX.Shared.Models;
@using QLSX.Web.Services
@using Blazored.LocalStorage
@using OfficeOpenXml
@using OfficeOpenXml.Style

@inject IDieuChuyensService<NhapXuatModel> nhapxuatService
@inject IUserService userService
@inject IDMTinhTrangService<QLSX.Shared.Models.DMTinhTrangModel> dmTinhTrangService
@inject IDMKhoHangService<DanhMucKhoHangModel> dmkhohangService
@inject IDMLoaiTienService<DanhMucLoaiTienModel> dmLoaiTienService

@inject NavigationManager navigationManager
@inject ILocalStorageService localStorageService
@inject AppService AppService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [Authorize]
@inherits QLSX.Web.Helpers.BlazorComponent
@inject IDialogService DialogService
@inject IToastService toastService
@inject IPhanQuyenSuDungService< QLSX.Shared.Models.QuyenSuDungModel> permisstionService


@namespace QLSX.Web.Pages.DieuChuyensPage

<div class="form-group">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <EditForm Model="@itemRequest" OnValidSubmit="@SearchClick">
        <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField @bind-Value="itemRequest.SoPhieu" Label="Số phiếu" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Label="Số tiền từ" @bind-Value="itemRequest.SoTien_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Label="Số tiền đến" @bind-Value="itemRequest.SoTien_To" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Label="Số tiền TT từ" @bind-Value="itemRequest.SoTienTT_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Label="Số tiền TT đến" @bind-Value="itemRequest.SoTienTT_To" Editable="true"></MudNumericField>
                </MudItem>

                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="string" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="selecttedKhohang" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                        @if (lstKhoHang != null)
                        {
                            @foreach (var cnt in lstKhoHang)
                            {
                                <MudSelectItem Value="@cnt.MaKho"> @cnt.TenKho </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="int" Label="Loại tiền" AnchorOrigin="Origin.BottomCenter" @bind-Value="selecttedLoaiTien" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">Tất cả</MudSelectItem>
                        @if (lstLoaiTien != null)
                        {
                            @foreach (var cnt in lstLoaiTien)
                            {
                                <MudSelectItem Value="@cnt.Id">@cnt.LoaiTien</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Label="Từ ngày" @bind-Date="@itemRequest.NgayLap_From" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Label="Đến ngày" @bind-Date="@itemRequest.NgayLap_To" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudButton Class="mt-3" ButtonType="ButtonType.Submit" Size="Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="Color.Primary">Tìm kiếm</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>

    <MudToolBar>
        <MudButton Disabled="@(!quyenSuDung.Them)" Variant="Variant.Filled" @onclick="@(() => CreateClick())" StartIcon="@Icons.Material.Filled.Create" Color="Color.Primary">Tạo mới</MudButton>
        <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="Color.Secondary">Excel</MudButton>
    </MudToolBar>
    <div class="form-group">
        <MudTable ServerData="@(new Func<TableState, Task<TableData<NhapXuatModel>>>(ServerReload))" Breakpoint="Breakpoint.Sm"
                  Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@isLoading"
                  @ref="table" HorizontalScrollbar="true">
            <ColGroup>
                <col style="width: 150px;" />
                <col style="width: 150px;" />
                <col />
                <col />
                <col style="width: 25%;" />
                <col style="width: 15%;" />
                <col />
                <col />
                <col />
                <col />
                <col style="width: 10%;" />
            </ColGroup>
            <HeaderContent>
                <MudTh><MudTableSortLabel SortLabel="Loai" T="NhapXuatModel">Loại</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="NgayCT" T="NhapXuatModel">Ngày lập</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="SoCT" T="NhapXuatModel">Số phiếu</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="MaDonVi" T="NhapXuatModel">Mã đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenDonVi" T="NhapXuatModel">Tên đơn vị</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="DiaChi" T="NhapXuatModel">Địa chỉ</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TongCong" T="NhapXuatModel">Tổng tiền hàng</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortLabel="TenKho" T="NhapXuatModel">Kho hàng</MudTableSortLabel></MudTh>
                <MudTh>#</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Loai">@context.LoaiDisplay</MudTd>
                <MudTd DataLabel="NgayCt">@(string.Format("{0:dd/MM/yyyy}", context.NgayCT))</MudTd>
                <MudTd DataLabel="Name"> <a href="/dieuchuyens/@context.Loai/edit/@context.Id">@context.SoChungTu </a></MudTd>
                <MudTd DataLabel="MaDonVi">@context.MaDonVi</MudTd>
                <MudTd DataLabel="TenDonVi">@context.TenDonVi</MudTd>
                <MudTd DataLabel="DiaChi">@context.DiaChi</MudTd>
                    <MudTd DataLabel="TongCong">@context.TongCong.ToString("###,###")</MudTd>
                <MudTd DataLabel="TenKho">@context.TenKho</MudTd>
                <MudTd>
                    @if (context.Loai == "dieuchuyen")
                    {
                        <MudIconButton Size="Size.Small" Disabled="@(!quyenSuDung.Xoa)" Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" aria-label="Xóa" @onclick="@(()=> DeleteClick(@context))">Xóa</MudIconButton>
                        <MudIconButton Size="Size.Small" Disabled="@(!quyenSuDung.Sua)" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Sửa" @onclick="@(()=> EditClick(@context.Id, context.Loai))">Sửa</MudIconButton>

                    }
                    else if (context.Loai == "dieuchuyenton")
                    {
                        <MudIconButton Size="Size.Small" Disabled="@(!quyenSuDung.Xoa)" Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" aria-label="Xóa" @onclick="@(()=> DeleteClick(@context))">Xóa</MudIconButton>
                        <MudIconButton Size="Size.Small" Disabled="@(!quyenSuDung.Sua)" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" aria-label="Sửa" @onclick="@(()=> EditClick(@context.Id, context.Loai))">Sửa</MudIconButton>

                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>Không có bản ghi nào tìm thấy</MudText>
            </NoRecordsContent>
            <LoadingContent>
                <MudText>Đang tải dữ liệu...</MudText>
            </LoadingContent>
            <PagerContent>
                <MudTablePager RowsPerPageString="Số dòng mỗi trang" />
            </PagerContent>
        </MudTable>
    </div>

</div>
<LoadingProgress IsLoading="isLoading" />
@code {

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };


    public NhapXuatModel nhapxuat { get; set; }
    public List<NhapXuatModel> nhapxuatList { get; set; }
    public List<NhapXuatModel> filterednhapxuatList { get; set; }

    public GetAllResponsePaged<NhapXuatModel> lsResponses { get; set; }
    public NhapXuatSearchRequest itemRequest { get; set; }
    public bool IsVisible { get; set; }
    public bool IsGridViewFiltered { get; set; }
    bool isLoading = true;
    int Stt = 1;
    public UserModel UserLogin;
    public List<DanhMucKhoHangModel> lstKhoHang { get; set; }
    public List<DanhMucLoaiTienModel> lstLoaiTien { get; set; }

    public string selecttedKhohang { get; set; }
    public int selecttedLoaiTien { get; set; }
    public string selecttedLoai { get; set; }

    private IEnumerable<NhapXuatModel> pagedData;
    private MudTable<NhapXuatModel> table;

    private int totalItems;
    private string searchString = null;

    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Tra cứu điều chuyển",href: null, disabled: true)
    };



    protected override void OnInitialized()
    {

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {

        lsResponses = new GetAllResponsePaged<NhapXuatModel>();
        nhapxuat = new NhapXuatModel();
        nhapxuatList = filterednhapxuatList = new List<NhapXuatModel>();
        itemRequest = new NhapXuatSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 20,
                Page = 0,
                TotalPages = 0

            };


        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            lstKhoHang = await dmkhohangService.GetAllAsync();
            lstLoaiTien = await dmLoaiTienService.GetAllAsync();
            isLoading = false;
            StateHasChanged();
        }
        //await JSRuntime.InvokeAsync<object>("TestDataTablesAdd", "#GridTable");
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<NhapXuatModel>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        if (!string.IsNullOrEmpty(selecttedKhohang))
        {
            itemRequest.MaKhoHang = selecttedKhohang;
        }
        else
        {
            itemRequest.MaKhoHang = string.Empty;
        }
        if (selecttedLoaiTien > 0)
        {
            itemRequest.DMLoaiTienId = selecttedLoaiTien;
        }
        else
        {
            itemRequest.DMLoaiTienId = 0;
        }
        if (selecttedLoai != "")
        {
            itemRequest.Loai = selecttedLoai;
        }
        else
        {
            itemRequest.Loai = "";
        }
        lsResponses = new GetAllResponsePaged<NhapXuatModel>();

        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "dieuchuyen");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await nhapxuatService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<NhapXuatModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;
        if (data == null)
        {
            data = new List<NhapXuatModel>();
        }

        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<NhapXuatModel>() { TotalItems = totalItems, Items = pagedData };
    }


    public void Dispose()
    {

    }
    private async Task EditClick(int id, string loai)
    {
        await localStorageService.SetItemAsync("dieuchuyen-" + loai + AppService.UserId.ToString(), id);
        navigationManager.NavigateTo("dieuchuyens/" + loai + "/edit/" + id);
    }

    private async Task DeleteClick(NhapXuatModel nhapxuat)
    {
        var parameters = new DialogParameters { ["server"] = nhapxuat };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<Delete>("Xóa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            //In a real world scenario we would reload the data from the source here since we "removed" it in the dialog already.
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {

                await table.ReloadServerData();
                toastService.ShowToast(ToastLevel.Success, "Xóa thành công", "Thông báo");
            }
            else
            {
                toastService.ShowToast(ToastLevel.Error, "Xảy ra lỗi khi xóa", "Thông báo");
            }

        }
    }

    private async Task CreateClick()
    {
        navigationManager.NavigateTo("dieuchuyens/create/dieuchuyen?rid=" + Guid.NewGuid());
    }

    private async Task SearchClick()
    {
        isLoading = true;
        IsGridViewFiltered = true;
        await table.ReloadServerData();
        isLoading = false;
    }
    private async Task ReloadCatalogItems()
    {
        isLoading = true;
        IsGridViewFiltered = true;
        await table.ReloadServerData();
        isLoading = false;
    }

    private async Task ExportExcel()
    {
        byte[] fileContents;
        MemoryStream stream = new();
        var listData = await nhapxuatService.ExportToExcelAsync(itemRequest);
        ExcelPackage.LicenseContext = LicenseContext.NonCommercial;
        if (listData != null)
        {
            using (var package = new ExcelPackage())
            {
                var workSheet = package.Workbook.Worksheets.Add("NhapXuat_Sheet_1");

                // Set default width cho tất cả column
                workSheet.DefaultColWidth = 20;
                // Tự động xuống hàng khi text quá dài
                workSheet.Cells.Style.WrapText = true;

                #region Header excel
                workSheet.Cells[1, 1].Value = "Loại";
                workSheet.Cells[1, 1].Style.Font.Size = 12;
                workSheet.Cells[1, 1].Style.Font.Bold = true;
                workSheet.Cells[1, 1].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 2].Value = "Ngày lập";
                workSheet.Cells[1, 2].Style.Font.Size = 12;
                workSheet.Cells[1, 2].Style.Font.Bold = true;
                workSheet.Cells[1, 2].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 3].Value = "Số phiếu";
                workSheet.Cells[1, 3].Style.Font.Size = 12;
                workSheet.Cells[1, 3].Style.Font.Bold = true;
                workSheet.Cells[1, 3].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 4].Value = "Mã đơn vị";
                workSheet.Cells[1, 4].Style.Font.Size = 12;
                workSheet.Cells[1, 4].Style.Font.Bold = true;
                workSheet.Cells[1, 4].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 5].Value = "Tên đơn vị";
                workSheet.Cells[1, 5].Style.Font.Size = 12;
                workSheet.Cells[1, 5].Style.Font.Bold = true;
                workSheet.Cells[1, 5].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 6].Value = "Địa chỉ";
                workSheet.Cells[1, 6].Style.Font.Size = 12;
                workSheet.Cells[1, 6].Style.Font.Bold = true;
                workSheet.Cells[1, 6].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 7].Value = "Tổng tiền hàng";
                workSheet.Cells[1, 7].Style.Font.Size = 12;
                workSheet.Cells[1, 7].Style.Font.Bold = true;
                workSheet.Cells[1, 7].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 8].Value = "Loại tiền";
                workSheet.Cells[1, 8].Style.Font.Size = 12;
                workSheet.Cells[1, 8].Style.Font.Bold = true;
                workSheet.Cells[1, 8].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                workSheet.Cells[1, 9].Value = "Kho hàng";
                workSheet.Cells[1, 9].Style.Font.Size = 12;
                workSheet.Cells[1, 9].Style.Font.Bold = true;
                workSheet.Cells[1, 9].Style.Border.Top.Style = ExcelBorderStyle.Hair;

               
                #endregion

                #region Body excel
                int rowIndex = 2;
                foreach (var item in listData.Items)
                {
                    workSheet.Cells[rowIndex, 1].Value = item.LoaiDisplay;
                    workSheet.Cells[rowIndex, 1].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 1].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 1].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 2].Value = item.NgayCT;
                    workSheet.Cells[rowIndex, 2].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 2].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 2].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 3].Value = item.SoChungTu;
                    workSheet.Cells[rowIndex, 3].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 3].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 3].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 4].Value = item.MaDonVi;
                    workSheet.Cells[rowIndex, 4].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 4].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 4].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 5].Value = item.TenDonVi;
                    workSheet.Cells[rowIndex, 5].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 5].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 5].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 6].Value = item.DiaChi;
                    workSheet.Cells[rowIndex, 6].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 6].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 6].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 7].Value = item.NoiDungNhapXuats.Sum(s => s.SoTien).ToString("###,###");
                    workSheet.Cells[rowIndex, 7].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 7].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 7].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 8].Value = item.DMLoaiTiens?.KyHieu;
                    workSheet.Cells[rowIndex, 8].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 8].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 8].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                    workSheet.Cells[rowIndex, 9].Value = item.DMKhoHang?.TenKho;
                    workSheet.Cells[rowIndex, 9].Style.Font.Size = 12;
                    workSheet.Cells[rowIndex, 9].Style.Font.Bold = false;
                    workSheet.Cells[rowIndex, 9].Style.Border.Top.Style = ExcelBorderStyle.Hair;

                 
                    rowIndex++;
                }
                #endregion

                fileContents = await package.GetAsByteArrayAsync();
            };

            await JSRuntime.InvokeAsync<QLSX.Shared.Models.DMPhongBan>(
                "saveAsFile",
                $"DieuChuyen_{DateTime.Now.ToString("yyyyMMdd_HHmmss")}.xlsx",
                Convert.ToBase64String(fileContents)
            );
        }
    }
}