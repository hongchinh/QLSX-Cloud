                                    <ItemTemplate Context="item">
                                        <div>@item.MaDonVi - @item.TenDonVi</div>
                                    </ItemTemplate>
                                </MudAutocomplete>
                            </MudTooltip>
                        </MudItem>
                        <MudItem xs="12" sm="3" lg="5" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
