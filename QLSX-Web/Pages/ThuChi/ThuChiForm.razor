                        </MudItem>
                        <MudItem xs="12" sm="3" lg="2" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
                            <MudDatePicker ReadOnly="@IsReadOnly" Label="Ngày hoàn thành" @bind-Date="thuchi.NgayHoanThanh" Culture="@CultureInfo.GetCultureInfo("vi-VN")" TitleDateFormat="dd/MM/yyyy" Variant="Variant.Outlined" Margin="Margin.Dense"></MudDatePicker>
