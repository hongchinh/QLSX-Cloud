    private async Task SuaClickCallBack(bool isRead)
    {
        if (isRead)
        {
            ThuChiSearchRequest request = new ThuChiSearchRequest();
            request.DMDonViSuDungId = AppService.DMDonViSuDungId;
            request.Loai = thuchi.Loai;
            request.Id = thuchi.Id;
            var thuchinew = await thuchitService.GetThuChiById(request);
            thuchi = mapper.Map<ThuChiModel>(thuchinew);
            
            // Load selectedKhachHang khi vào chế độ edit
            if (!string.IsNullOrEmpty(thuchi.MaDoiTuong))
            {
                try
                {
                    var dmKH = await dmkhachhangService.GetByCodeAsync(thuchi.MaDoiTuong);
                    if (dmKH != null && dmKH.Id > 0)
                    {
                        selectedKhachHang = dmKH;
                        // Force update UI sau khi load để MudAutocomplete hiển thị
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading selectedKhachHang in SuaClickCallBack: {ex.Message}");
                }
            }
            else
            {
                // Nếu MaDoiTuong rỗng, clear selectedKhachHang
                selectedKhachHang = null;
            }
        }
        IsReadOnly = isRead;
        StateHasChanged();
    }
