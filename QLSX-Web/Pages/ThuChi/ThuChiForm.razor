    private async Task GetSoDuCongNo()
    {
        if (thuchi.DMKhachHangId > 0)
        {
            QLSX.Shared.Models.GetSoDuCongNoRequest request = new QLSX.Shared.Models.GetSoDuCongNoRequest();
            request.DMDonViSuDungId = AppService.DMDonViSuDungId;
            request.MaKhachHang = thuchi.MaDoiTuong;
            request.Loai = thuchi.Loai;
            request.Ngay = thuchi.NgayCT;
            request.Id = thuchi.Id;
            var user1 = (await authenticationStateTask).User;
            var UserId = user1.FindFirst(c => c.Type == "UserId")?.Value ?? "0";
            //quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), loaiThuChi);
            SoDuCN = await dmkhachhangService.GetSoDuCongNoById(request);

        }

    }
    private async Task SuaClickCallBack(bool isRead)
    {
        if (isRead)
        {
            ThuChiSearchRequest request = new ThuChiSearchRequest();
            request.DMDonViSuDungId = AppService.DMDonViSuDungId;
            request.Loai = thuchi.Loai;
            request.Id = thuchi.Id;
            var thuchinew = await thuchitService.GetThuChiById(request);
            thuchi = mapper.Map<ThuChiModel>(thuchinew);
        }
        IsReadOnly = isRead;
        StateHasChanged();
    }
    [JSInvokable]
    private async Task PrintClick(ThuChiModel thuchi)
    {
        string urlPrint = @"{0}/Reports/Viewer?ReportFileName={1}&id={2}&mdvsd={3}";
        if (thuchi.Loai == "thutm")
        {
            urlPrint = string.Format(urlPrint, hostReport, "rptPhieuThu", thuchi.Id, thuchi.DMDonViSuDungId);

        }
        else
        {
            urlPrint = string.Format(urlPrint, hostReport, "rptPhieuChi", thuchi.Id, thuchi.DMDonViSuDungId);
        }
        await JSRuntime.InvokeAsync<WindowDimensions>("printReport", urlPrint);
    }
    private async Task OpenDialogKhachHang()
    {
        if (IsReadOnly) return;
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var result = await DialogService.Show<DialogKhachHang>("Danh sách Khách hàng", options).Result;

        if (!result.Canceled)
        {
            var itemSelected = (DanhMucKhachHangModel)(result.Data ?? null);
            if (itemSelected != null)
            {
                thuchi.DMKhachHangId = itemSelected.Id;
                thuchi.MaDoiTuong = itemSelected.MaDonVi;
                thuchi.TenDoiTuong = itemSelected.TenDonVi;
                thuchi.DiaChi = itemSelected.DiaChi;
                thuchi.DienThoai = itemSelected.DienThoai;

                //await table.ReloadServerData();
            }
        }
    }
