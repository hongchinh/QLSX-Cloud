    private async Task SaveData()
    {
        await form.Validate();
        if (errors.Count() == 0)
        {
            // Validate MaDoiTuong tồn tại trong bảng DanhMucTenDonVI
            if (!string.IsNullOrEmpty(thuchi.MaDoiTuong))
            {
                DanhMucKhachHangModel dmKH = await dmkhachhangService.GetByCodeAsync(thuchi.MaDoiTuong);
                if (dmKH == null || dmKH.Id == 0)
                {
                    Snackbar.Add($"Mã đơn vị '{thuchi.MaDoiTuong}' không tồn tại trong danh mục đơn vị", Severity.Error);
                    return;
                }
            }
            
            await SaveStatus();
            await OnValidSubmit.InvokeAsync(saveAndCreate);
        }
    }
