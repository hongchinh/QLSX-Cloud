            //}
            //else
            //{
            //    int id = lstIDs[lstIDs.Count - 1];
            //    navigationManager.NavigateTo("thuchis/" + thuchi.Loai + "/edit/" + id + "?rid=" + Guid.NewGuid(), true);
            //}
        }
    }

    private async Task SaveData()
    {
        await form.Validate();
        if (errors.Count() == 0)
        {
            // Clear error trước khi validate
            maDoiTuongError = string.Empty;

            // Validate MaDoiTuong tồn tại trong bảng DanhMucTenDonVI
            // if (!string.IsNullOrEmpty(thuchi.MaDoiTuong))
            //{
            DanhMucKhachHangModel dmKH = await dmkhachhangService.GetByCodeAsync(thuchi.MaDoiTuong);
            if (dmKH == null || dmKH.Id == 0)
            {
                maDoiTuongError = $"Mã đơn vị '{thuchi.MaDoiTuong}' không tồn tại trong danh mục đơn vị";
                Snackbar.Add(maDoiTuongError, Severity.Error);
                await Task.Delay(10); // Đảm bảo state được cập nhật
                StateHasChanged(); // Force UI update để hiển thị border đỏ và tooltip
                return;
            }
            //}

            await SaveStatus();
            await OnValidSubmit.InvokeAsync(saveAndCreate);
        }
    }
    private async Task CancelClick()
    {
        await CancelClickCallBack.InvokeAsync();

    }
    private async Task SaveStatus()
    {
        await localStorageService.SetItemAsync($"{thuchi.Loai}-SaveStatus", saveAndCreate);
    }
    private async Task GetSoDuCongNo()
    {
        if (thuchi.DMKhachHangId > 0)
        {
            QLSX.Shared.Models.GetSoDuCongNoRequest request = new QLSX.Shared.Models.GetSoDuCongNoRequest();
            request.DMDonViSuDungId = AppService.DMDonViSuDungId;
            request.MaKhachHang = thuchi.MaDoiTuong;
            request.Loai = thuchi.Loai;
            request.Ngay = thuchi.NgayCT;
            request.Id = thuchi.Id;
            var user1 = (await authenticationStateTask).User;
