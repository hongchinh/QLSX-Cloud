    //HISTORY
    private IEnumerable<TraCuuNhapXuatAll> pagedData;
    private MudTable<TraCuuNhapXuatAll> table;
    public ThuChiSearchRequest itemRequest { get; set; }
    public GetAllResponsePaged<TraCuuNhapXuatAll> lsResponses { get; set; }

    private int totalItems;
    private string searchString = null;
    bool isLoading = true;

    bool success;
    string[] errors = { };
    MudTextField<string> pwField1;
    MudForm form;
    MudSelect<int> mySwitch;
    private string maDoiTuongError = string.Empty;
    private DanhMucKhachHangModel selectedKhachHang;
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<TraCuuNhapXuatAll>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        itemRequest.MaDonVi = thuchi.MaDoiTuong;
        itemRequest.Id = itemRequest.Id ?? 0;
        lsResponses = new GetAllResponsePaged<TraCuuNhapXuatAll>();
        IEnumerable<TraCuuNhapXuatAll> data = new List<TraCuuNhapXuatAll>();
        if (!string.IsNullOrEmpty(thuchi.MaDoiTuong))
        {
            lsResponses = await thuchitService.GetHistoryPagedAsync(itemRequest);
            data = lsResponses.Items;
            totalItems = lsResponses.TotalRecords;
        }

        if (data == null)
        {
            data = new List<TraCuuNhapXuatAll>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<TraCuuNhapXuatAll>() { TotalItems = totalItems, Items = pagedData };
    }
    private async Task OnSearch(string text)
    {
        await table.ReloadServerData();
    }

    public QLSX.Shared.Models.KhachHangSearchRequest itemKHRequest { get; set; } =
    new QLSX.Shared.Models.KhachHangSearchRequest
    {
        MaDonVi = "",
        TenDonVi = "",
        DiaChi = "",
        DienThoai = "",
        Page = 0,
        PageSize = 20,
        TotalPages = 0
    };

    protected override async Task OnInitializedAsync()
    {
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load selectedKhachHang khi thuchi.MaDoiTuong thay đổi (khi được set từ parent component)
        if (!string.IsNullOrEmpty(thuchi?.MaDoiTuong))
        {
            // Chỉ load nếu chưa có hoặc không khớp
            if (selectedKhachHang == null || selectedKhachHang.MaDonVi != thuchi.MaDoiTuong)
            {
                try
                {
                    var dmKH = await dmkhachhangService.GetByCodeAsync(thuchi.MaDoiTuong);
                    if (dmKH != null && dmKH.Id > 0)
                    {
                        selectedKhachHang = dmKH;
                        // Force update UI sau khi load
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading selectedKhachHang in OnParametersSetAsync: {ex.Message}");
                }
            }
        }
        else
        {
            // Nếu MaDoiTuong rỗng, clear selectedKhachHang
            if (selectedKhachHang != null)
            {
                selectedKhachHang = null;
                await InvokeAsync(StateHasChanged);
            }
        }

        await base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            itemKHRequest = new QLSX.Shared.Models.KhachHangSearchRequest
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                MaDonVi = "",
                TenDonVi = "",
                DiaChi = "",
                DienThoai = "",
                Page = 0,
                PageSize = 10,
                TotalPages = 0
            };

            itemRequest = new ThuChiSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 10,
                Page = 0,
                TotalPages = 0

            };
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");
            saveAndCreate = await localStorageService.GetItemAsync<bool>($"{thuchi.Loai}-SaveStatus");
            
            // Load selectedKhachHang nếu có MaDoiTuong nhưng chưa được load (fallback nếu OnParametersSetAsync chưa load)
            if (!string.IsNullOrEmpty(thuchi.MaDoiTuong) && selectedKhachHang == null)
            {
                try
                {
                    var dmKH = await dmkhachhangService.GetByCodeAsync(thuchi.MaDoiTuong);
                    if (dmKH != null && dmKH.Id > 0)
                    {
                        selectedKhachHang = dmKH;
                        // Force update UI sau khi load
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading selectedKhachHang in OnAfterRenderAsync: {ex.Message}");
                }
            }
            
            StateHasChanged();
        }
        await base.OnAfterRenderAsync(firstRender);
    }


    private readonly Random _random = new Random();
    public async Task MaDonViTextChanged(string madv)
    {
        // Clear error khi user thay đổi giá trị
        maDoiTuongError = string.Empty;

        await table.ReloadServerData();
        if (IsReadOnly) return;
        DanhMucKhachHangModel dmKH = await dmkhachhangService.GetByCodeAsync(madv);
        if (dmKH != null && dmKH.Id > 0)
        {
            // Đồng bộ selectedKhachHang khi tìm thấy
            selectedKhachHang = dmKH;
            
            thuchi.DMKhachHangId = dmKH.Id;
            thuchi.MaDoiTuong = dmKH.MaDonVi;
            thuchi.TenDoiTuong = dmKH.TenDonVi;
            thuchi.DiaChi = dmKH.DiaChi;
            thuchi.DienThoai = dmKH.DienThoai;
        }
        else
        {
            // Clear selectedKhachHang nếu không tìm thấy
            selectedKhachHang = null;
            
            thuchi.MaDoiTuong = "";
            thuchi.TenDoiTuong = "";
            thuchi.DiaChi = "";
            thuchi.DienThoai = "";
        }
        await GetSoDuCongNo();
        StateHasChanged();
    }
    private async Task SetKhachHangCallBack(DanhMucKhachHangModel pro)
    {
        thuchi.DMKhachHangId = pro.Id;
        thuchi.MaDoiTuong = pro.MaDonVi;
        thuchi.TenDoiTuong = pro.TenDonVi;
        thuchi.DiaChi = pro.DiaChi;
        thuchi.DienThoai = pro.DienThoai;
    }
    private async Task<List<DanhMucKhachHangModel>> GetDataKhacHangSearch(string filter)
    {
        QLSX.Shared.Models.KhachHangSearchRequest request =
        new QLSX.Shared.Models.KhachHangSearchRequest
        {
            DMDonViSuDungId = AppService.DMDonViSuDungId,
            MaDonVi = "",
            TenDonVi = "",
            DiaChi = "",
            DienThoai = "",
            Page = 0,
            PageSize = 10,
            TotalPages = 0
        };
        var lstitems = await dmkhachhangService.GetAllPagedAsync(request);
        var items = lstitems.Items;

        var kq = items.Where(i => i.TenDonVi.ToString().ToLower().Contains(filter.ToLower())
                                            || i.MaDonVi.ToString().ToLower().Contains(filter.ToLower())).ToList();
        return kq;
    }
