                                                 ResetValueOnEmpty="true"
                                                 MaxItems="50"
                                                 MinCharacters="0"
                                                 DebounceInterval="300"
                                                 Margin="Margin.Dense"
                                                 Dense="true"
                                                 Variant="Variant.Outlined"
                                                 Error="@(!string.IsNullOrEmpty(maDoiTuongError))"
                                                 OnKeyDown="@(async (e) => await OnKeyDownMaDonVi(e))"
                                                 ValueChanged="@(async (DanhMucKhachHangModel value) => { await OnKhachHangSelectedAsync(value); })"
                                                 Adornment="Adornment.End"
