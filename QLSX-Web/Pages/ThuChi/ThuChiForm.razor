                            <ValidationMessage For="(() => thuchi.MaDonHang)" />
                        </MudItem>
                        <MudItem xs="0" sm="0" lg="4" Class="m-0 p-0">
                        </MudItem>

                        <MudItem xs="12" sm="3" lg="2" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
                            <MudTooltip Text="@maDoiTuongError"
                                        Placement="Placement.Top"
                                        Color="Color.Error"
                                        Arrow="true"
                                        Disabled="@string.IsNullOrEmpty(maDoiTuongError)">
                                <MudAutocomplete T="DanhMucKhachHangModel" 
