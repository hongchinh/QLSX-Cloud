        <MudTh><MudTableSortLabel SortLabel="MaDoiTuong" T="TraCuuNhapXuatAll">Mã đơn vị</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="TenDoiTuong" T="TraCuuNhapXuatAll">Tên đơn vị</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="DiaChiDoiTuong" T="TraCuuNhapXuatAll">Địa chỉ</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="MaDonHang" T="TraCuuNhapXuatAll">Mã đơn hàng</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="SoTien" T="TraCuuNhapXuatAll">Số tiền</MudTableSortLabel></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Loai">@context.Loai</MudTd>
        <MudTd DataLabel="NgayCT">@context.NgayCT.ToString("yyyy/MM/dd")</MudTd>
        <MudTd DataLabel="SoChungTu">@context.SoChungTu  </MudTd>
        @* <MudButton Color="Color.Primary" Size="Size.Small" OnClick="@(async ()=> await SuaClickThuChi(context.Loai, context.Id))">@context.SoChungTu</MudButton> *@
        <MudTd DataLabel="MaDoiTuong">@context.MaDoiTuong</MudTd>
        <MudTd DataLabel="TenDoiTuong">@context.TenDoiTuong</MudTd>
        <MudTd DataLabel="DiaChiDoiTuong">@context.DiaChiDoiTuong</MudTd>
        <MudTd DataLabel="MaDonHang">@context.MaDonHang</MudTd>
        <MudTd DataLabel="SoTien">@context.SoTien.ToString("###,###")</MudTd>
