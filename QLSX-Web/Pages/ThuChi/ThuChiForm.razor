    }

    private async Task OnKeyDownMaDonVi(KeyboardEventArgs e)
    {
        if (IsReadOnly) return;
        
        // Xử lý F3: mở dialog chọn khách hàng
        if (e.Key == "F3")
        {
            await OpenDialogKhachHang();
            StateHasChanged();
        }
        // Enter: Để MudAutocomplete tự xử lý việc chọn item đang highlight trong dropdown
        // MudAutocomplete sẽ tự động trigger ValueChanged khi Enter được nhấn và có item được highlight
        // Up/Down: Để MudAutocomplete tự xử lý navigation trong dropdown
        // Không cần xử lý Enter và Up/Down ở đây để MudAutocomplete có thể tự xử lý
    }
