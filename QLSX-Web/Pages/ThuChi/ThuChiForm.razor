        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<DialogTimKiemNhanhThuChi>("Tìm kiếm nhanh", parameters, options);
    }

    private async Task TimNhanhCalback(int id)
    {
        var thuchinew = await thuchitService.GetByIdAsync(id);
        if (thuchinew.Total == 0)
        {
            return;
        }
        thuchi = mapper.Map<ThuChiModel>(thuchinew);
    }
    private string ValidateLoaiTien(int arg)
    {
        if (arg == 0)
            return "Loại tiền bắt buộc nhập!";
        return null;
    }
    private async Task SuaClickThuChi(string loai, int id)
    {

        ThuChiSearchRequest request = new ThuChiSearchRequest();
        request.DMDonViSuDungId = AppService.DMDonViSuDungId;
        request.Loai = loai;
        request.Id = id;
        var thuchinew = await thuchitService.GetThuChiById(request);
        thuchi = mapper.Map<ThuChiModel>(thuchinew);
        StateHasChanged();
    }

    private async Task OnKeyDownMaDonVi(KeyboardEventArgs e)
    {
        if (IsReadOnly) return;
        if (e.Key == "F3")
        {
            await OpenDialogKhachHang();
        }
    }
    private void ShowCongNo()
    {
        if (thuchi.DMKhachHangId == 0
           || thuchi.DMKhachHangId == null
           || string.IsNullOrEmpty(thuchi.MaDoiTuong)
           || !thuchi.NgayCT.HasValue)
        {
            SoDuCN = 0;
            return;
        }
        string loai = thuchi.Loai == "thutm" ? "1" : "2";
        string tungay = "";
        string denngay = string.Format("{0:MM/dd/yyyy}", thuchi.NgayCT);
        string madonvi;
        madonvi = thuchi.MaDoiTuong;
        var parameters = new DialogParameters { ["Loai"] = loai, ["SoDu"] = 1, ["TuNgay"] = tungay, ["DenNgay"] = denngay, ["MaDonVi"] = madonvi };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<QLSX.Web.Pages.TraCuuCongNoPage.DialogShowCongNo>("View danh sách", parameters, options);
    }
}