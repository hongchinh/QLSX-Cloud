                                    {
                                        @foreach (var cnt in lstKhoanChi)
                                        {
                                            <MudSelectItem Value="@cnt.MaKhoanChi">@cnt.TenKhoanChi</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            }
