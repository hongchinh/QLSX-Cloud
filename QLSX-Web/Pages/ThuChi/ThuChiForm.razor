                                    <MudSelectItem Value="@("")">Chọn loại tiền</MudSelectItem>
                                    @if (lstLoaiTien != null)
                                    {
                                        @foreach (var cnt in lstLoaiTien)
                                        {
                                            <MudSelectItem Value="@cnt.LoaiTien">@cnt.LoaiTien</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            }
                        </MudItem>

                        <MudItem xs="12" sm="3" lg="7" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
                            <div class="mt-5 ml-3">Số dư công nợ: <MudButton Color="Color.Success" OnClick="@(() => ShowCongNo())"> @SoDuCN.ToString("##0,###")</MudButton></div>
                        </MudItem>

                        <MudItem xs="12" sm="3" lg="3" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
