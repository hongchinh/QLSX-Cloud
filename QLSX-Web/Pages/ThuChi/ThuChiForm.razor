                                <MudSelect ReadOnly="@IsReadOnly" Label="Khoản chi" AnchorOrigin="Origin.BottomCenter" @bind-Value="@thuchi.MaKhoanChi" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("")">Chọn khoản chi</MudSelectItem>
