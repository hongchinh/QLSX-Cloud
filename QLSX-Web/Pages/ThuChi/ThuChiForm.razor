    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<TraCuuNhapXuatAll>> ServerReload(TableState state)
    {
        isLoading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        itemRequest.MaDonVi = thuchi.MaDoiTuong;
        itemRequest.Id = itemRequest.Id ?? 0;
        lsResponses = new GetAllResponsePaged<TraCuuNhapXuatAll>();
        IEnumerable<TraCuuNhapXuatAll> data = new List<TraCuuNhapXuatAll>();
        if (!string.IsNullOrEmpty(thuchi.MaDoiTuong))
        {
            lsResponses = await thuchitService.GetHistoryPagedAsync(itemRequest);
            data = lsResponses.Items;
            totalItems = lsResponses.TotalRecords;
        }

        if (data == null)
        {
            data = new List<TraCuuNhapXuatAll>();
        }
        pagedData = data;
        isLoading = false;
        StateHasChanged();
        return new TableData<TraCuuNhapXuatAll>() { TotalItems = totalItems, Items = pagedData };
    }
