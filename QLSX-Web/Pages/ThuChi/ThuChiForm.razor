                        </MudItem>
                        <MudItem xs="12" sm="3" lg="3" Class="pd-left-0 pd-right-0 pd-top-1 pd-bottom-1">
                            @if (thuchi.Loai == "thutm")
                            {
                                <MudSelect ReadOnly="@IsReadOnly" Label="Khoản thu" AnchorOrigin="Origin.BottomCenter" @bind-Value="@thuchi.MaKhoanThu" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@("")">Chọn khoản thu</MudSelectItem>
                                    @if (lstKhoanThu != null)
                                    {
                                        @foreach (var cnt in lstKhoanThu)
                                        {
                                            <MudSelectItem Value="@cnt.MaKhoanThu">@cnt.TenKhoanThu</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            }
                            else if (thuchi.Loai == "chitm")
