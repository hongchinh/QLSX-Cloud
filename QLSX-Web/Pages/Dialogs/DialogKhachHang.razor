    void Cancel() => MudDialog.Cancel();

    private void Ok()
    {
        MudDialog.Close(DialogResult.Ok<DanhMucKhachHangModel>(selectedItem1));
    }
    private void OnButtonSelect(DanhMucKhachHangModel item)
    {
        selectedItem1 = item;
        Ok();
    }
    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<DanhMucKhachHangModel>> ServerReload(TableState state)
    {
        Loading = true;
        itemRequest.SortLable = state.SortLabel;
        itemRequest.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        if (!string.IsNullOrEmpty(searchString))
        {
            itemRequest.SearchText = searchString;
        }
        else
        {
            itemRequest.SearchText = "";
        }
        lsResponses = new GetAllResponsePaged<DanhMucKhachHangModel>();
        lsResponses = await khachhangServicece.GetAllPagedDialogAsync(itemRequest);
        IEnumerable<DanhMucKhachHangModel> data = lsResponses.Items; ;
        totalItems = lsResponses.TotalRecords;
        if (data == null)
        {
            data = new List<DanhMucKhachHangModel>();
        }
        pagedData = data;
        Loading = false;
        return new TableData<DanhMucKhachHangModel>() { TotalItems = totalItems, Items = pagedData };
    }

    private DanhMucKhachHangModel DoSelectedRow(DanhMucKhachHangModel ctx)
    {
        selectedItem1 = ctx;
        Ok();
        return ctx;
    }
    private async Task OnSearch(string text)
    {
        searchString = text;
        await table.ReloadServerData();
    }
    private async Task AddNewClick()
    {
        lstNhomKhachHang = await nhomkhachhangService.GetAllAsync();
        lstTinhThanh = await tinhthanhService.GetAllAsync();
        lstUser = await dmNhanVienService.GetAllAsync();

        var item = new DanhMucKhachHangModel();
        var parameters = new DialogParameters
            {
                ["server"] = item,
                ["lstNhomKhachHang"] = lstNhomKhachHang,
                ["lstTinhThanh"] = lstTinhThanh,
                ["lstUser"] = lstUser
            };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = DialogService.Show<QLSX.Web.Pages.DMKhachHangPage.Create>("Tạo mới", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var deletedServer = (DanhMucKhachHangModel)result.Data;
            if (deletedServer.Id>0)
            {
                searchString = deletedServer.MaDonVi;
                await table.ReloadServerData();
            }
        }
    }

    private void RowClickEvent(TableRowClickEventArgs<DanhMucKhachHangModel> tableRowClickEventArgs)
    {
        // clickedEvents.Add("Row has been clicked");
        selectedItem1 = tableRowClickEventArgs.Item;
