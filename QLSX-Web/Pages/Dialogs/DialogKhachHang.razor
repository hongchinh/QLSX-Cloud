@namespace Dialogs
<MudDialog DisableSidePadding="true" DefaultFocus="DefaultFocus.LastChild">
    <DialogContent>
        <MudContainer Style="overflow-y: scroll">
            <MudTable ServerData="@(new Func<TableState, Task<TableData<DanhMucKhachHangModel>>>(ServerReload))" FixedHeader="true" Height="400px"
                      Dense="true" Hover="true" Bordered="true" Striped="true" Loading="@Loading" @ref="table" RowClassFunc="@SelectedRowClassFunc" OnRowClick="@RowClickEvent" T="DanhMucKhachHangModel"
                      @bind-SelectedItem="selectedItem1" SelectOnRowClick="true">
                <ToolBarContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddNewClick"> Thêm </MudIconButton>
                    <MudTextField T="string" ValueChanged="@(s=>OnSearch(s))" Placeholder="Tìm kiếm" Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Mã khách hàng</MudTh>
                    <MudTh>Tên khách hàng</MudTh>
                    <MudTh>Địa chỉ</MudTh>
                    <MudTh>Điện thoại</MudTh>
                    <MudTh>Điện thoại 1</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="MaDonVi">
                        <div @onclick="@( (x) => DoSelectedRow(context))"
                             @ondblclick="@( (x) => DoSelectedRow(context))">
                            <a>@context.MaDonVi</a> @*<MudIconButton Icon="@Icons.Material.Filled.SelectAll" Color="Color.Primary" aria-label="Chọn" OnClick="@(() => OnButtonSelect(context) )"></MudIconButton>*@
                        </div>
                    </MudTd>
                    <MudTd DataLabel="TenDonVi">
                        <div @onclick:stopPropagation="true"
                             @ondblclick="@( (x) => DoSelectedRow(context))">
                            @context.TenDonVi
                        </div>
                    </MudTd>
                    <MudTd DataLabel="DiaChi">
                        <div @onclick:stopPropagation="true"
                             @ondblclick="@( (x) => DoSelectedRow(context))">
                            @context.DiaChi
                        </div>
                    </MudTd>
                    <MudTd DataLabel="DienThoai">
                        <div @onclick:stopPropagation="true"
                             @ondblclick="@( (x) => DoSelectedRow(context))">
                            @context.DienThoai
                        </div>
                    </MudTd>
                    <MudTd DataLabel="DienThoai1">
                        <div @onclick:stopPropagation="true"
                             @ondblclick="@( (x) => DoSelectedRow(context))">
                            @context.DienThoai1
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>Không có bản ghi nào tìm thấy</MudText>
                </NoRecordsContent>
                <LoadingContent>
                    <MudText>Đang tải dữ liệu...</MudText>
                </LoadingContent>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Cancel">Bỏ qua</MudButton>
    </DialogActions>
</MudDialog>
