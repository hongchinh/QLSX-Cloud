        window.setElementSizeByClass = (id) => {
            let formdv = document.querySelector('.' + id);
            if (formdv != null) {
                let formdv1 = document.getElementById("idFormNX");
                let tooldv1 = document.getElementById("idToolbarNX");
                var elements = formdv.querySelectorAll(".mud-table-container");
                let hgrid = formdv.offsetHeight - 150 - formdv1.offsetHeight - tooldv1.offsetHeight;

                let item = {
                    width: 0,
                    height: hgrid,
                    formHeight: 0,
                    toolbarHeight: 0,
                };
                for (var i = 0; i < elements.length; i++) {
                    elements[i].style.height = hgrid + "px";
                }
                return item;
            } else {
                return {
                    width: 0,
                    height: 0,
                    formHeight: 0,
                    toolbarHeight: 0,
