    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<TableData<ThuChiModel>> ServerReloadThu(TableState state)
    {
        isLoadingThu = true;
        itemRequestThu = new ThuChiSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 5,
                Page = 0,
                TotalPages = 0,
                Loai = "thutm"
            };
        itemRequestThu.SortLable = state.SortLabel;
        itemRequestThu.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequestThu.Page = state.Page;
        itemRequestThu.PageSize = state.PageSize;

        lsResponsesThu = new GetAllResponsePaged<ThuChiModel>() { };


        lsResponsesThu = await listThuChiService.GetAllPagedAsync(itemRequestThu);

        IEnumerable<ThuChiModel> data = lsResponsesThu?.Items;

        totalItemsThu = lsResponsesThu?.TotalRecords;

        pagedDataThu = data ?? new List<ThuChiModel>();
        isLoadingThu = false;
        StateHasChanged();
        return new TableData<ThuChiModel>() { TotalItems = totalItemsThu ?? 0, Items = pagedDataThu };
    }


