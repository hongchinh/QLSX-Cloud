                Page = 0,
                TotalPages = 0,
                Loai = "chitm"
            };
        itemRequestChi.SortLable = state.SortLabel;
        itemRequestChi.SortDirection = (QLSX.Shared.Enums.SortDirection)state.SortDirection;
        itemRequestChi.Page = state.Page;
        itemRequestChi.PageSize = state.PageSize;

        lsResponsesChi = new GetAllResponsePaged<ThuChiModel>() { };


        lsResponsesChi = await listThuChiService.GetAllPagedAsync(itemRequestChi);

        IEnumerable<ThuChiModel> data = lsResponsesChi.Items;
        totalItemsChi = lsResponsesChi.TotalRecords;

        pagedDataChi = data ?? new List<ThuChiModel>();
        isLoadingChi = false;
        StateHasChanged();
        return new TableData<ThuChiModel>() { TotalItems = totalItemsChi, Items = pagedDataChi };
    }


