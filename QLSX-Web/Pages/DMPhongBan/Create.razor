@using QLSX.Web.Helpers
@inject ILogger<Create> Logger
@inject IJSRuntime jsRuntime
@inject IDMPhongBanService<QLSX.Shared.Models.DMPhongBan> itemService
@inherits QLSX.Web.Helpers.BlazorComponent
@inject AppService AppService

@namespace QLSX.Web.Pages.DMPhongBanPage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3 mb-n1" />
            Tạo mới
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="server">
            <DataAnnotationsValidator />
            <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
                <ValidationSummary></ValidationSummary>
                <MudGrid Spacing="1">
                    <MudItem xs="6" sm="3">
                        <MudTextField  Margin="Margin.Dense"@bind-Value="@server.MaPhong" Label="Mã phòng" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="6" sm="9">
                        <MudTextField Margin="Margin.Dense" @bind-Value="@server.TenPhong" Label="Tên phòng" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error" >Bỏ qua</MudButton>
        <MudButton Class="me-3" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => SaveClick())">Lưu</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; }
    [Parameter] public QLSX.Shared.Models.DMPhongBan server { get; set; } = new QLSX.Shared.Models.DMPhongBan();

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task SaveClick()
    {
        var itemCreate = await itemService.CreateAsync(server);
        MudDialog.Close(DialogResult.Ok(itemCreate.Id > 0));
    }

}
