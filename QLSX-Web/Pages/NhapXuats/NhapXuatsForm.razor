    }

    private async Task SetForcusInGrid(string columnName)
    {
        if (columnName == "MaHangHoa")
        {
            IsMaHangHoaFocus = true;
            IsSoLuongFocus = false;
            IsChieuDaiFocus = false;
        }
        if (columnName == "SoLuong")
        {
            IsMaHangHoaFocus = false;
            IsSoLuongFocus = true;
            IsChieuDaiFocus = false;
        }
        if (columnName == "ChieuDai")
        {
            IsMaHangHoaFocus = false;
            IsSoLuongFocus = false;
            IsChieuDaiFocus = true;
        }
    }
