    // Method để lấy selected hàng hóa từ NoiDungNhapXuatModel
    private DanhMucHangHoaModel GetSelectedHangHoa(NoiDungNhapXuatModel noiDung)
    {
        if (hangHoaMapping.ContainsKey(noiDung))
        {
            return hangHoaMapping[noiDung];
        }
        
        // Nếu có MaHangHoa, tìm trong mapping hoặc trả về null
        if (!string.IsNullOrEmpty(noiDung.MaHangHoa))
        {
            // Tìm trong cache nếu có
            var cached = hangHoaMapping.Values.FirstOrDefault(x => x.MaHangHoa == noiDung.MaHangHoa);
            if (cached != null)
            {
                hangHoaMapping[noiDung] = cached;
                return cached;
            }
        }
        
        return null;
    }

    // Method để search hàng hóa theo mã hoặc tên
    private async Task<IEnumerable<DanhMucHangHoaModel>> SearchHangHoaAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            // Nếu không có giá trị, trả về danh sách rỗng
            return new List<DanhMucHangHoaModel>();
        }

        try
        {
            // Gọi API 2 lần: một lần tìm theo mã, một lần tìm theo tên
            // Sau đó merge kết quả và loại bỏ trùng lặp
            var tasks = new List<Task<GetAllResponsePaged<DanhMucHangHoaModel>>>();
            
            // Tìm theo mã hàng hóa
            var searchRequestMa = new HangHoaSearchRequest
            {
                MaHangHoa = value,
                Page = 0,
                PageSize = 50,
                DMDonViSuDungId = AppService.DMDonViSuDungId
            };
            tasks.Add(dmhanghoaService.GetAllPagedDialogAsync(searchRequestMa));
            
            // Tìm theo tên hàng hóa
            var searchRequestTen = new HangHoaSearchRequest
            {
                TenHangHoa = value,
                Page = 0,
                PageSize = 50,
                DMDonViSuDungId = AppService.DMDonViSuDungId
            };
            tasks.Add(dmhanghoaService.GetAllPagedDialogAsync(searchRequestTen));
            
            // Chờ cả 2 task hoàn thành
            var results = await Task.WhenAll(tasks);
            
            // Merge kết quả và loại bỏ trùng lặp theo Id
            var allItems = new List<DanhMucHangHoaModel>();
            foreach (var result in results)
            {
                if (result != null && result.Items != null)
                {
                    allItems.AddRange(result.Items);
                }
            }
            
            // Loại bỏ trùng lặp và filter lại để đảm bảo chính xác
            var uniqueItems = allItems
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .Where(x => 
                    (x.MaHangHoa != null && x.MaHangHoa.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                    (x.TenHangHoa != null && x.TenHangHoa.Contains(value, StringComparison.OrdinalIgnoreCase))
                )
                .Take(50)
                .ToList();
            
            return uniqueItems;
        }
        catch (Exception)
        {
            return new List<DanhMucHangHoaModel>();
        }
    }

    // Method xử lý khi chọn hàng hóa từ autocomplete
    private async Task OnHangHoaSelectedAsync(DanhMucHangHoaModel selectedHangHoa, NoiDungNhapXuatModel noiDung)
    {
        if (selectedHangHoa == null || noiDung == null)
        {
            return;
        }

        // Lưu mapping
        hangHoaMapping[noiDung] = selectedHangHoa;

        // Cập nhật thông tin vào NoiDungNhapXuatModel
        noiDung.MaHangHoa = selectedHangHoa.MaHangHoa;
        noiDung.TenHangHoa = selectedHangHoa.TenHangHoa;
        noiDung.DonViTinh = selectedHangHoa.DonViTinh;
        noiDung.DonGia = selectedHangHoa.GiaXuat;
        noiDung.KhoRongTon = selectedHangHoa.KhoRongTon;
        noiDung.ChieuDai = selectedHangHoa.ChieuDai;
        noiDung.DMHangHoaId = selectedHangHoa.Id;
        noiDung.DMDonViSuDungId = nhapxuat.DMDonViSuDungId;
        noiDung.DMKhoHangId = nhapxuat?.DMKhoHangId ?? 0;
        noiDung.MaNhom = selectedHangHoa.MaNhomHang;
        noiDung.TenNhom = selectedHangHoa.TenNhomHang;

        noiDung.KieuSong = selectedHangHoa.KieuSong;
        noiDung.MaKieuSong = selectedHangHoa.MaKieuSong;
        noiDung.LoaiTon = selectedHangHoa.LoaiTon;
        noiDung.MaLoaiTon = selectedHangHoa.MaLoaiTon;
        noiDung.DoDay = selectedHangHoa.DoDay;
        noiDung.ChungLoai = selectedHangHoa.ChungLoai;
        noiDung.MaChungLoai = selectedHangHoa.MaChungLoai;
        noiDung.MauSac = selectedHangHoa.MauSac;
        noiDung.MaMauSac = selectedHangHoa.MaMauSac;

        noiDung.IsM2 = false;
        noiDung.IsMD = false;
        noiDung.IsSoLuong = false;

        if (selectedHangHoa.MaNhomHang == "01")
        {
            noiDung.IsM2 = true;
            noiDung.TongChieuDai = Math.Round(noiDung.SoLuong * noiDung.ChieuDai, 2);
            noiDung.TongDienTich = Math.Round(noiDung.SoLuong * noiDung.KhoRongTon * noiDung.ChieuDai, 2);
            noiDung.SoTien = selectedHangHoa.ChieuDai * selectedHangHoa.KhoRongTon * noiDung.SoLuong * noiDung.DonGia;
        }
        else if (selectedHangHoa.MaNhomHang == "02")
        {
            noiDung.IsMD = true;
            noiDung.TongChieuDai = Math.Round(noiDung.SoLuong * noiDung.ChieuDai, 2);
            noiDung.TongDienTich = 0;
            noiDung.SoTien = selectedHangHoa.ChieuDai * noiDung.SoLuong * noiDung.DonGia;
        }
        else
        {
            noiDung.IsSoLuong = true;
            noiDung.TongChieuDai = 0;
            noiDung.TongDienTich = 0;
            noiDung.SoTien = noiDung.SoLuong * noiDung.DonGia;
        }

        // Lấy số lượng tồn - Gọi trực tiếp (không debounce) để hiển thị ngay
        if (!string.IsNullOrEmpty(noiDung.MaHangHoa) && !string.IsNullOrEmpty(nhapxuat.MaKho))
        {
            // Gọi trực tiếp để hiển thị ngay, không debounce
            await UpdateSoLuongTonForAllRowsInternal();
        }
        else
        {
            // Nếu thiếu thông tin, set về 0
            noiDung.SoLuongTon = 0;
        }
        
        await InvokeAsync(StateHasChanged);
    }

    public async Task MaHangHoaTextChanged(string mahh)
    {
        if (IsFirstEdit == 1)
        {
            IsFirstEdit = -1;
            return;
