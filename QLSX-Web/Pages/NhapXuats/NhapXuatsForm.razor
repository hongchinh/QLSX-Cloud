    private async Task DonHangKeyDown(KeyboardEventArgs e)
    {
        if (IsReadOnly) return;
        if (e.Key == "Enter")
        {
            StateHasChanged();
            await Task.Delay(10);
            string madh = nhapxuat.MaDonHang;
            var donhang = await donhangService.GetByCodeAsync(nhapxuat.MaDonHang);
            if (donhang.Id > 0)
            {
                nhapxuat.NoiDungNhapXuats.Clear();

                nhapxuat.MaDonVi = donhang.MaDonVi;
                nhapxuat.TenDonVi = donhang.TenDonVi;
                nhapxuat.DiaChi = donhang.DiaChi;
                nhapxuat.MaDonHang = donhang.SoCT;
                foreach (var item in donhang.NoiDungDonDatHangs)
                {
                    var ndnx = mapper.Map<NoiDungNhapXuatModel>(item);
                    ndnx.Id = 0;
                    nhapxuat.NoiDungNhapXuats.Add(ndnx);
                }
            }
            else
            {
                toastService.ShowToast(ToastLevel.Warning, "Không tìm thấy mã đơn hàng " + madh, "Thông báo");
            }
            StateHasChanged();
        }

        //StateHasChanged();
