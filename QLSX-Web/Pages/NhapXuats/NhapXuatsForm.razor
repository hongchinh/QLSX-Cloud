    // Method xử lý keyboard cho MudAutocomplete (cột MaHangHoa)
    private async Task OnKeyDownAutocomplete(KeyboardEventArgs e, int indexCurrentSelected, NoiDungNhapXuatModel noiDung)
    {
        if (IsReadOnly) return;
        
        // Xử lý Enter: confirm selection và di chuyển đến cột Số lượng
        if (e.Key == "Enter")
        {
            // Nếu đã có hàng hóa được chọn, di chuyển đến cột Số lượng
            if (!string.IsNullOrEmpty(noiDung.MaHangHoa))
            {
                IsSoLuongFocus = true;
                await SetForcusInGrid("SoLuong");
                StateHasChanged();
            }
        }
        // Xử lý Tab: di chuyển đến cột tiếp theo
        else if (e.Key == "Tab")
        {
            IsSoLuongFocus = true;
            await SetForcusInGrid("SoLuong");
            StateHasChanged();
        }
        // Xử lý F2: thêm dòng mới
        else if (e.Key == "F2")
        {
            await AddRow();
            await SetForcusInGrid("MaHangHoa");
            StateHasChanged();
        }
        // Xử lý F3: mở dialog chọn hàng hóa
        else if (e.Key == "F3")
        {
            await OpenDialogHangHoa();
            StateHasChanged();
        }
        // Up/Down: để MudAutocomplete tự xử lý navigation trong dropdown
        // Không cần xử lý ở đây
    }

    private async Task OnKeyDownGrid(KeyboardEventArgs e, int indexCurrentSelected, string columnName)
    {
        if (IsReadOnly) return;
        string[] lstNumber = { "SoLuong", "ChieuDai", "KhoRongTon", "TongChieuDai", "TongDienTich", "DonGia", "SoTien" };
        if (lstNumber.Where(x => x.Equals(columnName)).Count() < 1)
        {
            if ((e.Key == "Tab" && columnName == "GhiChu") || e.Key == "ArrowDown")
            {
                if (indexCurrentSelected == nhapxuat.NoiDungNhapXuats.Count - 1)
                {
                    await AddRow();
                    await SetForcusInGrid("MaHangHoa");
                }
                else
                {
                    await SetActiveRow(indexCurrentSelected + 1);
                }
            }
            else if (e.Key == "ArrowUp")
            {
                if (indexCurrentSelected == 0) return;
                await SetActiveRow(indexCurrentSelected - 1);
            }
            else if (e.Key == "F2" && columnName == "MaHangHoa")
            {
                await AddRow();
                await SetForcusInGrid("MaHangHoa");
            }
            else if (e.Key == "F3" && columnName == "MaHangHoa")
            {
                await OpenDialogHangHoa();
            }
            else if (e.Key == "Tab" && columnName == "MaHangHoa")
            {
                IsSoLuongFocus = true;
            }
        }

        StateHasChanged();
    }
