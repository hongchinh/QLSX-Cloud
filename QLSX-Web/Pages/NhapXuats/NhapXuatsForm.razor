    private async Task LoadFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            try
            {
                tblFileAttachment item = new tblFileAttachment();
                item.FileName = file.Name;
                item.CreateDate = DateTime.Now;
                item.FileExtention = file.ContentType;
                using var stream = file.OpenReadStream();
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                item.FileBytes = ms.ToArray();
                item.Loai = nhapxuat.Loai;
                item.IdPhieu = nhapxuat.Id;
                item.UserId = nhapxuat.UserId ?? 0;
                lstFiles.Add(item);

                loadedFiles.Add(file);
                lstFileName.Add(file.Name);
                lstFileExt.Add(file.ContentType);

            }
            catch (Exception)
            {

            }
        }
        HoverClass = string.Empty;
    }
    private void DeleteFile(int id)
    {
        foreach (var file in lstFiles)
        {
            if (file.id == id)
            {
                lstFiles.Remove(file);
                break;
            }
        }
    }
