    // Method để search khách hàng theo mã hoặc tên
    private async Task<IEnumerable<DanhMucKhachHangModel>> SearchKhachHangAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            // Nếu không có giá trị, trả về danh sách rỗng
            return new List<DanhMucKhachHangModel>();
        }

        try
        {
            // Gọi API 2 lần: một lần tìm theo mã, một lần tìm theo tên
            // Sau đó merge kết quả và loại bỏ trùng lặp
            var tasks = new List<Task<GetAllResponsePaged<DanhMucKhachHangModel>>>();
            
            // Tìm theo mã đơn vị
            var searchRequestMa = new KhachHangSearchRequest
            {
                MaDonVi = value,
                Page = 0,
                PageSize = 50,
                DMDonViSuDungId = AppService.DMDonViSuDungId
            };
            tasks.Add(dmkhachhangService.GetAllPagedDialogAsync(searchRequestMa));
            
            // Tìm theo tên đơn vị
            var searchRequestTen = new KhachHangSearchRequest
            {
                TenDonVi = value,
                Page = 0,
                PageSize = 50,
                DMDonViSuDungId = AppService.DMDonViSuDungId
            };
            tasks.Add(dmkhachhangService.GetAllPagedDialogAsync(searchRequestTen));
            
            // Chờ cả 2 task hoàn thành
            var results = await Task.WhenAll(tasks);
            
            // Merge kết quả và loại bỏ trùng lặp theo Id
            var allItems = new List<DanhMucKhachHangModel>();
            foreach (var result in results)
            {
                if (result != null && result.Items != null)
                {
                    allItems.AddRange(result.Items);
                }
            }
            
            // Loại bỏ trùng lặp và filter lại để đảm bảo chính xác
            var uniqueItems = allItems
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .Where(x => 
                    (x.MaDonVi != null && x.MaDonVi.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                    (x.TenDonVi != null && x.TenDonVi.Contains(value, StringComparison.OrdinalIgnoreCase))
                )
                .Take(50)
                .ToList();
            
            return uniqueItems;
        }
        catch (Exception)
        {
            return new List<DanhMucKhachHangModel>();
        }
    }

