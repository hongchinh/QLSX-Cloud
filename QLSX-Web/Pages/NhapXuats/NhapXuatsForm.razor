    private void ChangeValueRow(string value, string key)
    {
        if (IsReadOnly)
        {
            return;
        }
        double valueItem = 0;
        double.TryParse(value, out valueItem);
        if (key == "DonGiaHoaHong")
        {
            if (selectedNoiDung.IsM2)  // theo m2
            {
                selectedNoiDung.SoTien = Math.Round((selectedNoiDung.ChieuDai / tyleDonVi) * (selectedNoiDung.KhoRongTon / tyleDonVi) * selectedNoiDung.SoLuong * selectedNoiDung.DonGiaHoaHong, 0);
            }
            else if (selectedNoiDung.IsMD) // theo md
            {
                selectedNoiDung.SoTienHoaHong = Math.Round((selectedNoiDung.ChieuDai / tyleDonVi) * selectedNoiDung.SoLuong * selectedNoiDung.DonGiaHoaHong, 0);
            }
            else // theo sl
            {
                selectedNoiDung.SoTienHoaHong = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.DonGiaHoaHong, 0);
            }
            return;
        }
        CaculateRow(selectedNoiDung, selectedNoiDung.SoLuong, selectedNoiDung.ChieuDai, selectedNoiDung.KhoRongTon, selectedNoiDung.DonGia);
        StateHasChanged();
    }
    private void CaculateRow(NoiDungNhapXuatModel item, double soluong, double chieudai, double chieurong, double dongia)
    {
        if (selectedNoiDung.MaNhom == "01")  // theo m2
        {
            selectedNoiDung.IsM2 = true;
            selectedNoiDung.TongChieuDai = Math.Round(soluong * chieudai / tyleDonVi, 2);
            selectedNoiDung.TongDienTich = Math.Round(soluong * (chieurong / tyleDonVi) * (chieudai / tyleDonVi), 2);
            selectedNoiDung.SoTien = Math.Round((chieudai / tyleDonVi) * (chieurong / tyleDonVi) * soluong * dongia, 0);
        }
        else if (selectedNoiDung.MaNhom == "02") // theo md
        {
            selectedNoiDung.TongChieuDai = Math.Round(soluong * chieudai / tyleDonVi, 2);
            selectedNoiDung.TongDienTich = 0;
            selectedNoiDung.SoTien = Math.Round((chieudai / tyleDonVi) * soluong * dongia, 0);
            selectedNoiDung.IsMD = true;
        }
        else // theo sl
        {
            selectedNoiDung.IsSoLuong = true;
            selectedNoiDung.TongChieuDai = 0;
            selectedNoiDung.TongDienTich = 0;
            selectedNoiDung.SoTien = Math.Round(soluong * dongia, 0);
        }
        nhapxuat.TongCong = nhapxuat.NoiDungNhapXuats.Sum(x => x.SoTien);
        nhapxuat.SoTienVAT = nhapxuat.TyleVAT * nhapxuat.TongCong;

    }
