    // Method tối ưu: Cập nhật số lượng tồn cho tất cả các dòng bằng Batch API (với debounce)
    private async Task UpdateSoLuongTonForAllRows()
    {
        // Hủy timer cũ nếu có
        _debounceTimer?.Dispose();
        
        // Tạo timer mới để debounce
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await UpdateSoLuongTonForAllRowsInternal();
            _debounceTimer?.Dispose();
            _debounceTimer = null;
        }, null, _debounceDelay, TimeSpan.FromMilliseconds(-1));
    }

    // Method thực sự thực hiện cập nhật số lượng tồn (với cache)
    private async Task UpdateSoLuongTonForAllRowsInternal()
    {
        // Tránh gọi đồng thời nhiều lần
        if (_isUpdatingSoLuongTon)
            return;

        if (nhapxuat.NoiDungNhapXuats == null || !nhapxuat.NoiDungNhapXuats.Any())
            return;

        if (string.IsNullOrEmpty(nhapxuat.MaKho))
        {
            // Nếu không có kho, set tất cả về 0
            foreach (var noiDung in nhapxuat.NoiDungNhapXuats)
            {
                noiDung.SoLuongTon = 0;
            }
            await InvokeAsync(StateHasChanged);
            return;
        }

        var ngay = nhapxuat.NgayCT ?? DateTime.Now;
        var now = DateTime.Now;
        var itemsToFetch = new List<string>();
        var cacheKeyPrefix = $"{nhapxuat.MaKho}_{ngay:yyyyMMdd}_";

        // Bước 1: Kiểm tra cache và cập nhật những cái đã có
        foreach (var noiDung in nhapxuat.NoiDungNhapXuats)
        {
            if (string.IsNullOrEmpty(noiDung.MaHangHoa))
            {
                noiDung.SoLuongTon = 0;
                continue;
            }

            string cacheKey = $"{cacheKeyPrefix}{noiDung.MaHangHoa}";

            // Kiểm tra cache
            if (_soLuongTonCache.ContainsKey(cacheKey))
            {
                var (value, timestamp) = _soLuongTonCache[cacheKey];
                if (now - timestamp < _cacheExpiry)
                {
                    // Có trong cache và chưa hết hạn
                    noiDung.SoLuongTon = value;
                    continue;
                }
                else
                {
                    // Cache đã hết hạn, xóa khỏi cache
                    _soLuongTonCache.Remove(cacheKey);
                }
            }

            // Cần fetch từ API
            itemsToFetch.Add(noiDung.MaHangHoa);
        }

        // Bước 2: Chỉ gọi API cho những cái chưa có trong cache hoặc đã hết hạn
        if (itemsToFetch.Any())
        {
            _isUpdatingSoLuongTon = true;
            try
            {
                // Gọi Batch API - MỘT LẦN DUY NHẤT cho những hàng hóa cần fetch
                var request = new GetSoDuHangHoaBatchRequest
                {
                    MaKho = nhapxuat.MaKho,
                    Ngay = ngay,
                    MaHangHoas = itemsToFetch.Distinct().ToList()
                };

                var soLuongTonDict = await dmhanghoaService.GetSoDuHangHoaBatchAsync(request);

                // Cập nhật số lượng tồn và cache
                foreach (var noiDung in nhapxuat.NoiDungNhapXuats)
                {
                    if (string.IsNullOrEmpty(noiDung.MaHangHoa))
                        continue;

                    string cacheKey = $"{cacheKeyPrefix}{noiDung.MaHangHoa}";

                    // Chỉ cập nhật những cái đã fetch
                    if (itemsToFetch.Contains(noiDung.MaHangHoa))
                    {
                        if (soLuongTonDict != null && soLuongTonDict.ContainsKey(noiDung.MaHangHoa))
                        {
                            noiDung.SoLuongTon = soLuongTonDict[noiDung.MaHangHoa];
                            // Lưu vào cache
                            _soLuongTonCache[cacheKey] = (noiDung.SoLuongTon, now);
                        }
                        else
                        {
                            // Nếu không tìm thấy trong kết quả, set về 0 và cache
                            noiDung.SoLuongTon = 0;
                            _soLuongTonCache[cacheKey] = (0, now);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                // Log error nếu cần, nhưng không throw để không làm crash ứng dụng
                Console.WriteLine($"Error updating SoLuongTon: {ex.Message}");
                // Set về 0 cho những cái fetch lỗi
                foreach (var maHangHoa in itemsToFetch)
                {
                    var noiDung = nhapxuat.NoiDungNhapXuats.FirstOrDefault(x => x.MaHangHoa == maHangHoa);
                    if (noiDung != null)
                    {
                        noiDung.SoLuongTon = 0;
                    }
                }
            }
            finally
            {
                _isUpdatingSoLuongTon = false;
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    // Method để invalidate cache khi cần (ví dụ: khi thay đổi kho hoặc ngày)
    private void InvalidateSoLuongTonCache(string maKho = null, DateTime? ngay = null)
    {
        if (maKho != null || ngay != null)
        {
            var keysToRemove = _soLuongTonCache.Keys
                .Where(k =>
                {
                    var parts = k.Split('_');
                    if (parts.Length < 3) return false;
                    
                    bool matchKho = maKho == null || parts[0] == maKho;
                    bool matchNgay = ngay == null || parts[1] == ngay.Value.ToString("yyyyMMdd");
                    
                    return matchKho && matchNgay;
                })
                .ToList();

            foreach (var key in keysToRemove)
            {
                _soLuongTonCache.Remove(key);
            }
        }
        else
        {
            // Clear all cache
            _soLuongTonCache.Clear();
        }
    }

