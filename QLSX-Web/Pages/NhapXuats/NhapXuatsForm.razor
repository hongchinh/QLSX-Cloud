        DanhMucHangHoaModel dmhanghoa = await dmhanghoaService.GetByCodeAsync(mahh);
        selectedNoiDung.IsEditing = false;
        if (dmhanghoa.Id > 0)
        {
            selectedNoiDung.TenHangHoa = dmhanghoa.TenHangHoa;
            selectedNoiDung.DonViTinh = dmhanghoa.DonViTinh;
            selectedNoiDung.DonGia = dmhanghoa.GiaXuat;
            selectedNoiDung.KhoRongTon = dmhanghoa.KhoRongTon;
            selectedNoiDung.ChieuDai = dmhanghoa.ChieuDai;
            selectedNoiDung.DMHangHoaId = dmhanghoa.Id;
            selectedNoiDung.DMDonViSuDungId = nhapxuat.DMDonViSuDungId;
