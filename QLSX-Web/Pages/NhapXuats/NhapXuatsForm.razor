            selectedNoiDung.MaNhom = dmhanghoa.MaNhomHang;
            selectedNoiDung.TenNhom = dmhanghoa.TenNhomHang;

            selectedNoiDung.KieuSong = dmhanghoa.KieuSong;
            selectedNoiDung.MaKieuSong = dmhanghoa.MaKieuSong;
            selectedNoiDung.LoaiTon = dmhanghoa.LoaiTon;
            selectedNoiDung.MaLoaiTon = dmhanghoa.MaLoaiTon;
            selectedNoiDung.DoDay = dmhanghoa.DoDay;
            selectedNoiDung.ChungLoai = dmhanghoa.ChungLoai;
            selectedNoiDung.MaChungLoai = dmhanghoa.MaChungLoai;
            selectedNoiDung.MauSac = dmhanghoa.MauSac;
            selectedNoiDung.MaMauSac = dmhanghoa.MaMauSac;

            selectedNoiDung.IsM2 = false;
            selectedNoiDung.IsMD = false;
            selectedNoiDung.IsSoLuong = false;

            if (dmhanghoa.MaNhomHang == "01")
            {
                selectedNoiDung.IsM2 = true;
                selectedNoiDung.TongChieuDai = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.TongDienTich = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.KhoRongTon * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.SoTien = dmhanghoa.ChieuDai * dmhanghoa.KhoRongTon * selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
            else if (dmhanghoa.MaNhomHang == "02")
            {

                selectedNoiDung.IsMD = true;
                selectedNoiDung.TongChieuDai = Math.Round(selectedNoiDung.SoLuong * selectedNoiDung.ChieuDai, 2);
                selectedNoiDung.TongDienTich = 0;
                selectedNoiDung.SoTien = dmhanghoa.ChieuDai * selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
            else
            {
                selectedNoiDung.IsSoLuong = true;
                selectedNoiDung.TongChieuDai = 0;
                selectedNoiDung.TongDienTich = 0;
                selectedNoiDung.SoTien = selectedNoiDung.SoLuong * selectedNoiDung.DonGia;
            }
        }
        // Lấy số lượng tồn - Gọi trực tiếp (không debounce) để hiển thị ngay
        if (!string.IsNullOrEmpty(selectedNoiDung.MaHangHoa) && !string.IsNullOrEmpty(nhapxuat.MaKho))
