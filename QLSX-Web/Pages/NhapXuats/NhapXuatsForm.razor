            {
                DanhMucKhachHangModel dmKH = await dmkhachhangService.GetByCodeAsync(nhapxuat.MaDonVi);
                if (dmKH == null || dmKH.Id == 0)
                {
                    Snackbar.Add($"Mã đơn vị '{nhapxuat.MaDonVi}' không tồn tại trong danh mục đơn vị", Severity.Error);
                    return;
                }
            }
            
            // Validate MaHangHoa tồn tại trong bảng DanhMucHangHoa cho tất cả các dòng chi tiết
            if (nhapxuat.NoiDungNhapXuats != null && nhapxuat.NoiDungNhapXuats.Any())
            {
                foreach (var noiDung in nhapxuat.NoiDungNhapXuats)
