        nhapxuat.NoiDungNhapXuats.Add(newitem);
        await Task.Delay(50);
        table.SetSelectedItem(newitem);
        table.SetEditingItem(newitem);
        StateHasChanged();

    }

    private void DeleteRow(NoiDungNhapXuatModel item)
