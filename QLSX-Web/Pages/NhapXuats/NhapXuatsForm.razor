    private async Task SuaClickCallBack(bool isRead)
    {
        if (isRead)
        {
            NhapXuatSearchRequest request = new NhapXuatSearchRequest();
            request.Loai = nhapxuat.Loai;
            request.Id = nhapxuat.Id;
            request.DMDonViSuDungId = nhapxuat.DMDonViSuDungId;
            var nhapxuatnew = await nhapxuatService.GetNhapXuatByIDAsync(request);
            
            // Lưu MaDonVi cũ để so sánh
            var oldMaDonVi = nhapxuat.MaDonVi;
            nhapxuat = mapper.Map<NhapXuatModel>(nhapxuatnew);
            
            // Reset selectedKhachHang nếu MaDonVi thay đổi hoặc không khớp
            if (selectedKhachHang != null && 
                (oldMaDonVi != nhapxuat.MaDonVi || selectedKhachHang.MaDonVi != nhapxuat.MaDonVi))
            {
                selectedKhachHang = null;
            }
            
            // Load selectedKhachHang nếu có MaDonVi nhưng chưa được load
            if (!string.IsNullOrEmpty(nhapxuat.MaDonVi) && selectedKhachHang == null)
            {
                try
                {
                    var dmKH = await dmkhachhangService.GetByCodeAsync(nhapxuat.MaDonVi);
                    if (dmKH != null && dmKH.Id > 0)
                    {
                        selectedKhachHang = dmKH;
                        // Force update UI sau khi load để MudAutocomplete hiển thị
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading selectedKhachHang: {ex.Message}");
                }
            }
            
            // Cập nhật số lượng tồn khi load dữ liệu ban đầu
            await UpdateSoLuongTonForAllRows();
        }
        IsReadOnly = isRead;
        StateHasChanged();
    }
