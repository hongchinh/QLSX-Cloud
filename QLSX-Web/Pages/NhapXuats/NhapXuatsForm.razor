    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            table.SetRowsPerPage(20);
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");
            saveAndCreate = await localStorageService.GetItemAsync<bool>($"{nhapxuat.Loai}-SaveStatus");
            var user = (await authenticationStateTask).User;
            mdvsd = user.FindFirst(c => c.Type == "TenantId")?.Value ?? "0";
            var hgrid = await JSRuntime.InvokeAsync<WindowDimensions>("setElementSizeByClass", "clsFormNX");
            HeightGrid = hgrid.Height;
            await GetSoDuCongNo();
            
            // Load selectedKhachHang nếu có MaDonVi nhưng chưa được load (fallback nếu OnParametersSetAsync chưa load)
            if (!string.IsNullOrEmpty(nhapxuat.MaDonVi) && selectedKhachHang == null)
            {
                try
                {
                    var dmKH = await dmkhachhangService.GetByCodeAsync(nhapxuat.MaDonVi);
                    if (dmKH != null && dmKH.Id > 0)
                    {
                        selectedKhachHang = dmKH;
                        // Force update UI sau khi load
                        await InvokeAsync(StateHasChanged);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading selectedKhachHang in OnAfterRenderAsync: {ex.Message}");
                }
            }
            
            // Cập nhật số lượng tồn khi load dữ liệu ban đầu (nếu có dữ liệu)
            if (nhapxuat.NoiDungNhapXuats != null && nhapxuat.NoiDungNhapXuats.Any(x => !string.IsNullOrEmpty(x.MaHangHoa)) && !string.IsNullOrEmpty(nhapxuat.MaKho))
            {
                await UpdateSoLuongTonForAllRows();
            }
            await InvokeAsync(StateHasChanged);
        }
        await base.OnAfterRenderAsync(firstRender);
    }

