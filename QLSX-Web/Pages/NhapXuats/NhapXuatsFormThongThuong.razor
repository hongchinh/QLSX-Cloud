    private async Task TimNhanhCalback(int id)
    {
        var item = await nhapxuatService.GetByIdAsync(id);
        if (item.Id == 0)
        {
            return;
        }
        nhapxuat = mapper.Map<NhapXuatModel>(item);
        StateHasChanged();
    }
