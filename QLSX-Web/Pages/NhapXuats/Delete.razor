@inject ILogger<Delete> Logger
@inject IJSRuntime JSRuntime
@inject INhapXuatsService<NhapXuatModel> nhapxuatService
@inject NavigationManager navigationManager

@inherits QLSX.Web.Helpers.BlazorComponent

@namespace QLSX.Web.Pages.NhapXuatPage

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1" />
            Xóa
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="4">
                Số chứng từ
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.SoChungTu</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Ngày CT
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.NgayCT</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Mã đơn vị
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.MaDonVi</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Tên đơn vị
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.TenDonVi</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Địa chỉ
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.DiaChi</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Số tiền hàng
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.NoiDungNhapXuats.Sum(p=>p.SoTien).ToString("###,###")</MudText>
            </MudItem>
            <MudItem xs="12" md="4">
                Số tiền TT
            </MudItem>
            <MudItem xs="12" md="8">
                <MudText Typo="Typo.body1">@server.SoTienTT.ToString("###,###")</MudText>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Filled" Color="Color.Error">Bỏ qua</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => DeleteClick(server.Id))" Class="me-3">Xóa</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter] MudDialogInstance MudDialog { get; set; }

    [Parameter] public NhapXuatModel server { get; set; } = new NhapXuatModel();

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private async void DeleteClick(int id)
    {
        var isDelete = await nhapxuatService.DeleteAsync(id);
        MudDialog.Close(DialogResult.Ok(isDelete));
    }
}
