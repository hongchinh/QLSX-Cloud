@page "/nhapxuats"
@* @using IgniteUI.Blazor.Controls *@
@using QLSX.Shared.Models
@using QLSX.Web.Data
@using QLSX.Web.Services
@using Blazored.LocalStorage
@using OfficeOpenXml
@using OfficeOpenXml.Style
@using Microsoft.Extensions.Configuration;
@using AutoMapper

@inject INhapXuatsService<PhieuNhapXuatAllModel> nhapxuatService
@inject IUserService userService
@inject IDMTinhTrangService<QLSX.Shared.Models.DMTinhTrangModel> dmTinhTrangService
@inject IDMKhoHangService<DanhMucKhoHangModel> dmkhohangService
@inject IDMLoaiTienService<DanhMucLoaiTienModel> dmLoaiTienService
@inject IMapper mapper;

@inject NavigationManager navigationManager
@inject ILocalStorageService localStorageService
@inject AppService AppService
@inject IJSRuntime JSRuntime
@implements IDisposable
@attribute [Authorize]
@inherits QLSX.Web.Helpers.BlazorComponent
@inject IDialogService DialogService
@inject IToastService toastService
@inject IPhanQuyenSuDungService< QLSX.Shared.Models.QuyenSuDungModel> permisstionService
@inject ISnackbar Snackbar
@inject IConfiguration configuration
@inject ISettingService<QLSX.Shared.Models.SettingModel> itemService


@namespace QLSX.Web.Pages.NhapXuatPage
<div class="form-group">
    <MudBreadcrumbs Items="_items" Style="padding:0px !important"></MudBreadcrumbs>
    <EditForm id="idForm" Model="@itemRequest" OnValidSubmit="@SearchClick">
        <MudPaper Elevation="25" Class="py-8 px-8" Style="padding-top:2px !important">
            <MudGrid Spacing="1">
                <MudItem xs="12" sm="3" lg="2">
                    <MudTextField @bind-Value="itemRequest.SoPhieu" Label="Số phiếu" Margin="Margin.Dense" Variant="Variant.Outlined"></MudTextField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="string" Margin="Margin.Dense" Label="Loại" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.Loai" Variant="Variant.Outlined">
                        <MudSelectItem T="string" Value="@("")"> </MudSelectItem>
                        <MudSelectItem T="string" Value="@("nhap")">Phiếu nhập </MudSelectItem>
                        <MudSelectItem T="string" Value="@("xuat")">Phiếu xuất</MudSelectItem>
                        <MudSelectItem T="string" Value="@("nhaptra")">Phiếu nhập trả</MudSelectItem>
                        <MudSelectItem T="string" Value="@("xuattra")">Phiếu xuất trả</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Số tiền từ" @bind-Value="itemRequest.SoTien_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Số tiền đến" @bind-Value="itemRequest.SoTien_To" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Số tiền TT từ" @bind-Value="itemRequest.SoTienTT_From" Editable="true"></MudNumericField>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" Label="Số tiền TT đến" @bind-Value="itemRequest.SoTienTT_To" Editable="true"></MudNumericField>
                </MudItem>

                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="string" Margin="Margin.Dense" Label="Kho hàng" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.MaKhoHang" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("")">Tất cả</MudSelectItem>
                        @if (lstKhoHang != null)
                        {
                            @foreach (var cnt in lstKhoHang)
                            {
                                <MudSelectItem Value="@cnt.MaKho"> @cnt.TenKho </MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudSelect T="int" Margin="Margin.Dense" Label="Loại tiền" AnchorOrigin="Origin.BottomCenter" @bind-Value="itemRequest.DMLoaiTienId" Variant="Variant.Outlined">
                        <MudSelectItem Value="0">Tất cả</MudSelectItem>
                        @if (lstLoaiTien != null)
                        {
                            @foreach (var cnt in lstLoaiTien)
                            {
                                <MudSelectItem Value="@cnt.Id">@cnt.LoaiTien</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" Label="Từ ngày" @bind-Date="@itemRequest.NgayLap_From" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>
                <MudItem xs="12" sm="3" lg="2">
                    <MudDatePicker Margin="Margin.Dense" Label="Đến ngày" @bind-Date="@itemRequest.NgayLap_To" Variant="Variant.Outlined" Editable="true" DateFormat="dd/MM/yyyy"></MudDatePicker>
                </MudItem>

                <MudItem xs="12" sm="6" lg="4">
                    <MudButton Class="mt-3" ButtonType="ButtonType.Submit" Size="MudBlazor.Size.Large" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Search" Color="MudBlazor.Color.Primary">Tìm kiếm</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </EditForm>

    <MudToolBar id="idToolbar">
        <MudMenu Label="Tạo phiếu" Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="MudBlazor.Color.Secondary">
            <MudMenuItem OnClick="CreateClickNhap" Disabled="@(!quyenSuDungNhap.Them)">Phiếu nhập</MudMenuItem>
            <MudMenuItem OnClick="CreateClickXuat" Disabled="@(!quyenSuDungXuat.Them)">Phiếu xuất</MudMenuItem>
            <MudMenuItem OnClick="CreateClickNhapTra" Disabled="@(!quyenSuDungNhapTra.Them)">Phiếu nhập trả</MudMenuItem>
            <MudMenuItem OnClick="CreateClickXuatTra" Disabled="@(!quyenSuDungXuatTra.Them)">Phiếu xuất trả</MudMenuItem>
        </MudMenu>
        <MudButton Class="ml-1" Variant="Variant.Filled" @onclick="@(async() => await ExportExcel())" StartIcon="@Icons.Material.Filled.ImportExport" Color="MudBlazor.Color.Secondary">Excel</MudButton>
    </MudToolBar>
    <MudDataGrid @ref="table" FixedHeader="true" T="PhieuNhapXuatAllModel"
                 ServerData="@(new Func<GridState<PhieuNhapXuatAllModel>, Task<GridData<PhieuNhapXuatAllModel>>>(ServerReloadNew))"
                 Filterable="true"
                 Dense="true"
                 Height="@(HeightGrid ==0 ? "": HeightGrid.ToString () + "px" )"
                 FilterMode="DataGridFilterMode.Simple"
                 ColumnResizeMode="ResizeMode.Container"
                 SortMode="MudBlazor.SortMode.Single"
                 HorizontalScrollbar="true"
                 FilterCaseSensitivity="DataGridFilterCaseSensitivity.Default">
        <Columns>
            <TemplateColumn Title="Loại" Style="width: 50px">
                <CellTemplate>
                    @{
                        var loaiDisplay = context.Item.Loai?.ToLower() switch
                        {
                            "nhap" => "Phiếu nhập",
                            "xuat" => "Phiếu xuất",
                            "nhaptra" => "Phiếu nhập trả",
                            "xuattra" => "Phiếu xuất trả",
                            "dieuchuyen" => "Điều chuyển",
                            "donhang" => "Đơn hàng",
                            _ => context.Item.Loai ?? ""
                        };
                    }
                    <MudText>@loaiDisplay</MudText>
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.NgayCT" Title="Ngày CT">
                <CellTemplate>
                    <MudText>@context.Item.NgayCT?.ToString("dd/MM/yyyy")</MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.SoChungTu" Title="Số CT">
                <CellTemplate>
                    @if (context.Item.Loai?.ToLower() == "nhap")
                    {
                        <MudButton Disabled="@(!quyenSuDungNhap.Sua)" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="@(async ()=> await SuaClick(context.Item.Loai, context.Item.Id))">@context.Item.SoChungTu</MudButton>
                    }
                    else @if (context.Item.Loai?.ToLower() == "xuat")
                    {
                        <MudButton Disabled="@(!quyenSuDungXuat.Sua)" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="@(async ()=> await SuaClick(context.Item.Loai, context.Item.Id))">@context.Item.SoChungTu</MudButton>
                    }
                    else @if (context.Item.Loai?.ToLower() == "donhang")
                    {
                        <MudButton Disabled="@(!quyenSuDungXuat.Sua)" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="@(async ()=> await SuaClick(context.Item.Loai, context.Item.Id))">@context.Item.SoChungTu</MudButton>
                    }
                    else @if (context.Item.Loai?.ToLower() == "nhaptra")
                    {
                        <MudButton Disabled="@(!quyenSuDungNhapTra.Sua)" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="@(async ()=> await SuaClick(context.Item.Loai, context.Item.Id))">@context.Item.SoChungTu</MudButton>
                    }
                    else @if (context.Item.Loai?.ToLower() == "xuattra")
                    {
                        <MudButton Disabled="@(!quyenSuDungXuatTra.Sua)" Color="MudBlazor.Color.Primary" Size="MudBlazor.Size.Small" OnClick="@(async ()=> await SuaClick(context.Item.Loai, context.Item.Id))">@context.Item.SoChungTu</MudButton>
                    }
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.MaDoiTuong" Title="Mã đơn vị" />
            <PropertyColumn Property="x => x.TenDoiTuong" Title="Tên đơn vị" />
            <PropertyColumn Property="x => x.DiaChiDoiTuong" Title="Địa chỉ" />
            <PropertyColumn Property="x => x.DienGiai" Title="Ghi chú" />
            <PropertyColumn Property="x => x.SoTien" Title="Số tiền" CellStyleFunc="@_cellNumberStyleFunc">
                <CellTemplate>
                    <MudText>@(context.Item.SoTien?.ToString("###,###") ?? "0")</MudText>
                </CellTemplate>
                <FooterTemplate>
                    <MudText Style="font-weight: bold;text-align: end;"> @SumSoTien.ToString("###,###") </MudText>
                </FooterTemplate>
            </PropertyColumn>

            <PropertyColumn Property="x => x.TenKho" Title="Tên kho" />
            <TemplateColumn StickyRight="true">
                <CellTemplate>
                    @if (context.Item.Loai?.ToLower() == "nhap")
                    {
                        @if (quyenSuDungNhap.XemIn)
                        {
                            <MudIconButton Style="min-width:30px;width:30px"
                                           Target="_blank"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Success"
                                           OnClick="@(async ()=> await PrintClick(@context.Item.Id, context.Item.Loai ?? ""))"
                                           Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                        @if (quyenSuDungNhap.Xoa)
                        {
                            <MudIconButton OnClick="@(async ()=> await DeleteClick(@context.Item))"
                                           Style="min-width:30px;width:30px;text-transform:none"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Error"
                                           Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                    }
                    @if (context.Item.Loai?.ToLower() == "xuat")
                    {
                        @if (quyenSuDungXuat.XemIn)
                        {
                            <MudIconButton Style="min-width:30px;width:30px"
                                           Target="_blank"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Success"
                                           OnClick="@(async ()=> await PrintClick(@context.Item.Id, context.Item.Loai ?? ""))"
                                           Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                        @if (quyenSuDungXuat.Xoa)
                        {
                            <MudIconButton OnClick="@(async ()=> await DeleteClick(@context.Item))"
                                           Style="min-width:30px;width:30px;text-transform:none"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Error"
                                           Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                    }
                    @if (context.Item.Loai?.ToLower() == "nhaptra")
                    {
                        @if (quyenSuDungNhapTra.XemIn)
                        {
                            <MudIconButton Style="min-width:30px;width:30px"
                                           Target="_blank"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Success"
                                           OnClick="@(async ()=> await PrintClick(@context.Item.Id, context.Item.Loai ?? ""))"
                                           Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                        @if (quyenSuDungNhapTra.Xoa)
                        {
                            <MudIconButton OnClick="@(async ()=> await DeleteClick(@context.Item))"
                                           Style="min-width:30px;width:30px;text-transform:none"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Error"
                                           Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                    }
                    @if (context.Item.Loai?.ToLower() == "xuattra")
                    {
                        @if (quyenSuDungXuatTra.XemIn)
                        {
                            <MudIconButton Style="min-width:30px;width:30px"
                                           Target="_blank"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Success"
                                           OnClick="@(async ()=> await PrintClick(@context.Item.Id, context.Item.Loai ?? ""))"
                                           Icon="@Icons.Material.Filled.Print" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                        @if (quyenSuDungXuatTra.Xoa)
                        {
                            <MudIconButton OnClick="@(async ()=> await DeleteClick(@context.Item))"
                                           Style="min-width:30px;width:30px;text-transform:none"
                                           Variant="Variant.Text"
                                           Color="MudBlazor.Color.Error"
                                           Icon="@Icons.Material.Filled.Delete" Size="MudBlazor.Size.Small">
                            </MudIconButton>
                        }
                    }
                </CellTemplate>
            </TemplateColumn>

        </Columns>
        <NoRecordsContent>
            <MudText>Không có bản ghi nào tìm thấy, hoặc bạn không có quyền xem dữ liệu</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudText>Đang tải dữ liệu</MudText>
        </LoadingContent>
        <PagerContent>
            <MudDataGridPager T="PhieuNhapXuatAllModel" RowsPerPageString="Số dòng mỗi trang" />
        </PagerContent>

    </MudDataGrid>

</div>

<LoadingProgress IsLoading="isLoading"></LoadingProgress>

@code {

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }
    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDung { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungNhap { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungXuat { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungNhapTra { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };

    private QLSX.Shared.Models.QuyenSuDungModel quyenSuDungXuatTra { get; set; } =
        new QLSX.Shared.Models.QuyenSuDungModel() { Sua = false, Them = false, Xoa = false, XemIn = false, Selectted = false };


    public PhieuNhapXuatAllModel nhapxuat { get; set; }
    public List<PhieuNhapXuatAllModel> nhapxuatList { get; set; }
    public List<PhieuNhapXuatAllModel> filterednhapxuatList { get; set; }

    public GetAllResponsePaged<PhieuNhapXuatAllModel> lsResponses { get; set; }
    public NhapXuatSearchRequest itemRequest { get; set; }
    public bool IsVisible { get; set; }
    public bool IsGridViewFiltered { get; set; }
    bool isLoading = true;
    int Stt = 1;
    public UserModel UserLogin;
    public List<DanhMucKhoHangModel> lstKhoHang { get; set; }
    public List<DanhMucLoaiTienModel> lstLoaiTien { get; set; }
    int currentPage = 0;
    int pageSize = 10;
    int totalCount = 0;

    public string selecttedKhohang { get; set; }
    public int selecttedLoaiTien { get; set; }
    public string selecttedLoai { get; set; }

    private IEnumerable<PhieuNhapXuatAllModel> pagedData;
    private MudDataGrid<PhieuNhapXuatAllModel> table;
    public double SumSoTien { get; set; }
    public double SumSoTienTT { get; set; }

    private int totalItems;
    private string searchString = null;
    public string hostReport { get; set; }
    public int HeightGrid { get; set; } = 277;

    public QLSX.Shared.Models.SettingModel itemSetting { get; set; } = new QLSX.Shared.Models.SettingModel { LoaiNhapXuat = 1 };
    private List<BreadcrumbItem> _items = new List<BreadcrumbItem>
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Tra cứu nhập xuất",href: null, disabled: true)
    };
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
    async Task LoadData()
    {
        lsResponses = new GetAllResponsePaged<PhieuNhapXuatAllModel>();

        var user = (await authenticationStateTask).User;
        var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
        UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
        quyenSuDung = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "tracuunhapxuat");
        quyenSuDungNhap = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhap");
        quyenSuDungXuat = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuat");
        quyenSuDungNhapTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "nhaptra");
        quyenSuDungXuatTra = await permisstionService.GetQuyenByUserIdAsync(int.Parse(UserId), "xuattra");

        if (quyenSuDung.Selectted)
        {
            lsResponses = await nhapxuatService.GetAllPagedAsync(itemRequest);
        }
        IEnumerable<PhieuNhapXuatAllModel> data = lsResponses.Items;

        totalItems = lsResponses.TotalRecords;
        SumSoTien = lsResponses.SumSoTien1;
        SumSoTienTT = lsResponses.SumSoTien2;
        pagedData = data ?? new List<PhieuNhapXuatAllModel>();
        totalCount = lsResponses.TotalRecords;


        StateHasChanged();
    }


    protected override async Task OnInitializedAsync()
    {
        lsResponses = new GetAllResponsePaged<PhieuNhapXuatAllModel>();
        nhapxuat = new PhieuNhapXuatAllModel();
        nhapxuatList = filterednhapxuatList = new List<PhieuNhapXuatAllModel>();
        itemRequest = new NhapXuatSearchRequest()
            {
                DMDonViSuDungId = AppService.DMDonViSuDungId,
                PageSize = 20,
                Page = 0,
                TotalPages = 0

            };


        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isLoading = true;
            lstKhoHang = await dmkhohangService.GetAllAsync();
            lstLoaiTien = await dmLoaiTienService.GetAllAsync();
            hostReport = configuration.GetValue<string>("AppSettings:ReportUrl");
            var user = (await authenticationStateTask).User;
            var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
            UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
            itemSetting = await itemService.GetByIdAsync(int.Parse(UserId));
            var dimension = await JSRuntime.InvokeAsync<WindowDimensions>("getWindowSize");
            HeightGrid = dimension.Height - dimension.FormHeight - dimension.ToolbarHeight - 145;

            isLoading = false;
            StateHasChanged();
        }
        //await JSRuntime.InvokeAsync<object>("TestDataTablesAdd", "#GridTable");
        await base.OnAfterRenderAsync(firstRender);
    }


    /// <summary>
    /// Here we simulate getting the paged, filtered and ordered data from the server
    /// </summary>
    private async Task<GridData<PhieuNhapXuatAllModel>> ServerReloadNew(GridState<PhieuNhapXuatAllModel> state)
    {
        var sort = state.SortDefinitions.ToList();
        itemRequest.Page = state.Page;
        if (sort.Count > 0)
        {
            for (int i = 0; i < sort.Count; i++)
            {
                itemRequest.SortLable = sort[i].SortBy;
                itemRequest.SortDirection = sort[i].Descending ? QLSX.Shared.Enums.SortDirection.Descending : QLSX.Shared.Enums.SortDirection.Ascending;
            }
        }
        itemRequest.Page = state.Page;
        itemRequest.PageSize = state.PageSize;
        await LoadData();
        StateHasChanged();
        return new GridData<PhieuNhapXuatAllModel>() { TotalItems = totalItems, Items = pagedData };
    }


    public void Dispose()
    {
    }

    private async Task PrintClick(int id, string loai)
    {
        @if (loai == "nhap")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=PhieuNhapKho&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "xuat")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=PhieuXuatKho&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "nhaptra")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=PhieuNhapTra&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "xuattra")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=PhieuXuatTra&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");

        }

    }
    private async Task PrintClickTon(int id, string loai)
    {
        @if (loai == "nhap")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=rptPhieuNhapTon&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "xuat")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=rptPhieuXuatTon&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "nhaptra")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=rptPhieuNhapTraTon&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");
        }
        else if (loai == "xuattra")
        {
            string strURL = hostReport + "/Reports/Viewer?ReportFileName=rptPhieuXuatTraTon&id=" + id;
            await JSRuntime.InvokeVoidAsync("open", strURL, "_blank");

