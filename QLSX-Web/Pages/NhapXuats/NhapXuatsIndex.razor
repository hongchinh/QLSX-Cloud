    private async Task DeleteClick(PhieuNhapXuatAllModel nhapxuat)
    {
        var parameters = new DialogParameters { ["server"] = nhapxuat };
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true, DisableBackdropClick = true };
        var dialog = DialogService.Show<Delete>("Xóa", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            //In a real world scenario we would reload the data from the source here since we "removed" it in the dialog already.
            var deletedServer = (bool)result.Data;
            if (deletedServer)
            {
                await table.ReloadServerData();
                Snackbar.Clear();
                Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopRight;
                string msg = $"Bạn vừa Xóa " + nhapxuat.SoChungTu + "";
                Snackbar.Add(msg, Severity.Success);
            }
            else
            {
                Snackbar.Add("Xảy ra lỗi khi Xóa " + nhapxuat.SoChungTu, Severity.Error);
            }

        }
    }

