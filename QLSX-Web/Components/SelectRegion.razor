@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime;
@namespace QLSX.Web.Components
@inject IDMTinhThanhService<QLSX.Shared.Models.DanhMucTinhThanhModel> tinhthanhService
<select class="form-control col-12" @onchange="OnChangeEvent">
    @if (@items != null)
    {
<option value="">Chọn tỉnh thành</option>
                @foreach (var item in @items)
                {
                    @if (IdSelected == item.Id)
                    {
                    <option value="@item.Id" selected>@item.TenTinh  </option>
                    }
                    else
                    {
                    <option value="@item.Id">@item.TenTinh  </option>
                    }

}}
</select>

@code { [Parameter]
    public EventCallback<ChangeEventArgs> OnChangeEvent { get; set; }

    [Parameter]
    public int IdSelected { get; set; }

    public List<QLSX.Shared.Models.DanhMucTinhThanhModel> items { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && @items == null)
        {
            try
            {
                items = await tinhthanhService.GetAllAsync();
                StateHasChanged();
            }
            catch (Exception)
            {

                //throw;
            }

        }
    } }
