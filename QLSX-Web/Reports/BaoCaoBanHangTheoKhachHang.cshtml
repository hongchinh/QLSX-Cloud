@using QLSX.Shared.Data.Responses
@using QLSX.Shared.Data.Responses.BaoCao

@model ReportResponseBase<BaoCaoDoanhThuResponse>

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-grid.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-reboot.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-theme.css"
    />
    <link
      rel="stylesheet"
      href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="@Model.Host/css/report.css" />
    <title>Báo Cáo Bán Hàng Theo Khách Hàng</title>
  </head>
  <body>
    Html.RenderPartial("Header", @Model.ThongTin);
    <div class="row" style="margin-top: 10px !important">
      <div class="col-md-12" style="text-align: center">
        <h1 style="color: blue">Báo Cáo Bán Hàng Theo Khách Hàng</h1>
      </div>
    </div>
    <div class="row" style="margin-top: 10px !important">
      <div class="col-md-12" style="text-align: center">
        <span><i>Từ ngày   Đến ngày:  </i></span>
      </div>
    </div>

    <div class="row" style="margin-top: 10px !important">
      <div class="col-md-12">
        <span>@Model.ListData[0]?.TenKhachHang</span>
      </div>
    </div>

    <div>
      @if (Model.ListData.Count > 0)
      {
        @foreach(var group in Model.ListData.GroupBy(x=>x.TenKhachHang , (key, grp) => new { Name= key,List= grp})) {
        <table class="table table-bordered">
          <thead>
            <tr>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số hóa đơn</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Ngày hóa đơn</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số tiền hàng</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Phí vận chuyển</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Tổng cộng</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in group.List)
            {
            <tr>
              <th>@item.SoHoaDon</th>
              <th>@item.MaHangHoa </th>
              <th>@item.DonGia.ToString("###,###.##")</th>
              <th>@item.DonGia.ToString("###,###.##")</th>
              <th>@item.DonGia.ToString("###,###.##")</th>
            </tr>
            }
            <tr>
              <th colspan="2">Tổng cộng</th>
              <th style="font-weight: bold; text-align: right">
                23000000
              </th>
              <th>
                5000000
              </th> 
              <th style="font-weight: bold; text-align: right">@Model.ListData?.Sum(x=> x.DonGia).ToString("###,###.##") </th>
            </tr>
          </tbody>
        </table>
        }
      } else {
        <table class="table table-bordered">
          <thead>
            <tr>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số hóa đơn</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Ngày hóa đơn</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số tiền hàng</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Phí vận chuyển</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Tổng cộng</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th style="font-weight: bold; text-align: center" colspan="5">
                Không có dữ liệu
              </th>
            </tr>
          </tbody>
        </table>
      }
      <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
         <tr>
          <td colspan="3" class="text-right"><b>@Model.ThongTin.ChucDanhLapBieu </b></td>
        </tr>
      </table>
    </div>
  </body>
</html>

