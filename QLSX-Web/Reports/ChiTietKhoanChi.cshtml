@using QLSX.Shared.Data.Responses
@using QLSX.Shared.Data.Responses.BaoCao

@model ReportResponseBase<ChiTietKhoanChiResponse>

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-grid.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-reboot.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-theme.css" />
	<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="@Model.Host/css/report.css" />
	<title>Sổ chi tiết theo khoản chi</title>
</head>
<body>
	@if (Model.ListData.Count > 0)
		{
			
		@foreach(var group in Model.ListData.GroupBy(x=>x.TenKhoanChi, (key, grp) => new { Name= key,List= grp})){
				Html.RenderPartial("Header", @Model.ThongTin);
				<div class="row" style="margin-top:10px !important">
				<div class="col-md-12" style="text-align:center"> 
						<h3>SỔ CHI TIẾT THEO KHOẢN CHI</h3>
						<div class="d-flex" style="margin-top:-10px">Tên khoản chi: <b style="color:blue"> @group.Name </b></div>
				</div>
				</div>
				<div class="row" style="margin-top:5px !important">
					<div class="col-md-12" style="text-align:center"> <i> @Model.ListData?.First()?.ThoiGian </i></div>
				</div>
				 
			 
			  <table class="table table-bordered">
			   <thead>
				<tr>
					 <th class="text-center">Ngày CT</th>
					 <th class="text-center">Số phiếu</th>
					 <th class="text-center w35">DIỄN GIẢI</th>
					 <th class="text-center ">Tên đơn vị</th>
					 <th class="text-center ">Số tiền</th>
					 <th class="text-center">Khoản mục chi</th>
				</tr>
			   </thead>
			   <tbody>
						 
					@foreach (var item in group.List)
					{
					<tr>  
						<th style="font-weight:normal">@item.NgayCT.ToString("dd/MM/yyyy") </th>
						<th style="font-weight:normal;">@item.SoCT </th>
						<th style="font-weight:normal;">@item.DienGiai </th>
						<th style="font-weight:normal; text-align: right;">@item.TenDonVi</th>
						<th style="font-weight:normal; text-align: right;">@item.SoTien.ToString("###,###.##")</th>
						<th style="font-weight:normal; text-align: right;">@item.TenKhoanChi</th>
					</tr>
					}
					<tr>
						<th style="font-weight:bold; text-align: right" colspan="4"> Tổng cộng phát sinh </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoTien).ToString("###,###.##") </th>
						<th style="font-weight:normal; text-align: right"></th>
					</tr>					
							 
			   </tbody>
			  </table>
			  <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
				 <tr>
					 <td width="33%">  </td>
					 <td width="33%">  </td>
					 <td width="33%"> @Model.ThongTin.NgayThangLB </td>
				 </tr>
				  <tr>
					 <td> <b> @Model.ThongTin.ChucDanhThuTruong</b> </td>
					 <td> <b>@Model.ThongTin.ChucDanhKeToan</b> </td>
					 <td> <b>@Model.ThongTin.ChucDanhLapBieu </b></td>
				 </tr>
			 </table>
			 <p style="page-break-before: always;"></p>
		}
		}else{
			 Html.RenderPartial("Header", @Model.ThongTin);
			<div class="row" style="margin-top:10px !important">
		   <div class="col-md-12" style="text-align:center"> <h1>Sổ chi tiết khoản chi </h1> </div>
		  </div>
		  <div class="row" style="margin-top:5px !important">
		   <div class="col-md-12" style="text-align:center"> <i> </i></div>
		  </div>

		  <table class="table table-bordered">
		   <thead>
			<tr>
				 <th class="text-center">Ngày CT</th>
				 <th class="text-center">Số phiếu</th>
				 <th class="text-center w35">DIỄN GIẢI</th>
				 <th class="text-center ">Tên đơn vị</th>
				 <th class="text-center ">Số tiền</th>
				 <th class="text-center">Khoản mục chi</th>
			</tr>
		   </thead>
			<tbody>
				<tr><td colspan="6" style="font-weight:bold; text-align: center"> Không có dữ liệu </td> </tr>
			</tbody>
		  </table>
		  <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
			 <tr>
				 <td width="33%">  </td>
				 <td width="33%">  </td>
				 <td width="33%"> @Model.ThongTin.NgayThangLB </td>
			 </tr>
			  <tr>
				 <td> <b> @Model.ThongTin.ChucDanhThuTruong</b> </td>
				 <td> <b>@Model.ThongTin.ChucDanhKeToan</b> </td>
				 <td> <b>@Model.ThongTin.ChucDanhLapBieu </b></td>
			 </tr>
		 </table>
		}
	
	
	  
</body>
</html>
