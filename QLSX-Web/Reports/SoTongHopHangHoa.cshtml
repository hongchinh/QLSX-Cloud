@using QLSX.Shared.Data.Responses
@using QLSX.Shared.Data.Responses.BaoCao

@model ReportResponseBase<SoTongHopHangHoaResponse>

<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-grid.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-reboot.css" />
	<link rel="stylesheet" href="@Model.Host/lib/bootstrap/dist/css/bootstrap-theme.css" />
	<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css">

	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="@Model.Host/css/report.css" />
	<title>Sổ tổng hợp hàng hóa</title>
</head>
<body>
	@if (Model.ListData.Count > 0)
		{
			
		@foreach(var group in Model.ListData.GroupBy(x=>x.MaKho, (key, grp) => new { Name= key,List= grp})){
				await	Html.RenderPartialAsync("Header", @Model.ThongTin);
				<div class="row" style="margin-top:10px !important">
				<div class="col-md-12" style="text-align:center"> 
						<h3>SỔ TỔNG HỢP HÀNG HÓA</h3>
						<div class="d-flex" style="margin-top:-10px">Tên kho: <b style="color:blue"> @group.Name </b></div>
				</div>
				</div>
				<div class="row" style="margin-top:5px !important">
					<div class="col-md-12" style="text-align:center"> <i> @Model.ListData?.First()?.ThoiGian </i></div>
				</div>
				 
			 
			  <table class="table table-bordered">
			   <thead>
				<tr>
					 <th class="text-center w-150" rowspan="2">Mã Hàng hóa</th>
					 <th class="text-center w25" rowspan="2">Tên hàng hóa</th>
					 <th class="text-center " rowspan="2">DVT</th>
					 <th class="text-center " colspan="2" >NHẬP</th>
					 <th class="text-center " colspan="2">XUẤT</th>
					 <th class="text-center" colspan="2"> TỒN</th>
				</tr>
				<tr>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
				</tr>
			   </thead>
			   <tbody>
					
				   <tr>
						<th style="font-weight:bold; text-align: right" colspan="3"> Tổng cộng</th>
						<th style="font-weight:bold; text-align: right"></th>
						<th style="font-weight:bold; text-align: right"> </th>
						<th style="font-weight:bold; text-align: right"></th>
						<th style="font-weight:bold; text-align: right"> </th>
						<th style="font-weight:bold; text-align: right">@group.List?.First().SoLuongDau.ToString("###,###.##") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.First().SoTienDau.ToString("###,###") </th>
					</tr>		
					@foreach (var item in group.List)
					{
					<tr>  
						<th>@item.MaHangHoa </th>
						<th>@item.TenHangHoa </th>
						<th>@item.DonViTinh </th>
						<th class="text-right">@item.SoLuongNhap.ToString("###,###.##") </th>
						<th class="text-right">@item.SoTienNhap.ToString("###,###") </th>
						<th class="text-right">@item.SoLuongXuat.ToString("###,###.##") </th>
						<th class="text-right">@item.SoTienXuat.ToString("###,###") </th>
						<th class="text-right">@item.SoLuongTon.ToString("###,###.##") </th>
						<th class="text-right">@item.SoTienTon.ToString("###,###") </th>
					</tr>
					}
					<tr>
						<th style="font-weight:bold; text-align: right" colspan="3"> Tổng cộng</th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoLuongNhap).ToString("###,###.##") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoTienNhap).ToString("###,###") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoLuongXuat).ToString("###,###.##") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoTienXuat).ToString("###,###") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoLuongTon).ToString("###,###.##") </th>
						<th style="font-weight:bold; text-align: right">@group.List?.Sum(x=> x.SoTienTon).ToString("###,###") </th>
					</tr>					
							 
			   </tbody>
			  </table>
			  <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
				 <tr>
					 <td width="33%">  </td>
					 <td width="33%">  </td>
					 <td width="33%"> @Model.ThongTin.NgayThangLB </td>
				 </tr>
				  <tr>
					 <td> <b> @Model.ThongTin.ChucDanhThuTruong</b> </td>
					 <td> <b>@Model.ThongTin.ChucDanhKeToan</b> </td>
					 <td> <b>@Model.ThongTin.ChucDanhLapBieu </b></td>
				 </tr>
			 </table>
			 <p style="page-break-before: always;"></p>
		}
		}else{
			 Html.RenderPartial("Header", @Model.ThongTin);
			<div class="row" style="margin-top:10px !important">
		   <div class="col-md-12" style="text-align:center"> <h1>SỔ TỔNG HỢP HÀNG HÓA </h1> </div>
		  </div>
		  <div class="row" style="margin-top:5px !important">
		   <div class="col-md-12" style="text-align:center"> <i> </i></div>
		  </div>

		  <table class="table table-bordered">
		   <thead>
			<tr>
					 <th class="text-center w-150" rowspan="2">Mã Hàng hóa</th>
					 <th class="text-center w25" rowspan="2">Tên hàng hóa</th>
					 <th class="text-center " rowspan="2">DVT</th>
					 <th class="text-center " colspan="2" >NHẬP</th>
					 <th class="text-center " colspan="2">XUẤT</th>
					 <th class="text-center" colspan="2"> TỒN</th>
				</tr>
				<tr>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
					 <th class="text-center">Số lượng</th>
					 <th class="text-center">Số tiền</th>
				</tr>
			   
		   </thead>
			<tbody>
				<tr><td colspan="9" style="font-weight:bold; text-align: center"> Không có dữ liệu </td> </tr>
			</tbody>
		  </table>
		  <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
			 <tr>
				 <td width="33%">  </td>
				 <td width="33%">  </td>
				 <td width="33%"> @Model.ThongTin.NgayThangLB </td>
			 </tr>
			  <tr>
				 <td> <b> @Model.ThongTin.ChucDanhThuTruong</b> </td>
				 <td> <b>@Model.ThongTin.ChucDanhKeToan</b> </td>
				 <td> <b>@Model.ThongTin.ChucDanhLapBieu </b></td>
			 </tr>
		 </table>
		}
	
	
	  
</body>
</html>
