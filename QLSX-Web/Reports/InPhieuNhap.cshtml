@using QLSX.Shared.Data.Responses
@using QLSX.Shared.Data.Responses.NhapXuat

@model ReportResponseBase<InPhieuNhapXuatResponse>

<!DOCTYPE html>
<html>
<head>
	<link rel="stylesheet" href="@(Model.Host)/lib/bootstrap/dist/css/bootstrap.css" />
	<link rel="stylesheet" href="@(Model.Host)/lib/bootstrap/dist/css/bootstrap-grid.css" />
	<link rel="stylesheet" href="@(Model.Host)/lib/bootstrap/dist/css/bootstrap-reboot.css" />
	<link rel="stylesheet" href="@(Model.Host)/lib/bootstrap/dist/css/bootstrap-theme.css" />

	<link rel="stylesheet" href="@(Model.Host)/css/report.css" />

	<title>Phiếu nhập - @Model.ListData?.First()?.SoCT</title>
</head>
<body>
	<div class="row" style="margin-top:10px !important">
		<div class="col-md-12" style="text-align:center"> <h1>Phiếu Nhập </h1> </div>
		<div style="float:right" class="font-weight-bold"> Số: @Model.ListData?.First()?.SoCT </div>
	</div>
	<div class="row" style="margin-top:5px !important">
		<div class="col-md-12" style="text-align:center"> Ngày: @Model.ListData?.First()?.NgayCT.ToString("dd/MM/yyyy") </div>
	</div>
	<table>
		@if (Model.ListData != null)
		{
			<tr> 
				<td style="font-weight:bold; width:100px">Tên đơn vị</td> 
				<td> @Model.ListData?.First().TenDonVi</td> 
			</tr> 
			<tr> 
				<td style="font-weight:bold">Địa chỉ</td> 
				<td>@Model.ListData?.First().DiaChi</td> 
			</tr> 
			<tr> 
				<td style="font-weight:bold">Ghi chú</td> 
				<td>@Model.ListData?.First().DienGiai</td> 
			</tr>
		}
		
	</table>
	<table class="table table-bordered">
		<thead>
			<tr>
				<th>Mã hàng hóa</th>
				<th> Tên hàng hóa </th>
				<th> Đơn vị tính</th>
				<th> Số lượng </th>
				<th> Chiều dài</th>
				<th> Tổng chiều dài</th>
				<th> Chiều rộng</th>
				<th> Tổng chiều rộng</th>
				<th> Đơn giá</th>
				<th> Số tiền</th>
			</tr>
		</thead>
		<tbody>
			@if(Model.ListData == null)
			{
				<tr><td colspan="10"> Không có dữ liệu </td> </tr>
			}
			 
			@foreach (var item in Model.ListData)
			{
			   <tr>
				<th style="font-weight:normal">@item.MaDonVi </th>
				<th style="font-weight:normal;width:20% ">@item.TenHangHoa </th>
				<th style="font-weight:normal; text-align: center">@item.DonViTinh </th>
				<th style="font-weight:normal; text-align: right">@item.Soluong.ToString("###,###.##") </th>
				<th style="font-weight:normal; text-align: right">@item.ChieuDai.ToString("###,###.##")</th>
				<th style="font-weight:normal; text-align: right">@item.TongChieuDai.ToString("###,###.##")</th>
				<th style="font-weight:normal; text-align: right">@item.KhoRongTon.ToString("###,###.##") </th>
				<th style="font-weight:normal; text-align: right">@item.TongDienTich.ToString("###,###.##")</th>
				<th style="font-weight:normal; text-align: right">@item.DonGia.ToString("###,###")</th>
				<th style="font-weight:normal; text-align: right">@item.SoTien.ToString("###,###")</th>
			   </tr>
			}
		</tbody>
		<tfoot>
			<tr>
				<th colspan="3" style="text-align: right"> Tổng cộng </th>
				<th style="text-align: right"> @Model.ListData.Sum(x => x.Soluong).ToString("###,###.##") </th>
				<th> </th>
				<th style="text-align: right"> @Model.ListData.Sum(x => x.TongChieuDai).ToString("###,###.##")</th>
				<th> </th>
				<th style="text-align: right"> @Model.ListData.Sum(x => x.TongDienTich).ToString("###,###.##")</th>
				<th> </th>
				<th style="text-align: right"> @Model.ListData.Sum(x => x.SoTien).ToString("###,###")</th>
			</tr>
		</tfoot>
	</table>
	<table width="100%">
		<tr>
			<td style="width:20%"></td> 
			<td style="width:20%"></td> 
			<td style="width:15%"></td> 
			<td style="text-align: center; width:25%"><h4><i>@Model.ThongTin.NgayThangLB  </i></h4></td> 
		</tr>
		<tr>
			<td style="text-align: center"> <h4><b>Người giao hàng </b></h4> </td> 
			<td></td> 
			<td></td> 
			<td style="text-align: center"><h4><b>Người nhận hàng</b></h4></td> 
		</tr>
	</table>	

</body>
</html>
