@using QLSX.Shared.Data.Responses
@using QLSX.Shared.Data.Responses.BaoCao

@model ReportResponseBase<BangKeDenHanThanhToanResponse>

<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-grid.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-reboot.css"
    />
    <link
      rel="stylesheet"
      href="@Model.Host/lib/bootstrap/dist/css/bootstrap-theme.css"
    />
    <link
      rel="stylesheet"
      href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/css/bootstrap.min.css"
    />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="@Model.Host/css/report.css" />
    <title>Bảng kê đến hạn thanh toán</title>
  </head>
  <body>
    Html.RenderPartial("Header", @Model.ThongTin);
    <div class="row" style="margin-top: 10px !important">
      <div class="col-md-12" style="text-align: center">
        <h1 style="color: blue">BẢNG KÊ BÁN HÀNG ĐẾN HẠN THANH TOÁN</h1>
      </div>
    </div>
    <div class="row" style="margin-top: 10px !important">
      <div class="col-md-12" style="text-align: center">
        <span><i>Từ ngày   Đến ngày:  </i></span>
      </div>
    </div>
    <div>
      @if (Model.ListData.Count > 0)
      {
        @foreach(var group in Model.ListData.GroupBy(x=>x.TenKhachHang , (key, grp) => new { Name= key,List= grp})) {
        <table class="table table-bordered">
          <thead>
            <tr>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Hạn TT</th>
              <th style="vertical-align: middle !important" rowspan="1" colspan="2" class="text-center">Chứng từ</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center w35">Tên khách hàng</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Địa chỉ</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Thành tiền</th>
            </tr>
            <tr>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Ngày tháng</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số hiệu</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in group.List)
            {
            <tr>
              <th>@item.HanThanhToan</th>
              <th>@item.NgayThang</th>
              <th>@item.SoHieu</th>
              <th>@item.TenKhachHang</th>
              <th>@item.DiaChi</th>
              <th style="font-weight: normal; text-align: right">@item.ThanhTien.ToString("###,###.##")</th>
            </tr>
            }
            <tr>
              <th></th>
              <th style="font-weight: bold; text-align: right" colspan="3">
                Tổng cộng:
              </th>
              <th></th> 
              <th style="font-weight: bold; text-align: right">@Model.ListData?.Sum(x=> x.ThanhTien).ToString("###,###.##") </th>
            </tr>
          </tbody>
        </table>
        }
      } else {
        <table class="table table-bordered">
          <thead>
            <tr>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Hạn TT</th>
              <th style="vertical-align: middle !important" rowspan="1" colspan="2" class="text-center">Chứng từ</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center w35">Tên khách hàng</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Địa chỉ</th>
              <th style="vertical-align: middle !important" rowspan="2" class="text-center">Thành tiền</th>
            </tr>
            <tr>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Ngày tháng</th>
              <th style="vertical-align: middle !important" rowspan="1" class="text-center">Số hiệu</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th style="font-weight: bold; text-align: center" colspan="6">
                Không có dữ liệu
              </th>
            </tr>
          </tbody>
        </table>
      }
      <table border="0" cellspacing="0" cellpadding="0" style="width: 100%; font-family:Tahoma">
         <tr>
          <td colspan="3" class="text-right"><b>@Model.ThongTin.ChucDanhLapBieu </b></td>
        </tr>
      </table>
    </div>
  </body>
</html>

