@code {
    [CascadingParameter] private Task<AuthenticationState> authenticationStateTask { get; set; }
    
    private bool collapseNavMenu = true;
    private bool isReLoad = false;
    private bool isHangHoaTheoM2 = false;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
  
    private async Task ClickNewThu()
    {
        int id = await thuchitService.GetIdLastest("thutm");
        navigationManager.NavigateTo($"thuchis/thu/edit/{id}?rid=" + Guid.NewGuid(), isReLoad);
    }
    private async Task ClickNewChi()
    {
        int id = await thuchitService.GetIdLastest("chitm");
        navigationManager.NavigateTo($"thuchis/chi/edit/{id}?rid=" + Guid.NewGuid(), isReLoad);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var user = (await authenticationStateTask).User;
                var UserId = user.FindFirst(c => c.Type == "UserId")?.Value;
                UserId = string.IsNullOrEmpty(UserId) ? "0" : UserId;
                
                var itemSetting = await itemService.GetByIdAsync(int.Parse(UserId));
                
                // Kiểm tra nếu LoaiNhapXuat == 2 hoặc == 3 thì hàng hóa theo m2
                if (itemSetting != null && (itemSetting.LoaiNhapXuat == 2 || itemSetting.LoaiNhapXuat == 3))
                {
                    isHangHoaTheoM2 = true;
                }
                else
                {
                    isHangHoaTheoM2 = false;
                }
                
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading setting in NavMenu: {ex.Message}");
                // Mặc định không ẩn menu nếu có lỗi
                isHangHoaTheoM2 = false;
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}