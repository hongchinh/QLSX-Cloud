                    <ValidationMessage For="(() => _item1.ContentsNext)" />
                </div>
            </div>

        </div>
    </div>
</div>}
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="Close1">Cancel</button>

                    <button @onclick="SaveClick1" class="btn btn-primary">
                        Save
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>



@if (_showEditModal1)
{
<div class="modal-backdrop fade show"></div>}

@code { [Parameter]
    public EventCallback<string> OnSaveClick1 { get; set; }

    private string _badFileMessage1 = string.Empty;
    private string _modalDisplay1 = "none;";
    private string _modalClass1 = "";
    private bool _showEditModal1 = false;
    private CustomerCare _item1 = new CustomerCare();
    private int _id1 = 0;
     
    private async Task SaveClick1()
    {
        await customerCareItemService.UpdateAsync(_item1.Id, _item1);
        await OnSaveClick1.InvokeAsync(null);
        await Close1();

    }

    public async Task Open1(int id)
    {
        // Logger.LogInformation("Now loading... /Catalog/Edit/{Id}", id);

        await new Css(JSRuntime).HideBodyOverflow();
        _id1 = id;
        _item1 = await customerCareItemService.GetByIdAsync(id);

        _modalDisplay1 = "block;";
        _modalClass1 = "Show";
        _showEditModal1 = true;

        StateHasChanged();
    }

    private async Task Close1()
    {
        await new Css(JSRuntime).HideEditCustomers();
        _modalDisplay1 = "none";
        _modalClass1 = "";
        _showEditModal1 = false;
    }
    private void OnSelectStatusChange1(ChangeEventArgs changeEventArgs)
    {
        // SelectedStatus = (int)changeEventArgs.Value;
    }

    protected override void OnParametersSet()
    {
        Console.WriteLine("Care - OnParametersSet");
        base.OnParametersSet();
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine("Care - OnParametersSetAsync");
        await base.OnParametersSetAsync();
    }

    protected override bool ShouldRender()
    {
        base.ShouldRender();
        Console.WriteLine("Care - ShouldRender");

        return true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        Console.WriteLine("Care - OnAfterRender - firstRender = " + firstRender);
        base.OnAfterRender(firstRender);
    }


