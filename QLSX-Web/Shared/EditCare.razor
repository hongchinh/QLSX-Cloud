                    <SelectProduct OnChangeEvent="OnSelectStatusChange1" IdSelected="@_item1.ProductId"></SelectProduct>
                    <ValidationMessage For="(() => _item1.ProductId )" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-12">Nội dung</label>
                <div class="col-md-12">
                    <InputText class="form-control" @bind-Value="_item1.Contents" />
                    <ValidationMessage For="(() => _item1.Contents)" />
                </div>
            </div>

            <div class="form-group">
                <label class="control-label col-12">Ngày CS tiếp theo</label>
                <div class="col-md-12">
                    <InputDate class="form-control" @bind-Value="_item1.DateNext" />
                    <ValidationMessage For="(() => _item1.DateNext)" />
