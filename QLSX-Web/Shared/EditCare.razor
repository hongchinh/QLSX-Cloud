        <div class="modal-content">
            <EditForm Model="_item1" OnValidSubmit="@SaveClick1">
                <DataAnnotationsValidator />
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Edit</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" @onclick="Close1">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">

                    @if (_item1 == null)
                    {
    <SpinnerData></SpinnerData> }
else
{
<div class="container">
    <div class="row">

        <div class="col-12">

            <div class="form-group">
                <label class="control-label col-6">Ngày chăm sóc</label>
                <div class="col-md-12">
                    <InputDate class="form-control" @bind-Value="_item1.DateCreated" />
